{
	"name": "FeedTheGiantCapy",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Assets": {
				"$className": "Folder",
				"$ignoreUnknownInstances": true
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CharacterWalkSpeed": 16,
				"CharacterJumpPower": 50,
				"CameraMaxZoomDistance": 80
			},
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": false,
				"RespawnTime": 3
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false,
				"FallenPartsDestroyHeight": -150
			}
		},
		"Lighting": {
			"$properties": {
				"ClockTime": 14.5,
				"Brightness": 2.5,
				"GlobalShadows": true,
				"Technology": "ShadowMap",
				"OutdoorAmbient": [0.55, 0.5, 0.6]
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
