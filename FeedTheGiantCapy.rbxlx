		},
	},
} :: { Zone }

ZoneConfig.ById = {} :: { [string]: Zone }
for _, zone in ZoneConfig.List do
	ZoneConfig.ById[zone.Id] = zone
end

ZoneConfig.StarterZone = ZoneConfig.List[1].Id

return ZoneConfig
]]></string>
