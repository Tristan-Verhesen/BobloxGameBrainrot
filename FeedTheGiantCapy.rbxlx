	Stroke = Color3.fromRGB(16, 10, 32),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(205, 200, 235),
	Accent = Color3.fromRGB(255, 196, 50),
	Good = Color3.fromRGB(85, 220, 110),
	Bad = Color3.fromRGB(255, 85, 95),
	Info = Color3.fromRGB(100, 170, 255),
	Pink = Color3.fromRGB(255, 100, 180),
	Disabled = Color3.fromRGB(110, 105, 130),
}
]]></string>
