      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--!strict
-- Pure game math shared by server (authoritative) and client (UI previews).
-- `data` is a player's saved profile (see server/Services/DataService).

local Config = script.Parent.Config
local PetConfig = require(Config.PetConfig)
local RebirthConfig = require(Config.RebirthConfig)
local RewardConfig = require(Config.RewardConfig)
local UpgradeConfig = require(Config.UpgradeConfig)
local ZoneConfig = require(Config.ZoneConfig)

local Formulas = {}

function Formulas.UpgradeLevel(data: any, upgradeId: string): number
	return (data.Upgrades and data.Upgrades[upgradeId]) or 0
end

function Formulas.UpgradeStat(upgradeId: string, level: number): number
	local upgrade = UpgradeConfig.ById[upgradeId]
	return upgrade.Base + upgrade.PerLevel * level
end

-- Cost to go from `level` to `level + 1`.
function Formulas.UpgradeCost(upgradeId: string, level: number): number
	local upgrade = UpgradeConfig.ById[upgradeId]
	return math.floor(upgrade.BaseCost * upgrade.CostGrowth ^ level)
end

function Formulas.Stat(data: any, upgradeId: string): number
	return Formulas.UpgradeStat(upgradeId, Formulas.UpgradeLevel(data, upgradeId))
end

function Formulas.CarryCapacity(data: any): number
	return math.floor(Formulas.Stat(data, "Capacity"))
end

function Formulas.WalkSpeed(data: any): number
	return Formulas.Stat(data, "Speed")
end

function Formulas.PickupRange(data: any): number
	return Formulas.Stat(data, "Magnet")
end

function Formulas.ClickPower(data: any): number
	return math.floor(Formulas.Stat(data, "ClickPower"))
end

function Formulas.ValueMultiplier(data: any): number
	return Formulas.Stat(data, "Value")
end

function Formulas.RebirthMultiplier(rebirths: number): number
	return 1 + rebirths * RebirthConfig.MultiplierPerRebirth
end

function Formulas.RebirthCost(rebirths: number): number
	return math.floor(RebirthConfig.BaseCost * RebirthConfig.CostGrowth ^ rebirths)
end

function Formulas.PetMultiplier(data: any): number
	local total = 1
	for _, uid in data.EquippedPets or {} do
		local petId = data.Pets[uid]
		local pet = petId and PetConfig.Pets[petId]
		if pet then
			total += pet.Multiplier - 1
		end
	end
	return total
end

function Formulas.IsBoostActive(data: any, boostName: string, now: number): boolean
	return (data.Boosts and (data.Boosts[boostName] or 0) or 0) > now
end

-- The player's personal cash multiplier. Server events (Double Cash etc.)
-- are applied on top of this by the server.
function Formulas.CashMultiplier(data: any, now: number): number
	local multiplier = Formulas.ValueMultiplier(data)
		* Formulas.RebirthMultiplier(data.Rebirths or 0)
		* Formulas.PetMultiplier(data)
	if Formulas.IsBoostActive(data, "Cash", now) then
		multiplier *= RewardConfig.CashBoostMultiplier
	end
	return multiplier
end

function Formulas.HighestZone(data: any): ZoneConfig.Zone
	local best = ZoneConfig.List[1]
	for _, zone in ZoneConfig.List do
		if data.Zones and data.Zones[zone.Id] and zone.Order > best.Order then
			best = zone
		end
	end
	return best
end

function Formulas.RewardCash(data: any, amount: number): number
	local scale = Formulas.HighestZone(data).RewardScale * Formulas.RebirthMultiplier(data.Rebirths or 0)
	return math.floor(amount * scale)
end

-- UTC day number, used for the daily streak.
function Formulas.DayNumber(unixTime: number): number
	return unixTime // 86400
end

-- Returns whether today's daily reward can be claimed, the streak the player
-- would have after claiming, and which reward (1-7) that is.
function Formulas.DailyStatus(data: any, unixTime: number): (boolean, number, number)
	local today = Formulas.DayNumber(unixTime)
	local daily = data.Daily or { LastClaimDay = 0, Streak = 0 }
	local canClaim = daily.LastClaimDay < today
	local streak
	if not canClaim then
		streak = daily.Streak
	elseif daily.LastClaimDay == today - 1 then
		streak = daily.Streak + 1
	else
		streak = 1
	end
	local rewardIndex = ((math.max(streak, 1) - 1) % #RewardConfig.Daily) + 1
	return canClaim, streak, rewardIndex
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Map geometry shared by the server (building, AI, validation) and the client
-- (gates, zone labels). The hub is a square centered on the origin; each zone
-- is a rectangle attached to one side of the hub.

local ZoneConfig = require(script.Parent.Config.ZoneConfig)

export type Bounds = {
	Min: Vector3,
	Max: Vector3,
	Center: Vector3,
	Size: Vector3,
	Direction: Vector3,
}

local MapLayout = {
	HubHalf = 80, -- hub is 160 x 160
	ZoneDepth = 180, -- how far a zone extends away from the hub
	ZoneHalfWidth = 80,
	GateWidth = 30,
	WallHeight = 28,
	FloorY = 0,
	CapyPosition = Vector3.new(0, 0, 0),
	SpawnPosition = Vector3.new(-52, 0, 52),
	EggArea = Vector3.new(52, 0, 52),
	ShopArea = Vector3.new(52, 0, -52),
	LeaderboardArea = Vector3.new(-52, 0, -52),
}

local boundsCache: { [string]: Bounds } = {}

function MapLayout.GetZoneBounds(zoneId: string): Bounds
	local cached = boundsCache[zoneId]
	if cached then
		return cached
	end
	local zone = ZoneConfig.ById[zoneId]
	assert(zone, "Unknown zone " .. tostring(zoneId))
	local direction = zone.Direction.Unit
	local center = direction * (MapLayout.HubHalf + MapLayout.ZoneDepth / 2)
	local size
	if math.abs(direction.X) > 0.5 then
		size = Vector3.new(MapLayout.ZoneDepth, 0, MapLayout.ZoneHalfWidth * 2)
	else
		size = Vector3.new(MapLayout.ZoneHalfWidth * 2, 0, MapLayout.ZoneDepth)
	end
	local bounds = {
		Min = Vector3.new(center.X - size.X / 2, MapLayout.FloorY, center.Z - size.Z / 2),
		Max = Vector3.new(center.X + size.X / 2, MapLayout.FloorY, center.Z + size.Z / 2),
		Center = Vector3.new(center.X, MapLayout.FloorY, center.Z),
		Size = size,
		Direction = direction,
	}
	boundsCache[zoneId] = bounds
	return bounds
end

function MapLayout.IsInHub(position: Vector3): boolean
	return math.abs(position.X) <= MapLayout.HubHalf and math.abs(position.Z) <= MapLayout.HubHalf
end

-- Returns the zone id at a position, or nil for the hub / outside the map.
function MapLayout.ZoneAt(position: Vector3): string?
	for _, zone in ZoneConfig.List do
		local bounds = MapLayout.GetZoneBounds(zone.Id)
		if
			position.X >= bounds.Min.X
			and position.X <= bounds.Max.X
			and position.Z >= bounds.Min.Z
			and position.Z <= bounds.Max.Z
		then
			return zone.Id
		end
	end
	return nil
end

function MapLayout.ClampToZone(zoneId: string, position: Vector3, margin: number): Vector3
	local bounds = MapLayout.GetZoneBounds(zoneId)
	return Vector3.new(
		math.clamp(position.X, bounds.Min.X + margin, bounds.Max.X - margin),
		position.Y,
		math.clamp(position.Z, bounds.Min.Z + margin, bounds.Max.Z - margin)
	)
end

function MapLayout.RandomPointInZone(zoneId: string, rng: Random, margin: number): Vector3
	local bounds = MapLayout.GetZoneBounds(zoneId)
	return Vector3.new(
		rng:NextNumber(bounds.Min.X + margin, bounds.Max.X - margin),
		MapLayout.FloorY,
		rng:NextNumber(bounds.Min.Z + margin, bounds.Max.Z - margin)
	)
end

-- How far past the hub edge a position is, measured into the zone.
function MapLayout.DepthInZone(zoneId: string, position: Vector3): number
	local direction = MapLayout.GetZoneBounds(zoneId).Direction
	return Vector3.new(position.X, 0, position.Z):Dot(direction) - MapLayout.HubHalf
end

-- Point on the hub edge where a zone's gate sits.
function MapLayout.GatePosition(zoneId: string): Vector3
	local zone = ZoneConfig.ById[zoneId]
	return zone.Direction.Unit * MapLayout.HubHalf
end

-- Converts a local offset (Forward = away from the hub, Right = sideways) into
-- a world position inside a zone. Used to place machines and duck spawns.
function MapLayout.ZoneLocalToWorld(zoneId: string, forward: number, right: number): Vector3
	local bounds = MapLayout.GetZoneBounds(zoneId)
	local direction = bounds.Direction
	local rightVector = Vector3.new(-direction.Z, 0, direction.X)
	local start = direction * MapLayout.HubHalf
	return Vector3.new(start.X, MapLayout.FloorY, start.Z) + direction * forward + rightVector * right
end

return MapLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Every remote in the game is declared here. The server creates them on start;
-- clients wait for them. Server-side handlers go through Net.Handle, which adds
-- per-player rate limiting and error isolation.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Server -> client
local EVENTS = {
	"DataChanged", -- (key, value) a top-level save key changed
	"Notify", -- (text, kind) toast message
	"Effect", -- (effectName, payload) one-shot juice: popups, shakes, sounds
	"Ragdoll", -- (enabled, flingVelocity)
	"HatchResult", -- (eggId, petId, uid)
	"Announce", -- (text, color) big server-wide banner
}

-- Client -> server (all return ok: boolean, message: string?)
local FUNCTIONS = {
	"GetData",
	"BuyUpgrade",
	"UnlockZone",
	"Rebirth",
	"HatchEgg",
	"EquipPet",
	"UnequipPet",
	"EquipBest",
	"DeletePet",
	"EquipTitle",
	"ClaimDaily",
	"ClaimPlaytime",
}

local Net = {}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.Event(name: string): RemoteEvent
	local remote = folder:WaitForChild(name, 10)
	assert(remote and remote:IsA("RemoteEvent"), "Unknown RemoteEvent " .. name)
	return remote
end

function Net.Function(name: string): RemoteFunction
	local remote = folder:WaitForChild(name, 10)
	assert(remote and remote:IsA("RemoteFunction"), "Unknown RemoteFunction " .. name)
	return remote
end

-- Server: fire an event to one player.
function Net.Fire(player: Player, name: string, ...: any)
	Net.Event(name):FireClient(player, ...)
end

-- Server: fire an event to everyone.
function Net.FireAll(name: string, ...: any)
	Net.Event(name):FireAllClients(...)
end

-- Server: register a handler for a RemoteFunction. The handler returns
-- (ok, message?, ...extra). Calls over `perSecond` are rejected.
local buckets: { [Player]: { [string]: { tokens: number, last: number } } } = {}

function Net.Handle(name: string, handler: (Player, ...any) -> ...any, perSecond: number?)
	assert(RunService:IsServer(), "Net.Handle is server-only")
	local rate = perSecond or 6
	Net.Function(name).OnServerInvoke = function(player: Player, ...)
		local playerBuckets = buckets[player]
		if not playerBuckets then
			playerBuckets = {}
			buckets[player] = playerBuckets
		end
		local now = os.clock()
		local bucket = playerBuckets[name]
		if not bucket then
			bucket = { tokens = rate, last = now }
			playerBuckets[name] = bucket
		end
		bucket.tokens = math.min(rate, bucket.tokens + (now - bucket.last) * rate)
		bucket.last = now
		if bucket.tokens < 1 then
			return false, "Slow down!"
		end
		bucket.tokens -= 1

		local results = table.pack(pcall(handler, player, ...))
		if not results[1] then
			warn(string.format("[Net] %s handler error for %s: %s", name, player.Name, tostring(results[2])))
			return false, "Something went wrong"
		end
		return table.unpack(results, 2, results.n)
	end
end

-- Client: invoke a RemoteFunction safely. Always returns (ok, message, ...).
function Net.Invoke(name: string, ...: any): (boolean, string?, ...any)
	local results = table.pack(pcall(Net.Function(name).InvokeServer, Net.Function(name), ...))
	if not results[1] then
		return false, "Connection problem, try again"
	end
	return table.unpack(results, 2, results.n)
end

if RunService:IsServer() then
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number and time formatting for UI ("1.25M", "3:07").

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 999 -> "999", 1234 -> "1.23K", 15600000 -> "15.6M"
function Format.Abbreviate(value: number): string
	if value ~= value then
		return "0"
	end
	local negative = value < 0
	value = math.abs(value)
	if value < 1000 then
		local text = if value == math.floor(value) then tostring(value) else string.format("%.1f", value)
		return (if negative then "-" else "") .. text
	end
	local tier = math.min(math.floor(math.log10(value) / 3), #SUFFIXES - 1)
	local scaled = value / (1000 ^ tier)
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	else
		if scaled >= 10 then
			text = string.format("%.1f", math.floor(scaled * 10) / 10)
		else
			text = string.format("%.2f", math.floor(scaled * 100) / 100)
		end
		-- Trim trailing zeros: "1.50K" -> "1.5K", "2.00M" -> "2M".
		text = string.gsub(text, "%.?0+$", "") :: string
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[tier + 1]
end

function Format.Cash(value: number): string
	return "$" .. Format.Abbreviate(math.floor(value))
end

-- 125 -> "2:05", 3725 -> "1:02:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

-- 1.5 -> "x1.5", 2 -> "x2"
function Format.Multiplier(value: number): string
	local rounded = math.floor(value * 100 + 0.5) / 100
	if rounded >= 1000 then
		return "x" .. Format.Abbreviate(rounded)
	end
	local text = string.format("%.2f", rounded)
	text = string.gsub(text, "%.?0+$", "") :: string
	return "x" .. text
end

-- 0.0123 -> "1.23%", 0.5 -> "50%"
function Format.Percent(fraction: number): string
	local percent = fraction * 100
	if percent <= 0 then
		return "0%"
	elseif percent >= 10 then
		return string.format("%d%%", math.floor(percent + 0.5))
	elseif percent >= 1 then
		return (string.gsub(string.format("%.1f", percent), "%.0$", "")) .. "%"
	end
	return (string.gsub(string.format("%.2f", percent), "%.?0+$", "")) .. "%"
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Make</string>
            <string name="Source"><![CDATA[-- Small helpers for building instances in code (the whole greybox map and all
-- UI are built at runtime, so this gets used a lot).

local Make = {}

-- Make.Instance("Part", { Size = ..., Parent = ... }, { child1, child2 })
-- Parent is always assigned last so property changes don't replicate one by one.
function Make.Instance(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- Anchored smooth part with sensible defaults. Pass `className` for
-- "WedgePart", "SpawnLocation", etc.
function Make.Part(props: { [string]: any }, children: { Instance }?, className: string?): any
	local merged = {
		Anchored = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		Material = Enum.Material.SmoothPlastic,
	}
	for key, value in props do
		merged[key] = value
	end
	return Make.Instance(className or "Part", merged, children)
end

-- Part with an ellipsoid mesh (non-uniform spheres for bodies, eggs, beaks).
function Make.Ellipsoid(props: { [string]: any }): Part
	local part = Make.Part(props)
	Make.Instance("SpecialMesh", { MeshType = Enum.MeshType.Sphere, Parent = part })
	return part
end

-- A SurfaceGui with one big text label on a face of a part.
function Make.SurfaceText(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	props: { [string]: any }?
): (SurfaceGui, TextLabel)
	local gui = Make.Instance("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 20,
		LightInfluence = 0,
		Parent = part,
	})
	local labelProps = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		RichText = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		Parent = gui,
	}
	if props then
		for key, value in props do
			labelProps[key] = value
		end
	end
	local label = Make.Instance("TextLabel", labelProps)
	return gui, label
end

-- A BillboardGui with one text label floating above a part.
function Make.Billboard(
	adornee: Instance,
	sizeStuds: Vector2,
	offset: Vector3,
	text: string,
	props: { [string]: any }?
): (BillboardGui, TextLabel)
	local gui = Make.Instance("BillboardGui", {
		Size = UDim2.fromScale(sizeStuds.X, sizeStuds.Y),
		StudsOffset = offset,
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 120,
		Parent = adornee,
	})
	local labelProps = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		RichText = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		Parent = gui,
	}
	if props then
		for key, value in props do
			labelProps[key] = value
		end
	end
	local label = Make.Instance("TextLabel", labelProps)
	return gui, label
end

-- Welds every BasePart in `model` to `root` (WeldConstraint), unanchors them
-- and makes them massless so the root alone drives the physics.
function Make.WeldAll(model: Instance, root: BasePart)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			Make.Instance("WeldConstraint", { Part0 = root, Part1 = part, Parent = part })
			part.Anchored = false
			part.Massless = true
		end
	end
end

function Make.ColorToHex(color: Color3): string
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- "<font color=...>text</font>" for RichText labels.
function Make.Colored(text: string, color: Color3): string
	return string.format('<font color="%s">%s</font>', Make.ColorToHex(color), text)
end

return Make
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny synchronous signal. Handlers run in their own thread so one erroring
-- handler can't break the others.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new()
	local self = setmetatable({}, Signal)
	self._handlers = {} :: { [any]: (...any) -> () }
	return self
end

function Signal:Connect(handler: (...any) -> ()): Connection
	local key = {}
	self._handlers[key] = handler
	local handlers = self._handlers
	local connection = {
		Connected = true,
	}
	function connection.Disconnect(conn)
		conn.Connected = false
		handlers[key] = nil
	end
	return connection :: any
end

function Signal:Once(handler: (...any) -> ()): Connection
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...: any)
	for _, handler in self._handlers do
		task.spawn(handler, ...)
	end
end

function Signal:Wait(): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">WeightedRandom</string>
            <string name="Source"><![CDATA[--!strict
-- Weighted picks for food spawns, egg hatches, title rolls and events.

export type Entry = { Weight: number, [any]: any }

local WeightedRandom = {}

local function defaultWeight(entry: any): number
	return entry.Weight
end

-- Picks one entry. `weightOf` lets callers change weights (e.g. luck boosts)
-- without copying the table.
function WeightedRandom.Pick<T>(entries: { T }, rng: Random?, weightOf: ((T) -> number)?): T
	local getWeight: (T) -> number = if weightOf then weightOf else defaultWeight
	local total = 0
	for _, entry in entries do
		total += math.max(0, getWeight(entry))
	end
	assert(total > 0, "WeightedRandom.Pick needs at least one positive weight")

	local roll = (if rng then rng:NextNumber() else math.random()) * total
	for _, entry in entries do
		roll -= math.max(0, getWeight(entry))
		if roll <= 0 then
			return entry
		end
	end
	return entries[#entries]
end

-- Chance (0-1) of each entry, in the same order. Used for odds displays.
function WeightedRandom.Chances<T>(entries: { T }, weightOf: ((T) -> number)?): { number }
	local getWeight: (T) -> number = if weightOf then weightOf else defaultWeight
	local total = 0
	for _, entry in entries do
		total += math.max(0, getWeight(entry))
	end
	local chances = {}
	for index, entry in entries do
		chances[index] = if total > 0 then math.max(0, getWeight(entry)) / total else 0
	end
	return chances
end

return WeightedRandom
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
