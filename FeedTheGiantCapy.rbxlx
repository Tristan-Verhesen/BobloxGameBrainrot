            <string name="Name">EventConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Random server-wide events. One random event runs at a time; the Capy Feast
-- is separate and starts whenever the server fills the Capybara's meter.

export type GameEvent = {
	Id: string,
	Name: string,
	Emoji: string,
	Description: string,
	Duration: number,
	Weight: number, -- chance of being picked by the random event timer (0 = never)
	Color: Color3,
	CashMultiplier: number?,
	DuckSpeedMultiplier: number?,
	DuckSightMultiplier: number?,
	Gravity: number?,
	GoldenFoodPerZone: number?,
}

local EventConfig = {
	FirstEventDelay = 90, -- seconds after the server starts
	IntervalMin = 150, -- seconds between the end of one event and the start of the next
	IntervalMax = 240,
}

EventConfig.Events = {
	GoldenRain = {
		Id = "GoldenRain",
		Name = "GOLDEN SNACK RAIN",
		Emoji = "✨",
		Description = "Golden snacks worth 5x are falling from the sky!",
		Duration = 30,
		Weight = 30,
		Color = Color3.fromRGB(255, 205, 40),
		GoldenFoodPerZone = 8,
	},
	DuckFrenzy = {
		Id = "DuckFrenzy",
		Name = "DUCK FRENZY",
		Emoji = "🦆",
		Description = "The ducks are FAST and ANGRY... but every snack pays 2x!",
		Duration = 40,
		Weight = 25,
		Color = Color3.fromRGB(255, 70, 70),
		CashMultiplier = 2,
		DuckSpeedMultiplier = 1.3,
		DuckSightMultiplier = 1.4,
	},
	DoubleCash = {
		Id = "DoubleCash",
		Name = "DOUBLE CASH",
		Emoji = "💸",
		Description = "Every delivery pays 2x!",
		Duration = 60,
		Weight = 25,
		Color = Color3.fromRGB(80, 230, 110),
		CashMultiplier = 2,
	},
	MoonMode = {
		Id = "MoonMode",
		Name = "MOON GRAVITY",
		Emoji = "🌙",
		Description = "Gravity is broken. Getting bonked sends you FLYING.",
		Duration = 40,
		Weight = 20,
		Color = Color3.fromRGB(150, 160, 255),
		Gravity = 55,
	},
	CapyFeast = {
		Id = "CapyFeast",
		Name = "CAPY FEAST",
		Emoji = "🦫",
		Description = "The Capybara is HAPPY! Everyone gets 2x cash!",
		Duration = 45,
		Weight = 0,
		Color = Color3.fromRGB(255, 150, 60),
		CashMultiplier = 2,
	},
} :: { [string]: GameEvent }

return EventConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">FoodConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Every snack in the game. Zones decide where each one spawns (ZoneConfig).
-- Shape: "Ball" | "Block" | "Cylinder". Size is the pickup's size in studs.

export type Food = {
	Id: string,
	Name: string,
	Emoji: string,
	Value: number, -- cash per snack before multipliers
	Rarity: string,
	Color: Color3,
	Shape: string,
	Size: number,
	Golden: boolean?,
}

local FoodConfig: { [string]: Food } = {}

local function add(food: Food)
	assert(FoodConfig[food.Id] == nil, "Duplicate food id " .. food.Id)
	FoodConfig[food.Id] = food
end

-- Zone 1: Rizz Meadow
add({
	Id = "SigmaSandwich",
	Name = "Soggy Sigma Sandwich",
	Emoji = "🥪",
	Value = 1,
	Rarity = "Common",
	Color = Color3.fromRGB(235, 200, 120),
	Shape = "Block",
	Size = 2.2,
})
add({
	Id = "MewingMelon",
	Name = "Mewing Melon",
	Emoji = "🍉",
	Value = 3,
	Rarity = "Uncommon",
	Color = Color3.fromRGB(90, 200, 90),
	Shape = "Ball",
	Size = 2.6,
})
add({
	Id = "OhioOnionRing",
	Name = "Ohio Onion Ring",
	Emoji = "🧅",
	Value = 8,
	Rarity = "Rare",
	Color = Color3.fromRGB(230, 170, 70),
	Shape = "Cylinder",
	Size = 2.4,
})
add({
	Id = "GoldenSandwich",
	Name = "GOLDEN Sigma Sandwich",
	Emoji = "🥪",
	Value = 40,
	Rarity = "Legendary",
	Color = Color3.fromRGB(255, 205, 40),
	Shape = "Block",
	Size = 2.8,
	Golden = true,
})

-- Zone 2: Cringe Canyon
add({
	Id = "AuraApple",
	Name = "Aura Apple",
	Emoji = "🍎",
	Value = 15,
	Rarity = "Common",
	Color = Color3.fromRGB(220, 50, 50),
	Shape = "Ball",
	Size = 2.2,
})
add({
	Id = "NPCNoodles",
	Name = "NPC Noodles",
	Emoji = "🍜",
	Value = 40,
	Rarity = "Uncommon",
	Color = Color3.fromRGB(245, 225, 160),
	Shape = "Cylinder",
	Size = 2.6,
})
add({
	Id = "DeluluDonut",
	Name = "Delulu Donut",
	Emoji = "🍩",
	Value = 100,
	Rarity = "Rare",
	Color = Color3.fromRGB(255, 120, 190),
	Shape = "Cylinder",
	Size = 2.6,
})
add({
	Id = "GoldenDonut",
	Name = "GOLDEN Delulu Donut",
	Emoji = "🍩",
	Value = 500,
	Rarity = "Legendary",
	Color = Color3.fromRGB(255, 205, 40),
	Shape = "Cylinder",
	Size = 3,
	Golden = true,
})

-- Zone 3: Ohio Outskirts
add({
	Id = "BussinBurrito",
	Name = "Bussin Burrito",
	Emoji = "🌯",
	Value = 250,
	Rarity = "Common",
	Color = Color3.fromRGB(210, 160, 90),
	Shape = "Cylinder",
	Size = 2.6,
})
add({
	Id = "GoofyGummy",
	Name = "Goofy Gummy",
	Emoji = "🍬",
	Value = 600,
	Rarity = "Uncommon",
	Color = Color3.fromRGB(120, 220, 255),
	Shape = "Ball",
	Size = 2.2,
})
add({
	Id = "SusSushi",
	Name = "Sus Sushi",
	Emoji = "🍣",
	Value = 1500,
	Rarity = "Rare",
	Color = Color3.fromRGB(255, 130, 90),
	Shape = "Block",
	Size = 2.4,
})
add({
	Id = "GoldenSushi",
	Name = "GOLDEN Sus Sushi",
	Emoji = "🍣",
	Value = 7500,
	Rarity = "Legendary",
	Color = Color3.fromRGB(255, 205, 40),
	Shape = "Block",
	Size = 3,
	Golden = true,
})

-- Zone 4: Brainrot Backrooms
add({
	Id = "ChaosCroissant",
	Name = "Chaos Croissant",
	Emoji = "🥐",
	Value = 4000,
	Rarity = "Common",
	Color = Color3.fromRGB(225, 165, 80),
	Shape = "Ball",
	Size = 2.6,
})
add({
	Id = "VoidTaco",
	Name = "Void Taco",
	Emoji = "🌮",
	Value = 10000,
	Rarity = "Uncommon",
	Color = Color3.fromRGB(60, 30, 90),
	Shape = "Block",
	Size = 2.6,
})
add({
	Id = "MegaMeatball",
	Name = "Mythic Mega Meatball",
	Emoji = "🧆",
	Value = 25000,
	Rarity = "Rare",
	Color = Color3.fromRGB(140, 70, 40),
	Shape = "Ball",
	Size = 3,
})
add({
	Id = "GoldenMeatball",
	Name = "GOLDEN Mega Meatball",
	Emoji = "🧆",
	Value = 125000,
	Rarity = "Legendary",
	Color = Color3.fromRGB(255, 205, 40),
	Shape = "Ball",
	Size = 3.4,
	Golden = true,
})

return FoodConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
-- General tuning. Most balance numbers live here or in the other Config files,
-- so you can rebalance without touching any system code.

local GameConfig = {
	GameTitle = "FEED THE GIANT CAPY",

	-- Movement / carrying base stats (upgrades add on top, see UpgradeConfig)
	BaseWalkSpeed = 16,

	-- Food
	ClickCooldown = 0.12, -- seconds between counted clicks on a snack machine
	MachineClickRange = 24, -- studs
	DroppedFoodLifetime = 25, -- seconds a dropped snack stays on the floor
	MaxDroppedPieces = 12, -- dropped loot is merged into at most this many pickups
	MaxCarryVisual = 10, -- snacks shown stacked on your back

	-- Getting caught
	RagdollDuration = 3,
	PostRagdollImmunity = 4, -- seconds the duck ignores you after getting up
	CatchFlingSpeed = 70,
	CatchFlingUp = 55,

	-- Capybara
	DeliveryRadius = 30, -- studs from the capy's center that count as "feeding"
	CapyFeastFoodBase = 200, -- snacks the server must feed to fill the meter...
	CapyFeastFoodPerPlayer = 60, -- ...plus this much per player in the server

	-- Pets
	MaxEquippedPets = 3,
	MaxPetInventory = 60,
	AnnounceRareHatchesInServer = true,

	-- Data
	AutoSaveInterval = 60,
	DataStoreName = "FeedTheGiantCapy_PlayerData_v1",
	LeaderboardRefresh = 90,
	LeaderboardSize = 10,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">PetConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Pets hatch from eggs in the hub. Each equipped pet adds (Multiplier - 1)
-- to your cash multiplier, so three x1.5 pets = x2.5 total.
-- Pets are drawn on each client as a colored blob with an emoji face.

export type Pet = {
	Id: string,
	Name: string,
	Emoji: string,
	Rarity: string,
	Multiplier: number,
	Color: Color3,
	Size: number,
}

export type Egg = {
	Id: string,
	Name: string,
	Emoji: string,
	Cost: number,
	RequiredZone: string,
	Color: Color3,
	Pets: { { Id: string, Weight: number } },
}

local PetConfig = {}

PetConfig.Pets = {} :: { [string]: Pet }

local function pet(definition: Pet)
	assert(PetConfig.Pets[definition.Id] == nil, "Duplicate pet id " .. definition.Id)
	PetConfig.Pets[definition.Id] = definition
end

-- Basic egg
pet({
	Id = "SmolCapy",
	Name = "Smol Capy",
	Emoji = "🦫",
	Rarity = "Common",
	Multiplier = 1.1,
	Color = Color3.fromRGB(160, 110, 70),
	Size = 2,
})
pet({
	Id = "SigmaSnail",
	Name = "Sigma Snail",
	Emoji = "🐌",
	Rarity = "Common",
	Multiplier = 1.15,
	Color = Color3.fromRGB(200, 170, 120),
	Size = 2,
})
pet({
	Id = "MewingHamster",
	Name = "Mewing Hamster",
	Emoji = "🐹",
	Rarity = "Uncommon",
	Multiplier = 1.3,
	Color = Color3.fromRGB(240, 190, 130),
	Size = 2,
})
pet({
	Id = "AuraAxolotl",
	Name = "Aura Axolotl",
	Emoji = "🦎",
	Rarity = "Rare",
	Multiplier = 1.6,
	Color = Color3.fromRGB(255, 160, 200),
	Size = 2.2,
})
pet({
	Id = "GoofyGoose",
	Name = "Goofy Goose",
	Emoji = "🦢",
	Rarity = "Epic",
	Multiplier = 2.2,
	Color = Color3.fromRGB(245, 245, 245),
	Size = 2.4,
})
pet({
	Id = "RizzRaccoon",
	Name = "Rizz Raccoon",
	Emoji = "🦝",
	Rarity = "Legendary",
	Multiplier = 3.5,
	Color = Color3.fromRGB(120, 120, 130),
	Size = 2.6,
})

-- Cursed egg
pet({
	Id = "NPCPigeon",
	Name = "NPC Pigeon",
	Emoji = "🐦",
	Rarity = "Common",
	Multiplier = 1.5,
	Color = Color3.fromRGB(150, 150, 170),
	Size = 2,
})
pet({
	Id = "DeluluDog",
	Name = "Delulu Dog",
	Emoji = "🐶",
	Rarity = "Uncommon",
	Multiplier = 2,
	Color = Color3.fromRGB(220, 170, 100),
	Size = 2.2,
})
pet({
	Id = "OhioOpossum",
	Name = "Ohio Opossum",
	Emoji = "🐀",
	Rarity = "Rare",
	Multiplier = 3,
	Color = Color3.fromRGB(200, 200, 210),
	Size = 2.2,
})
pet({
	Id = "SusSeal",
	Name = "Sus Seal",
	Emoji = "🦭",
	Rarity = "Epic",
	Multiplier = 4.5,
	Color = Color3.fromRGB(110, 120, 140),
	Size = 2.4,
})
pet({
	Id = "BrainrotBunny",
	Name = "Brainrot Bunny",
	Emoji = "🐰",
	Rarity = "Legendary",
	Multiplier = 7,
	Color = Color3.fromRGB(255, 200, 230),
	Size = 2.6,
})
pet({
	Id = "QuackzillaJr",
	Name = "Quackzilla Jr.",
	Emoji = "🦆",
	Rarity = "Mythic",
	Multiplier = 15,
	Color = Color3.fromRGB(255, 220, 40),
	Size = 3,
})

-- Mythic meme egg
pet({
	Id = "DuckyDefector",
	Name = "Ducky Defector",
	Emoji = "🐤",
	Rarity = "Uncommon",
	Multiplier = 6,
	Color = Color3.fromRGB(255, 230, 90),
	Size = 2.2,
})
pet({
	Id = "GigachadGecko",
	Name = "Gigachad Gecko",
	Emoji = "🦖",
	Rarity = "Rare",
	Multiplier = 10,
	Color = Color3.fromRGB(90, 200, 110),
	Size = 2.6,
})
pet({
	Id = "ChaosChinchilla",
	Name = "Chaos Chinchilla",
	Emoji = "🐭",
	Rarity = "Epic",
	Multiplier = 18,
	Color = Color3.fromRGB(170, 170, 190),
	Size = 2.6,
})
pet({
	Id = "CapyOverlord",
	Name = "Capy Overlord",
	Emoji = "👑",
	Rarity = "Legendary",
	Multiplier = 35,
	Color = Color3.fromRGB(255, 190, 60),
	Size = 3,
})
pet({
	Id = "TheFinalBrainrot",
	Name = "The Final Brainrot",
	Emoji = "🧠",
	Rarity = "Mythic",
	Multiplier = 100,
	Color = Color3.fromRGB(255, 120, 180),
	Size = 3.4,
})

PetConfig.Eggs = {
	{
		Id = "BasicEgg",
		Name = "Basic Brainrot Egg",
		Emoji = "🥚",
		Cost = 250,
		RequiredZone = "Meadow",
		Color = Color3.fromRGB(240, 235, 210),
		Pets = {
			{ Id = "SmolCapy", Weight = 45 },
			{ Id = "SigmaSnail", Weight = 30 },
			{ Id = "MewingHamster", Weight = 15 },
			{ Id = "AuraAxolotl", Weight = 7 },
			{ Id = "GoofyGoose", Weight = 2.5 },
			{ Id = "RizzRaccoon", Weight = 0.5 },
		},
	},
	{
		Id = "CursedEgg",
		Name = "Cursed Egg",
		Emoji = "🥚",
		Cost = 20000,
		RequiredZone = "Canyon",
		Color = Color3.fromRGB(120, 60, 160),
		Pets = {
			{ Id = "NPCPigeon", Weight = 45 },
			{ Id = "DeluluDog", Weight = 30 },
			{ Id = "OhioOpossum", Weight = 15 },
			{ Id = "SusSeal", Weight = 7 },
			{ Id = "BrainrotBunny", Weight = 2.7 },
			{ Id = "QuackzillaJr", Weight = 0.3 },
		},
	},
	{
		Id = "MythicEgg",
		Name = "Mythic Meme Egg",
		Emoji = "🥚",
		Cost = 1500000,
		RequiredZone = "Backrooms",
		Color = Color3.fromRGB(255, 80, 150),
		Pets = {
			{ Id = "DuckyDefector", Weight = 50 },
			{ Id = "GigachadGecko", Weight = 30 },
			{ Id = "ChaosChinchilla", Weight = 15 },
			{ Id = "CapyOverlord", Weight = 4.5 },
			{ Id = "TheFinalBrainrot", Weight = 0.5 },
		},
	},
} :: { Egg }

PetConfig.EggsById = {} :: { [string]: Egg }
for _, egg in PetConfig.Eggs do
	PetConfig.EggsById[egg.Id] = egg
end

-- Weight multiplier for Rare+ rarities while a Luck Boost is active.
PetConfig.LuckBoostMultiplier = 2

return PetConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">RarityConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Rarity tiers shared by food, pets and titles. `Lucky` tiers get boosted
-- weights while a Luck Boost is active.

export type Rarity = {
	Id: string,
	Name: string,
	Order: number,
	Color: Color3,
	Lucky: boolean,
	Announce: boolean, -- shout to the whole server when hatched
}

local RarityConfig: { [string]: Rarity } = {
	Common = {
		Id = "Common",
		Name = "Common",
		Order = 1,
		Color = Color3.fromRGB(190, 190, 190),
		Lucky = false,
		Announce = false,
	},
	Uncommon = {
		Id = "Uncommon",
		Name = "Uncommon",
		Order = 2,
		Color = Color3.fromRGB(85, 220, 95),
		Lucky = false,
		Announce = false,
	},
	Rare = {
		Id = "Rare",
		Name = "Rare",
		Order = 3,
		Color = Color3.fromRGB(70, 150, 255),
		Lucky = true,
		Announce = false,
	},
	Epic = {
		Id = "Epic",
		Name = "Epic",
		Order = 4,
		Color = Color3.fromRGB(180, 80, 255),
		Lucky = true,
		Announce = false,
	},
	Legendary = {
		Id = "Legendary",
		Name = "Legendary",
		Order = 5,
		Color = Color3.fromRGB(255, 185, 30),
		Lucky = true,
		Announce = true,
	},
	Mythic = {
		Id = "Mythic",
		Name = "BRAINROT MYTHIC",
		Order = 6,
		Color = Color3.fromRGB(255, 60, 140),
		Lucky = true,
		Announce = true,
	},
}

return RarityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">RebirthConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Rebirth resets Cash and Upgrades (zones and pets are kept) in exchange for a
-- permanent cash multiplier and one RNG roll on the title table below.
-- Legendary and Mythic titles also give your character an aura.

export type Title = {
	Id: string,
	Text: string,
	Rarity: string,
	Weight: number,
	Aura: boolean,
}

local RebirthConfig = {
	BaseCost = 100000,
	CostGrowth = 3,
	MultiplierPerRebirth = 0.5, -- x1 -> x1.5 -> x2 -> ...
}

RebirthConfig.Titles = {
	{ Id = "CertifiedSnacker", Text = "Certified Snacker", Rarity = "Common", Weight = 40, Aura = false },
	{ Id = "DuckDodger", Text = "Duck Dodger", Rarity = "Common", Weight = 30, Aura = false },
	{ Id = "CapyWhisperer", Text = "Capy Whisperer", Rarity = "Uncommon", Weight = 15, Aura = false },
	{ Id = "AuraFarmer", Text = "Aura Farmer", Rarity = "Uncommon", Weight = 8, Aura = false },
	{ Id = "SigmaFeeder", Text = "Sigma Feeder", Rarity = "Rare", Weight = 4, Aura = false },
	{ Id = "LordOfSnacks", Text = "Lord of Snacks", Rarity = "Epic", Weight = 2, Aura = false },
	{ Id = "BrainrotRoyalty", Text = "👑 Brainrot Royalty 👑", Rarity = "Legendary", Weight = 0.8, Aura = true },
	{ Id = "MainCharacter", Text = "✨ Main Character ✨", Rarity = "Mythic", Weight = 0.18, Aura = true },
	{ Id = "TheChosenCapy", Text = "🌌 THE CHOSEN CAPY 🌌", Rarity = "Mythic", Weight = 0.02, Aura = true },
} :: { Title }

RebirthConfig.TitlesById = {} :: { [string]: Title }
for _, title in RebirthConfig.Titles do
	RebirthConfig.TitlesById[title.Id] = title
end

return RebirthConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">RewardConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Daily login streak (7-day cycle, resets if you miss a day) and playtime gifts
-- (reset every session). Cash amounts are multiplied by your reward scale:
-- the RewardScale of your best unlocked zone times your rebirth multiplier.
--
-- Reward types:
--   { Type = "Cash", Amount = n }
--   { Type = "CashBoost", Minutes = n }  -- 2x cash
--   { Type = "LuckBoost", Minutes = n }  -- 2x odds for Rare+ pets and titles
--   { Type = "Bundle", Amount = n, CashBoostMinutes = n, LuckBoostMinutes = n }

export type Reward = {
	Type: string,
	Amount: number?,
	Minutes: number?,
	CashBoostMinutes: number?,
	LuckBoostMinutes: number?,
}

local RewardConfig = {}

RewardConfig.Daily = {
	{ Type = "Cash", Amount = 250 },
	{ Type = "Cash", Amount = 500 },
	{ Type = "CashBoost", Minutes = 10 },
	{ Type = "Cash", Amount = 1500 },
	{ Type = "LuckBoost", Minutes = 15 },
	{ Type = "Cash", Amount = 4000 },
	{ Type = "Bundle", Amount = 10000, CashBoostMinutes = 20, LuckBoostMinutes = 20 },
} :: { Reward }

RewardConfig.Playtime = {
	{ Minutes = 5, Reward = { Type = "Cash", Amount = 200 } :: Reward },
	{ Minutes = 10, Reward = { Type = "CashBoost", Minutes = 5 } :: Reward },
	{ Minutes = 20, Reward = { Type = "Cash", Amount = 1500 } :: Reward },
	{ Minutes = 40, Reward = { Type = "LuckBoost", Minutes = 10 } :: Reward },
	{
		Minutes = 60,
		Reward = { Type = "Bundle", Amount = 8000, CashBoostMinutes = 15, LuckBoostMinutes = 15 } :: Reward,
	},
}

RewardConfig.CashBoostMultiplier = 2

return RewardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Every sound cue in the game. Each cue is one or more layers played together,
-- which lets a few base sounds stack into louder, sillier "stings".
--
-- The defaults use sound files that ship inside the Roblox client
-- (rbxasset://sounds/...), so they always load, even in an unpublished place.
-- To use your own audio, replace an Id with "rbxassetid://<number>" from the
-- Creator Store or your own uploads. Set Id = "" to mute a layer.

export type Layer = {
	Id: string,
	Volume: number,
	Speed: number, -- PlaybackSpeed (also changes pitch)
	Variance: number?, -- random +/- added to Speed each play
	Delay: number?,
}

export type Cue = {
	Layers: { Layer },
}

local Sounds = {
	Oof = "rbxasset://sounds/oof.ogg",
	Ouch = "rbxasset://sounds/ouch.ogg",
	Explosion = "rbxasset://sounds/impact_explosion_03.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Jump = "rbxasset://sounds/action_jump.mp3",
	Land = "rbxasset://sounds/action_jump_land.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Falling = "rbxasset://sounds/action_falling.ogg",
	Swim = "rbxasset://sounds/action_swim.mp3",
	Footsteps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	Tick = "rbxasset://sounds/volume_slider.ogg",
}

local SoundConfig = {
	Sounds = Sounds,
	-- Background music. None ships with the client; add an rbxassetid here.
	MusicId = "",
	MusicVolume = 0.25,
}

SoundConfig.Cues = {
	UIClick = { Layers = { { Id = Sounds.Tick, Volume = 0.6, Speed = 1.3, Variance = 0.05 } } },
	UIError = {
		Layers = { { Id = Sounds.Tick, Volume = 0.7, Speed = 0.5 }, { Id = Sounds.Oof, Volume = 0.25, Speed = 1.6 } },
	},
	Purchase = {
		Layers = {
			{ Id = Sounds.Tick, Volume = 0.7, Speed = 1.8 },
			{ Id = Sounds.Tick, Volume = 0.7, Speed = 2.4, Delay = 0.07 },
			{ Id = Sounds.Jump, Volume = 0.5, Speed = 1.4 },
		},
	},
	Pickup = { Layers = { { Id = Sounds.Tick, Volume = 0.55, Speed = 1.9, Variance = 0.25 } } },
	MachineClick = {
		Layers = {
			{ Id = Sounds.Tick, Volume = 0.5, Speed = 1.5, Variance = 0.2 },
			{ Id = Sounds.Land, Volume = 0.2, Speed = 1.8 },
		},
	},
	CarryFull = { Layers = { { Id = Sounds.Ouch, Volume = 0.35, Speed = 1.7 } } },
	Deliver = {
		Layers = {
			{ Id = Sounds.Splash, Volume = 0.6, Speed = 1.4, Variance = 0.1 },
			{ Id = Sounds.Land, Volume = 0.8, Speed = 0.6 },
			{ Id = Sounds.Tick, Volume = 0.6, Speed = 2.2, Delay = 0.1 },
			{ Id = Sounds.Tick, Volume = 0.6, Speed = 2.6, Delay = 0.18 },
		},
	},
	DuckSpotted = {
		Layers = {
			{ Id = Sounds.Ouch, Volume = 1, Speed = 2.3 },
			{ Id = Sounds.Ouch, Volume = 0.8, Speed = 2.6, Delay = 0.12 },
			{ Id = Sounds.Explosion, Volume = 0.35, Speed = 1.6 },
		},
	},
	DuckLost = { Layers = { { Id = Sounds.Swim, Volume = 0.5, Speed = 1.2 } } },
	Caught = {
		Layers = {
			{ Id = Sounds.Oof, Volume = 1, Speed = 1, Variance = 0.1 },
			{ Id = Sounds.Explosion, Volume = 0.6, Speed = 1.2 },
			{ Id = Sounds.Ouch, Volume = 0.9, Speed = 2.4, Delay = 0.05 },
			{ Id = Sounds.Falling, Volume = 0.4, Speed = 1.3 },
		},
	},
	GetUp = { Layers = { { Id = Sounds.GetUp, Volume = 0.8, Speed = 1 } } },
	EggShake = { Layers = { { Id = Sounds.Tick, Volume = 0.5, Speed = 0.9, Variance = 0.3 } } },
	Hatch = {
		Layers = {
			{ Id = Sounds.Explosion, Volume = 0.5, Speed = 1.5 },
			{ Id = Sounds.Jump, Volume = 0.6, Speed = 1.6 },
		},
	},
	HatchRare = {
		Layers = {
			{ Id = Sounds.Explosion, Volume = 0.9, Speed = 0.8 },
			{ Id = Sounds.Oof, Volume = 0.6, Speed = 0.5 },
			{ Id = Sounds.Jump, Volume = 0.7, Speed = 0.7, Delay = 0.15 },
		},
	},
	Rebirth = {
		Layers = {
			{ Id = Sounds.Explosion, Volume = 1, Speed = 0.55 },
			{ Id = Sounds.Jump, Volume = 0.8, Speed = 0.5 },
			{ Id = Sounds.Oof, Volume = 0.5, Speed = 0.4, Delay = 0.2 },
		},
	},
	EventStart = {
		Layers = {
			{ Id = Sounds.Explosion, Volume = 0.7, Speed = 0.7 },
			{ Id = Sounds.Ouch, Volume = 0.5, Speed = 2, Delay = 0.1 },
			{ Id = Sounds.Ouch, Volume = 0.5, Speed = 2.4, Delay = 0.25 },
		},
	},
	RewardClaim = {
		Layers = {
			{ Id = Sounds.Tick, Volume = 0.7, Speed = 1.6 },
			{ Id = Sounds.Tick, Volume = 0.7, Speed = 2, Delay = 0.08 },
			{ Id = Sounds.Tick, Volume = 0.7, Speed = 2.5, Delay = 0.16 },
			{ Id = Sounds.Jump, Volume = 0.5, Speed = 1.2 },
		},
	},
	Notify = { Layers = { { Id = Sounds.Tick, Volume = 0.5, Speed = 1.1 } } },
} :: { [string]: Cue }

-- 3D sounds attached to the ducks on the server (heard by everyone nearby).
SoundConfig.Duck = {
	Quack = { Id = Sounds.Oof, Volume = 1.6, Speed = 2.1 },
	Squeak = { Id = Sounds.Ouch, Volume = 2, Speed = 2.5 },
	Waddle = { Id = Sounds.Footsteps, Volume = 0.8, Speed = 0.55 },
	RollOffMaxDistance = 140,
}

-- 3D sounds on the Capybara.
SoundConfig.Capy = {
	Chomp = { Id = Sounds.Land, Volume = 2, Speed = 0.45 },
	Happy = { Id = Sounds.Jump, Volume = 1.5, Speed = 0.6 },
	RollOffMaxDistance = 200,
}

return SoundConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">UpgradeConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Upgrade shop. Stat = Base + PerLevel * level. Cost = BaseCost * CostGrowth^level.
-- Upgrades reset on rebirth.

export type Upgrade = {
	Id: string,
	Name: string,
	Emoji: string,
	Description: string,
	Base: number,
	PerLevel: number,
	MaxLevel: number,
	BaseCost: number,
	CostGrowth: number,
	Unit: string, -- shown next to the stat in the shop
}

local UpgradeConfig = {}

UpgradeConfig.List = {
	{
		Id = "Capacity",
		Name = "Bigger Backpack",
		Emoji = "🎒",
		Description = "Carry more snacks per trip",
		Base = 5,
		PerLevel = 2,
		MaxLevel = 25,
		BaseCost = 25,
		CostGrowth = 1.55,
		Unit = " snacks",
	},
	{
		Id = "Speed",
		Name = "Zoomies",
		Emoji = "👟",
		Description = "Run faster (outrun the duck!)",
		Base = 16,
		PerLevel = 1,
		MaxLevel = 14,
		BaseCost = 40,
		CostGrowth = 1.65,
		Unit = " speed",
	},
	{
		Id = "Value",
		Name = "Snack Seasoning",
		Emoji = "🧂",
		Description = "Every snack is worth more",
		Base = 1,
		PerLevel = 0.2,
		MaxLevel = 50,
		BaseCost = 60,
		CostGrowth = 1.45,
		Unit = "x cash",
	},
	{
		Id = "Magnet",
		Name = "Snack Magnet",
		Emoji = "🧲",
		Description = "Grab snacks from further away",
		Base = 6,
		PerLevel = 1.5,
		MaxLevel = 12,
		BaseCost = 50,
		CostGrowth = 1.7,
		Unit = " studs",
	},
	{
		Id = "ClickPower",
		Name = "Turbo Fingers",
		Emoji = "👆",
		Description = "More snacks per snack-machine click",
		Base = 1,
		PerLevel = 1,
		MaxLevel = 9,
		BaseCost = 75,
		CostGrowth = 1.85,
		Unit = " per click",
	},
} :: { Upgrade }

UpgradeConfig.ById = {} :: { [string]: Upgrade }
for _, upgrade in UpgradeConfig.List do
	UpgradeConfig.ById[upgrade.Id] = upgrade
end

return UpgradeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ZoneConfig</string>
            <string name="Source"><![CDATA[--!strict
-- The hub (where the Capybara lives) is always safe. Each zone sits on one side
-- of the hub, has its own snacks, snack machines and rubber duck(s).
-- Zones are listed in unlock order.

export type DuckStats = {
	Name: string,
	Count: number,
	Scale: number,
	PatrolSpeed: number,
	ChaseSpeed: number,
	SightRange: number,
	FieldOfView: number, -- degrees
	CatchRadius: number,
	GiveUpTime: number, -- seconds without line of sight before it stops chasing
	Color: Color3,
}

export type Zone = {
	Id: string,
	Name: string,
	Emoji: string,
	Order: number,
	Cost: number,
	Direction: Vector3, -- which side of the hub it's on
	FloorColor: Color3,
	WallColor: Color3,
	PropColors: { Color3 },
	Foods: { { Id: string, Weight: number } },
	GoldenFood: string,
	MachineFood: string,
	MachineName: string,
	SpawnCap: number, -- max snacks lying around at once
	SpawnInterval: number, -- seconds between spawns while under the cap
	ObstacleCount: number,
	RewardScale: number, -- scales daily/playtime cash rewards once unlocked
	Duck: DuckStats,
}

