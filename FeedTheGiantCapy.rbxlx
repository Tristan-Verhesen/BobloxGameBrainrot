        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[-- Egg hatching, pet inventory and equipping. Equipped pets are published as
-- a player attribute ("EquippedPets" = "SmolCapy,AuraAxolotl") and drawn by
-- every client (see client PetFollowController), which keeps the server cheap.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local PetConfig = require(Shared.Config.PetConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local PetService = {}

local HATCH_COOLDOWN = 1.2
local rng = Random.new()
local lastHatch: { [Player]: number } = {}

local function countPets(data: any): number
	local count = 0
	for _ in data.Pets do
		count += 1
	end
	return count
end

local function publishEquipped(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local ids = {}
	for _, uid in data.EquippedPets do
		local petId = data.Pets[uid]
		if petId then
			table.insert(ids, petId)
		end
	end
	player:SetAttribute("EquippedPets", table.concat(ids, ","))
end

-- Rolls a pet from an egg. Luck boosts multiply the weight of Rare+ pets.
function PetService.Roll(eggId: string, lucky: boolean): string
	local egg = PetConfig.EggsById[eggId]
	local entry = WeightedRandom.Pick(egg.Pets, rng, function(e)
		local pet = PetConfig.Pets[e.Id]
		if lucky and RarityConfig[pet.Rarity].Lucky then
			return e.Weight * PetConfig.LuckBoostMultiplier
		end
		return e.Weight
	end)
	return entry.Id
end

function PetService.Hatch(player: Player, eggId: any): (boolean, string?)
	if type(eggId) ~= "string" then
		return false, "Invalid egg"
	end
	local egg = PetConfig.EggsById[eggId]
	local data = DataService.Get(player)
	if not egg or not data then
		return false, "Invalid egg"
	end
	local now = os.clock()
	if now - (lastHatch[player] or 0) < HATCH_COOLDOWN then
		return false, nil -- still animating the last hatch; ignore quietly
	end
	if not data.Zones[egg.RequiredZone] then
		return false, "🔒 Unlock " .. ZoneConfig.ById[egg.RequiredZone].Name .. " to hatch this egg"
	end
	if countPets(data) >= GameConfig.MaxPetInventory then
		return false, "Pet inventory full! Delete some pets first."
	end
	if not DataService.SpendCash(player, egg.Cost) then
		return false, "Need " .. Format.Cash(egg.Cost - data.Cash) .. " more"
	end
	lastHatch[player] = now

	local petId = PetService.Roll(eggId, Formulas.IsBoostActive(data, "Luck", os.time()))
	local uid = "P" .. data.NextPetUid
	data.NextPetUid += 1
	data.Pets[uid] = petId
	DataService.AddStat(player, "PetsHatched", 1)
	DataService.MarkChanged(player, "Pets")
	DataService.MarkChanged(player, "NextPetUid")

	if #data.EquippedPets < GameConfig.MaxEquippedPets then
		table.insert(data.EquippedPets, uid)
		DataService.MarkChanged(player, "EquippedPets")
		publishEquipped(player)
	end

	Net.Fire(player, "HatchResult", eggId, petId, uid)
	local pet = PetConfig.Pets[petId]
	local rarity = RarityConfig[pet.Rarity]
	if GameConfig.AnnounceRareHatchesInServer and rarity.Announce then
		Net.FireAll(
			"Announce",
			string.format("%s hatched a %s %s %s!", player.DisplayName, rarity.Name, pet.Emoji, pet.Name),
			rarity.Color
		)
	end
	return true, nil
end

local function equip(player: Player, uid: any): (boolean, string?)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" or not data.Pets[uid] then
		return false, "Invalid pet"
	end
	if table.find(data.EquippedPets, uid) then
		return false, "Already equipped"
	end
	if #data.EquippedPets >= GameConfig.MaxEquippedPets then
		return false, "All " .. GameConfig.MaxEquippedPets .. " pet slots are full"
	end
	table.insert(data.EquippedPets, uid)
	DataService.MarkChanged(player, "EquippedPets")
	publishEquipped(player)
	return true, nil
end

local function unequip(player: Player, uid: any): (boolean, string?)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" then
		return false, "Invalid pet"
	end
	local index = table.find(data.EquippedPets, uid)
	if not index then
		return false, "Not equipped"
	end
	table.remove(data.EquippedPets, index)
	DataService.MarkChanged(player, "EquippedPets")
	publishEquipped(player)
	return true, nil
end

local function equipBest(player: Player): (boolean, string?)
	local data = DataService.Get(player)
	if not data then
		return false, nil
	end
	local owned = {}
	for uid, petId in data.Pets do
		table.insert(owned, { Uid = uid, Multiplier = PetConfig.Pets[petId].Multiplier })
	end
	table.sort(owned, function(a, b)
		return a.Multiplier > b.Multiplier
	end)
	local equipped = {}
	for index = 1, math.min(GameConfig.MaxEquippedPets, #owned) do
		equipped[index] = owned[index].Uid
	end
	data.EquippedPets = equipped
	DataService.MarkChanged(player, "EquippedPets")
	publishEquipped(player)
	return true, "Equipped your best pets!"
end

local function delete(player: Player, uid: any): (boolean, string?)
	local data = DataService.Get(player)
	if not data or type(uid) ~= "string" or not data.Pets[uid] then
		return false, "Invalid pet"
	end
	local index = table.find(data.EquippedPets, uid)
	if index then
		table.remove(data.EquippedPets, index)
		DataService.MarkChanged(player, "EquippedPets")
	end
	data.Pets[uid] = nil
	DataService.MarkChanged(player, "Pets")
	publishEquipped(player)
	return true, nil
end

function PetService.Start()
	Net.Handle("HatchEgg", PetService.Hatch, 3)
	Net.Handle("EquipPet", equip, 8)
	Net.Handle("UnequipPet", unequip, 8)
	Net.Handle("EquipBest", equipBest, 2)
	Net.Handle("DeletePet", delete, 8)

	for _, stand in MapBuilder.EggStands do
		stand.Prompt.Triggered:Connect(function(player)
			local ok, message = PetService.Hatch(player, stand.EggId)
			if not ok and message then
				Net.Fire(player, "Notify", message, "Bad")
			end
		end)
	end

	DataService.Loaded:Connect(function(player, data)
		-- Drop equipped uids that no longer exist (e.g. edited saves).
		local valid = {}
		for _, uid in data.EquippedPets do
			if data.Pets[uid] and PetConfig.Pets[data.Pets[uid]] and not table.find(valid, uid) then
				table.insert(valid, uid)
			end
		end
		data.EquippedPets = valid
		for uid, petId in data.Pets do
			if not PetConfig.Pets[petId] then
				data.Pets[uid] = nil -- pet removed from config
			end
		end
		publishEquipped(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastHatch[player] = nil
	end)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RagdollService</string>
            <string name="Source"><![CDATA[-- Goofy ragdolls for R15 and R6. The server swaps each Motor6D for a
-- BallSocketConstraint and adds invisible limb colliders; the owning client
-- switches its Humanoid into the Physics state and applies the fling (the
-- client owns its character's physics, so velocity must be set there).

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local RagdollService = {}

local PLAYER_GROUP = "Players"
local COLLIDER_GROUP = "RagdollColliders"

type RagdollState = {
	Motors: { Motor6D },
	Created: { Instance },
	RootCollide: boolean,
}

local states: { [Model]: RagdollState } = {}

local function setupCollisionGroups()
	for _, group in { PLAYER_GROUP, COLLIDER_GROUP } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(group)
		end)
	end
	-- Players walk through each other (no blocking doorways), and ragdoll
	-- limbs don't jitter against each other or their owner's body.
	PhysicsService:CollisionGroupSetCollidable(PLAYER_GROUP, PLAYER_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(PLAYER_GROUP, COLLIDER_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(COLLIDER_GROUP, COLLIDER_GROUP, false)
end

function RagdollService.IsRagdolled(character: Model?): boolean
	return character ~= nil and character:GetAttribute("Ragdolled") == true
end

-- Seconds of immunity remaining after getting up.
function RagdollService.IsImmune(character: Model?): boolean
	return character ~= nil and (character:GetAttribute("ImmuneUntil") or 0) > os.clock()
end

local function recover(player: Player, character: Model)
	local state = states[character]
	states[character] = nil
	if not state or character.Parent == nil then
		return
	end
	for _, instance in state.Created do
		instance:Destroy()
	end
	for _, motor in state.Motors do
		motor.Enabled = true
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.RequiresNeck = true
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.CanCollide = state.RootCollide
	end

	character:SetAttribute("Ragdolled", false)
	character:SetAttribute("ImmuneUntil", os.clock() + GameConfig.PostRagdollImmunity)
	local shield = Make.Instance("ForceField", { Visible = true, Parent = character })
	task.delay(GameConfig.PostRagdollImmunity, function()
		shield:Destroy()
	end)
	if player.Parent then
		Net.Fire(player, "Ragdoll", false)
	end
end

-- Ragdolls a player's character for `duration` seconds and flings it.
-- Returns false if they're already ragdolled.
function RagdollService.Ragdoll(player: Player, duration: number, fling: Vector3): boolean
	local character = player.Character
	if not character or RagdollService.IsRagdolled(character) then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	character:SetAttribute("Ragdolled", true)
	humanoid.RequiresNeck = false
	local state: RagdollState = { Motors = {}, Created = {}, RootCollide = true }
	states[character] = state

	for _, motor in character:GetDescendants() do
		-- Keep the root joint so the camera and HumanoidRootPart follow the body.
		if not motor:IsA("Motor6D") or motor.Name == "Root" or motor.Name == "RootJoint" then
			continue
		end
		local part0, part1 = motor.Part0, motor.Part1
		if not part0 or not part1 then
			continue
		end
		local attachment0 = Make.Instance("Attachment", { Name = "RagdollA0", CFrame = motor.C0, Parent = part0 })
		local attachment1 = Make.Instance("Attachment", { Name = "RagdollA1", CFrame = motor.C1, Parent = part1 })
		local socket = Make.Instance("BallSocketConstraint", {
			Name = "RagdollSocket",
			Attachment0 = attachment0,
			Attachment1 = attachment1,
			LimitsEnabled = true,
			TwistLimitsEnabled = true,
			UpperAngle = 50,
			TwistLowerAngle = -50,
			TwistUpperAngle = 50,
			Parent = part0,
		})
		table.insert(state.Created, attachment0)
		table.insert(state.Created, attachment1)
		table.insert(state.Created, socket)
		motor.Enabled = false
		table.insert(state.Motors, motor)
	end

	-- Most limbs don't collide by default; give each one a collider so the
	-- body lands on the floor instead of sinking through it.
	for _, part in character:GetChildren() do
		if not part:IsA("BasePart") or part.Name == "HumanoidRootPart" then
			continue
		end
		local collider = Make.Part({
			Name = "RagdollCollider",
			Anchored = false,
			Massless = true,
			CanCollide = true,
			CanQuery = false,
			CanTouch = false,
			Transparency = 1,
			Size = part.Size * 0.8,
			CFrame = part.CFrame,
			CollisionGroup = COLLIDER_GROUP,
			Parent = part,
		})
		Make.Instance("WeldConstraint", { Part0 = part, Part1 = collider, Parent = collider })
		table.insert(state.Created, collider)
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		state.RootCollide = root.CanCollide
		root.CanCollide = false
	end

	Net.Fire(player, "Ragdoll", true, fling)
	task.delay(duration, recover, player, character)
	return true
end

function RagdollService.Start()
	setupCollisionGroups()

	local function onCharacter(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.BreakJointsOnDeath = false
		end
		local function setGroup(part: Instance)
			if part:IsA("BasePart") and part.Name ~= "RagdollCollider" then
				part.CollisionGroup = PLAYER_GROUP
			end
		end
		for _, part in character:GetDescendants() do
			setGroup(part)
		end
		character.DescendantAdded:Connect(setGroup)
		character.Destroying:Connect(function()
			states[character] = nil
		end)
	end

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(onCharacter)
		if player.Character then
			task.spawn(onCharacter, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return RagdollService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[-- Rebirths (reset Cash + Upgrades for a permanent multiplier and an RNG title
-- roll) and the title tag / aura shown above each player.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local PetConfig = require(Shared.Config.PetConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local DataService = require(script.Parent.DataService)

local RebirthService = {}

local rng = Random.new()

local function rollTitle(lucky: boolean): RebirthConfig.Title
	return WeightedRandom.Pick(RebirthConfig.Titles, rng, function(title)
		if lucky and RarityConfig[title.Rarity].Lucky then
			return title.Weight * PetConfig.LuckBoostMultiplier
		end
		return title.Weight
	end)
end

local function rarityOrder(titleId: string): number
	local title = RebirthConfig.TitlesById[titleId]
	return if title then RarityConfig[title.Rarity].Order else 0
end

-- Rebuilds the floating title tag and aura on the player's character.
function RebirthService.ApplyTitle(player: Player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	for _, name in { "TitleTag", "TitleAura" } do
		local existing = character:FindFirstChild(name, true)
		if existing then
			existing:Destroy()
		end
	end
	if not head then
		return
	end

	local title = RebirthConfig.TitlesById[data.EquippedTitle]
	local lines = {}
	if title then
		table.insert(lines, Make.Colored(title.Text, RarityConfig[title.Rarity].Color))
	end
	if data.Rebirths > 0 then
		table.insert(lines, Make.Colored("🔁 Rebirth " .. data.Rebirths, Color3.fromRGB(200, 200, 255)))
	end
	if #lines > 0 then
		local gui =
			Make.Billboard(head, Vector2.new(10, 1.2 * #lines), Vector3.new(0, 2.6, 0), table.concat(lines, "\n"), {
				Name = "TitleLabel",
			})
		gui.Name = "TitleTag"
		gui.MaxDistance = 80
	end
	if title and title.Aura and root then
		Make.Instance("ParticleEmitter", {
			Name = "TitleAura",
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Color = ColorSequence.new(RarityConfig[title.Rarity].Color),
			LightEmission = 1,
			Rate = 14,
			Lifetime = NumberRange.new(0.8, 1.4),
			Speed = NumberRange.new(1, 3),
			SpreadAngle = Vector2.new(180, 180),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Parent = root,
		})
	end
end

local function rebirth(player: Player): (boolean, string?)
	local data = DataService.Get(player)
	if not data then
		return false, nil
	end
	local cost = Formulas.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, "Need " .. Format.Cash(cost - data.Cash) .. " more to rebirth"
	end

	data.Cash = 0
	data.Upgrades = {}
	data.Rebirths += 1
	local title = rollTitle(Formulas.IsBoostActive(data, "Luck", os.time()))
	local isNew = not data.Titles[title.Id]
	data.Titles[title.Id] = true
	if rarityOrder(title.Id) > rarityOrder(data.EquippedTitle) then
		data.EquippedTitle = title.Id
	end
	for _, key in { "Cash", "Upgrades", "Rebirths", "Titles", "EquippedTitle" } do
		DataService.MarkChanged(player, key)
	end
	RebirthService.ApplyTitle(player)

	Net.Fire(player, "Effect", "Rebirth", {
		Rebirths = data.Rebirths,
		TitleId = title.Id,
		New = isNew,
		Multiplier = Formulas.RebirthMultiplier(data.Rebirths),
	})
	local rarity = RarityConfig[title.Rarity]
	if rarity.Announce and GameConfig.AnnounceRareHatchesInServer then
		Net.FireAll(
			"Announce",
			string.format('%s rolled the %s title "%s"!', player.DisplayName, rarity.Name, title.Text),
			rarity.Color
		)
	end
	return true, nil
end

local function equipTitle(player: Player, titleId: any): (boolean, string?)
	local data = DataService.Get(player)
	if not data or type(titleId) ~= "string" then
		return false, nil
	end
	if titleId ~= "" and not data.Titles[titleId] then
		return false, "You don't own that title"
	end
	data.EquippedTitle = titleId
	DataService.MarkChanged(player, "EquippedTitle")
	RebirthService.ApplyTitle(player)
	return true, nil
end

function RebirthService.Start()
	Net.Handle("Rebirth", rebirth, 1)
	Net.Handle("EquipTitle", equipTitle, 4)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 10)
			RebirthService.ApplyTitle(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Daily login streak and per-session playtime gifts.
-- Playtime is measured from when the player's data loaded; the client reads
-- the "SessionStart" attribute (server time) to show countdowns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RewardConfig = require(Shared.Config.RewardConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)

local RewardService = {}

local sessionStart: { [Player]: number } = {}
local claimedGifts: { [Player]: { [number]: boolean } } = {}

local function extendBoost(data: any, boost: string, minutes: number)
	local now = os.time()
	data.Boosts[boost] = math.max(now, data.Boosts[boost] or 0) + minutes * 60
end

-- Grants a reward and returns a short description of it.
function RewardService.Grant(player: Player, reward: RewardConfig.Reward): string
	local data = DataService.Get(player)
	if not data then
		return ""
	end
	local parts = {}
	if (reward.Type == "Cash" or reward.Type == "Bundle") and reward.Amount then
		local cash = Formulas.RewardCash(data, reward.Amount)
		DataService.AddCash(player, cash)
		table.insert(parts, "💵 " .. Format.Cash(cash))
	end
	local cashMinutes = if reward.Type == "CashBoost" then reward.Minutes else reward.CashBoostMinutes
	if cashMinutes then
		extendBoost(data, "Cash", cashMinutes)
		table.insert(parts, string.format("💸 2x Cash (%d min)", cashMinutes))
	end
	local luckMinutes = if reward.Type == "LuckBoost" then reward.Minutes else reward.LuckBoostMinutes
	if luckMinutes then
		extendBoost(data, "Luck", luckMinutes)
		table.insert(parts, string.format("🍀 2x Luck (%d min)", luckMinutes))
	end
	if cashMinutes or luckMinutes then
		DataService.MarkChanged(player, "Boosts")
	end
	return table.concat(parts, " + ")
end

local function claimDaily(player: Player): (boolean, string?)
	local data = DataService.Get(player)
	if not data then
		return false, nil
	end
	local now = os.time()
	local canClaim, streak, rewardIndex = Formulas.DailyStatus(data, now)
	if not canClaim then
		return false, "Already claimed today, come back tomorrow!"
	end
	data.Daily = { LastClaimDay = Formulas.DayNumber(now), Streak = streak }
	DataService.MarkChanged(player, "Daily")
	local description = RewardService.Grant(player, RewardConfig.Daily[rewardIndex])
	return true, string.format("🔥 Day %d streak! %s", streak, description)
end

local function claimPlaytime(player: Player, index: any): (boolean, string?)
	if type(index) ~= "number" then
		return false, nil
	end
	local gift = RewardConfig.Playtime[index]
	local start = sessionStart[player]
	if not gift or not start then
		return false, nil
	end
	local claimed = claimedGifts[player]
	if claimed[index] then
		return false, "Already claimed"
	end
	local elapsed = workspace:GetServerTimeNow() - start
	if elapsed < gift.Minutes * 60 then
		return false, "Not ready yet: " .. Format.Time(gift.Minutes * 60 - elapsed)
	end
	claimed[index] = true
	player:SetAttribute("GiftClaimed_" .. index, true)
	return true, "🎁 " .. RewardService.Grant(player, gift.Reward)
end

function RewardService.Start()
	Net.Handle("ClaimDaily", claimDaily, 2)
	Net.Handle("ClaimPlaytime", claimPlaytime, 4)

	DataService.Loaded:Connect(function(player)
		local now = workspace:GetServerTimeNow()
		sessionStart[player] = now
		claimedGifts[player] = {}
		player:SetAttribute("SessionStart", now)
	end)

	-- Track total play time for stats.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				DataService.AddStat(player, "PlaySeconds", 60)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessionStart[player] = nil
		claimedGifts[player] = nil
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">UpgradeService</string>
            <string name="Source"><![CDATA[-- Upgrade shop purchases, and applying upgrade stats to the character.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)

local UpgradeService = {}

function UpgradeService.ApplyStats(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("PickupRange", Formulas.PickupRange(data))
	player:SetAttribute("ClickPower", Formulas.ClickPower(data))
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = Formulas.WalkSpeed(data)
	end
end

local function buy(player: Player, upgradeId: any): (boolean, string?)
	if type(upgradeId) ~= "string" then
		return false, "Invalid upgrade"
	end
	local upgrade = UpgradeConfig.ById[upgradeId]
	local data = DataService.Get(player)
	if not upgrade or not data then
		return false, "Invalid upgrade"
	end
	local level = Formulas.UpgradeLevel(data, upgradeId)
	if level >= upgrade.MaxLevel then
		return false, "Already maxed!"
	end
	local cost = Formulas.UpgradeCost(upgradeId, level)
	if not DataService.SpendCash(player, cost) then
		return false, "Need " .. Format.Cash(cost - data.Cash) .. " more"
	end
	data.Upgrades[upgradeId] = level + 1
	DataService.MarkChanged(player, "Upgrades")
	return true, string.format("%s %s Lv.%d!", upgrade.Emoji, upgrade.Name, level + 1)
end

function UpgradeService.Start()
	Net.Handle("BuyUpgrade", buy, 10)

	DataService.Changed:Connect(function(player, key)
		if key == "Upgrades" then
			UpgradeService.ApplyStats(player)
		end
	end)
	DataService.Loaded:Connect(UpgradeService.ApplyStats)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			UpgradeService.ApplyStats(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return UpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ZoneService</string>
            <string name="Source"><![CDATA[-- Unlocking zones (gate prompts or the shop) and keeping players out of zones
-- they haven't unlocked. Gates are solid on the server; each client makes its
-- own unlocked gates walk-through (see client GateController).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Format = require(Shared.Util.Format)
local MapLayout = require(Shared.MapLayout)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local ZoneService = {}

local ENFORCE_DEPTH = 6 -- studs past the hub edge
local lastWarned: { [Player]: number } = {}

function ZoneService.Unlock(player: Player, zoneId: any): (boolean, string?)
	if type(zoneId) ~= "string" then
		return false, "Invalid zone"
	end
	local zone = ZoneConfig.ById[zoneId]
	local data = DataService.Get(player)
	if not zone or not data then
		return false, "Invalid zone"
	end
	if data.Zones[zoneId] then
		return false, "Already unlocked"
	end
	local previous = ZoneConfig.List[zone.Order - 1]
	if previous and not data.Zones[previous.Id] then
		return false, "Unlock " .. previous.Name .. " first!"
	end
	if not DataService.SpendCash(player, zone.Cost) then
		return false, "Need " .. Format.Cash(zone.Cost - data.Cash) .. " more"
	end
	data.Zones[zoneId] = true
	DataService.MarkChanged(player, "Zones")
	Net.Fire(player, "Effect", "ZoneUnlocked", { ZoneId = zoneId })
	return true, zone.Emoji .. " " .. zone.Name .. " unlocked!"
end

local function enforceTick()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local data = DataService.Get(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not data or not root then
			continue
		end
		local position = (root :: BasePart).Position
		local zoneId = MapLayout.ZoneAt(position)
		-- Only act once they're properly inside, so leaning on a locked gate
		-- from the hub side never teleports anyone.
		if zoneId and not data.Zones[zoneId] and MapLayout.DepthInZone(zoneId, position) > ENFORCE_DEPTH then
			local spawn = MapBuilder.Spawn
			if spawn then
				character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
			end
			if now - (lastWarned[player] or 0) > 3 then
				lastWarned[player] = now
				Net.Fire(player, "Notify", "🔒 That zone is locked! Unlock it at its gate.", "Bad")
			end
		end
	end
end

function ZoneService.Start()
	Net.Handle("UnlockZone", ZoneService.Unlock, 4)

	for _, gate in CollectionService:GetTagged("ZoneGate") do
		local prompt = gate:FindFirstChild("UnlockPrompt", true)
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Triggered:Connect(function(player)
				local ok, message = ZoneService.Unlock(player, gate:GetAttribute("ZoneId"))
				Net.Fire(player, "Notify", message or "", if ok then "Good" else "Bad")
			end)
		end
	end

	task.spawn(function()
		while true do
			task.wait(1)
			enforceTick()
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastWarned[player] = nil
	end)
end

return ZoneService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="42">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="43">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="44">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ClientData</string>
            <string name="Source"><![CDATA[-- The local player's save data, mirrored from the server. The server sends a
-- full snapshot once (GetData) and then whole top-level keys as they change.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local ClientData = {
	Data = nil :: any,
	Offline = false,
	Changed = Signal.new(), -- (key, value)
}

function ClientData.Get(key: string): any
	return ClientData.Data and ClientData.Data[key]
end

-- Calls `callback` now and again whenever any of `keys` changes.
function ClientData.Observe(keys: { string }, callback: () -> ())
	callback()
	ClientData.Changed:Connect(function(key)
		if table.find(keys, key) then
			callback()
		end
	end)
end

-- Yields until the first snapshot arrives.
function ClientData.Load()
	Net.Event("DataChanged").OnClientEvent:Connect(function(key, value)
		if ClientData.Data then
			ClientData.Data[key] = value
			ClientData.Changed:Fire(key, value)
		end
	end)
	while true do
		local ok, flag, data = Net.Invoke("GetData")
		if ok and data then
			ClientData.Data = data
			ClientData.Offline = flag == "offline"
			return
		end
		task.wait(2)
	end
end

return ClientData
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[-- All the "brainrot juice": screen shake, FOV punches, color flashes, giant
-- meme text, floating world popups, particle bursts, the red chase vignette,
-- the bonk kill feed and server announcements. Also handles the "Effect"
-- remote from the server.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EventConfig = require(Shared.Config.EventConfig)
local FoodConfig = require(Shared.Config.FoodConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local SoundController = require(script.Parent.SoundController)

local EffectsController = {}

local player = Players.LocalPlayer
local rng = Random.new()
local camera = workspace.CurrentCamera

local shakeIntensity = 0
local shakeDecay = 0
local fovOffset = 0
local flashFrame: Frame
local vignette: { Frame } = {}
local killFeed: Frame
local bannerHolder: Frame

local BRAINROT_WORDS = {
	"BUSSIN",
	"SHEESH",
	"+AURA",
	"W FEED",
	"CHONKY",
	"SIGMA",
	"NO CAP",
	"CRONCHY",
	"OHIO MOMENT",
	"MEWING",
	"RIZZ'D",
	"CAPY APPROVED",
	"YUMMERS",
	"SLAY",
}

-- Screen shake ----------------------------------------------------------------

function EffectsController.Shake(intensity: number, duration: number)
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeDecay = math.max(shakeDecay, intensity / math.max(duration, 0.05))
end

function EffectsController.FovPunch(amount: number)
	fovOffset = math.max(fovOffset, amount)
end

local function startCameraEffects()
	local baseFov = camera.FieldOfView
	RunService:BindToRenderStep("CapyCameraFx", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if shakeIntensity > 0 then
			local i = shakeIntensity
			camera.CFrame *= CFrame.new(rng:NextNumber(-i, i) * 0.3, rng:NextNumber(-i, i) * 0.3, 0) * CFrame.Angles(
				0,
				0,
				math.rad(rng:NextNumber(-i, i) * 1.5)
			)
			shakeIntensity = math.max(0, shakeIntensity - shakeDecay * dt)
		end
		fovOffset = math.max(0, fovOffset - dt * 40)
		camera.FieldOfView = baseFov + fovOffset
	end)
end

-- Screen overlays -------------------------------------------------------------

function EffectsController.Flash(color: Color3, alpha: number?, duration: number?)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - (alpha or 0.5)
	TweenService:Create(flashFrame, TweenInfo.new(duration or 0.4), { BackgroundTransparency = 1 }):Play()
end

-- Giant slammed-in text in the middle of the screen.
function EffectsController.BigText(text: string, color: Color3?, duration: number?, yPosition: number?)
	local label = Components.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, yPosition or 0.32),
		Size = UDim2.fromOffset(900, 90),
		Text = text,
		TextSize = 64,
		TextColor3 = color or Theme.Accent,
		Outline = 4,
		Rotation = rng:NextNumber(-4, 4),
		Parent = Components.Overlay(),
	})
	local scale = Make.Instance("UIScale", { Scale = 2.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(duration or 1.6, function()
		TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		TweenService:Create(scale, TweenInfo.new(0.3), { Scale = 0.6 }):Play()
		Debris:AddItem(label, 0.35)
	end)
end

-- A random meme word flying out from a random spot (delivery dopamine).
function EffectsController.BrainrotWord(color: Color3?)
	local label = Components.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(rng:NextNumber(0.25, 0.75), rng:NextNumber(0.25, 0.6)),
		Size = UDim2.fromOffset(400, 60),
		Text = BRAINROT_WORDS[rng:NextInteger(1, #BRAINROT_WORDS)] .. "!",
		TextSize = 46,
		TextColor3 = color or Color3.fromHSV(rng:NextNumber(), 0.7, 1),
		Outline = 3,
		Rotation = rng:NextNumber(-18, 18),
		Parent = Components.Overlay(),
	})
	local scale = Make.Instance("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1.1 }):Play()
	TweenService:Create(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad), {
		Position = label.Position - UDim2.fromScale(0, 0.08),
		Rotation = label.Rotation + rng:NextNumber(-10, 10),
	}):Play()
	task.delay(0.6, function()
		TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
	end)
	Debris:AddItem(label, 1)
end

-- Floating text at a world position ("+3 🥪", "+$1.2K").
function EffectsController.WorldPopup(position: Vector3, text: string, color: Color3?, size: number?)
	local anchor = Make.Part({
		Name = "Popup",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Position = position,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = workspace,
	})
	local gui, label = Make.Billboard(anchor, Vector2.new(8, 2.2) * (size or 1), Vector3.new(0, 1, 0), text, {
		TextColor3 = color or Theme.Accent,
	})
	gui.AlwaysOnTop = true
	TweenService:Create(gui, TweenInfo.new(1, Enum.EasingStyle.Quad), { StudsOffset = Vector3.new(0, 6, 0) }):Play()
	task.delay(0.6, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	Debris:AddItem(anchor, 1.1)
end

-- Particle burst at a world position.
function EffectsController.Burst(position: Vector3, color: Color3, count: number?)
	local anchor = Make.Part({
		Size = Vector3.new(0.2, 0.2, 0.2),
		Position = position,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = workspace,
	})
	local emitter = Make.Instance("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(color),
		LightEmission = 0.8,
		Rate = 0,
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(15, 35),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }),
		Parent = anchor,
	})
	emitter:Emit(count or 25)
	Debris:AddItem(anchor, 1.5)
end

-- Chase vignette ---------------------------------------------------------------

local function buildVignette()
	local overlay = Components.Overlay()
	local edges = {
		{ Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 0.22), Rotation = 90 },
		{ Position = UDim2.fromScale(0, 0.78), Size = UDim2.fromScale(1, 0.22), Rotation = -90 },
		{ Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(0.18, 1), Rotation = 0 },
		{ Position = UDim2.fromScale(0.82, 0), Size = UDim2.fromScale(0.18, 1), Rotation = 180 },
	}
	for _, edge in edges do
		local frame = Make.Instance("Frame", {
			Position = edge.Position,
			Size = edge.Size,
			BackgroundColor3 = Color3.fromRGB(255, 0, 30),
			BorderSizePixel = 0,
			Visible = false,
			Parent = overlay,
		}, {
			Make.Instance("UIGradient", {
				Rotation = edge.Rotation,
				Transparency = NumberSequence.new(0.25, 1),
			}),
		})
		table.insert(vignette, frame)
	end
	local chaseText = Components.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.82),
		Size = UDim2.fromOffset(600, 40),
		Text = "",
		TextSize = 32,
		TextColor3 = Color3.fromRGB(255, 80, 80),
		Visible = false,
		Parent = overlay,
	})
	RunService.RenderStepped:Connect(function()
		local chasedBy = player:GetAttribute("ChasedBy")
		local visible = chasedBy ~= nil
		local pulse = 0.25 + math.abs(math.sin(os.clock() * 6)) * 0.35
		for _, frame in vignette do
			frame.Visible = visible
			frame.BackgroundTransparency = 1 - pulse
		end
		chaseText.Visible = visible
		if visible then
			chaseText.Text = "🦆 " .. string.upper(chasedBy) .. " IS CHASING YOU! RUN TO THE HUB!"
		end
	end)
end

-- Kill feed + announcements -------------------------------------------------------

local feedCounter = 0

function EffectsController.KillFeed(text: string)
	feedCounter += 1
	local entry = Make.Instance("Frame", {
		LayoutOrder = feedCounter,
		Size = UDim2.fromOffset(340, 34),
		BackgroundColor3 = Color3.fromRGB(30, 15, 25),
		BackgroundTransparency = 0.25,
		Parent = killFeed,
	}, { Components.Corner(8) })
	Components.Label({
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		Text = text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = entry,
	})
	task.delay(6, function()
		entry:Destroy()
	end)
	local frames = {}
	for _, child in killFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames > 5 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
end

function EffectsController.Banner(text: string, color: Color3, duration: number?)
	local banner = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(820, 64),
		BackgroundColor3 = color,
		Parent = bannerHolder,
	}, { Components.Corner(16), Components.Stroke(4) })
	Components.Label({
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Text = text,
		Scaled = true,
		Outline = 3,
		Parent = banner,
	})
	local scale = Make.Instance("UIScale", { Scale = 0, Parent = banner })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(duration or 4, function()
		TweenService:Create(scale, TweenInfo.new(0.25), { Scale = 0 }):Play()
		Debris:AddItem(banner, 0.3)
	end)
end

-- Server effect events ----------------------------------------------------------

local handlers: { [string]: (any) -> () } = {}

handlers.Pickup = function(payload)
	local food = FoodConfig[payload.FoodId]
	SoundController.Play("Pickup", 0.04)
	EffectsController.WorldPopup(
		payload.Position,
		"+" .. payload.Count .. " " .. food.Emoji,
		if food.Golden then Theme.Accent else Theme.Text
	)
	if food.Golden then
		EffectsController.Burst(payload.Position, food.Color, 30)
		EffectsController.Shake(0.4, 0.2)
	end
	if payload.Full then
		SoundController.Play("CarryFull", 0.5)
		EffectsController.BigText("🎒 BACKPACK FULL! FEED THE CAPY!", Theme.Accent, 1.2, 0.7)
	end
end

handlers.MachineClick = function(payload)
	if payload.Count <= 0 then
		if payload.Full then
			SoundController.Play("CarryFull", 0.5)
			EffectsController.BigText("🎒 BACKPACK FULL!", Theme.Accent, 0.8, 0.7)
		end
		return
	end
	local food = FoodConfig[payload.FoodId]
	SoundController.Play("MachineClick", 0.03)
	EffectsController.WorldPopup(
		payload.Position + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)),
		"+" .. payload.Count .. " " .. food.Emoji
	)
	EffectsController.Shake(0.15, 0.1)
	if payload.Full then
		SoundController.Play("CarryFull", 0.5)
		EffectsController.BigText("🎒 BACKPACK FULL! FEED THE CAPY!", Theme.Accent, 1.2, 0.7)
	end
end

handlers.Deliver = function(payload)
	SoundController.Play("Deliver")
	EffectsController.WorldPopup(
		payload.Position + Vector3.new(0, 6, 0),
		"+" .. Format.Cash(payload.Cash),
		Theme.Good,
		2
	)
	EffectsController.Burst(payload.Position, Color3.fromRGB(255, 200, 90), math.clamp(payload.Count * 3, 15, 60))
	EffectsController.Shake(math.clamp(payload.Count / 15, 0.3, 1.2), 0.35)
	EffectsController.FovPunch(math.clamp(payload.Count / 2, 3, 12))
	for _ = 1, math.clamp(math.floor(payload.Count / 8) + 1, 1, 4) do
		EffectsController.BrainrotWord()
	end
end

handlers.DuckSpotted = function(payload)
	SoundController.Play("DuckSpotted")
	EffectsController.Shake(0.8, 0.5)
	EffectsController.Flash(Color3.fromRGB(255, 0, 0), 0.35, 0.5)
	EffectsController.BigText("🦆❗ " .. string.upper(payload.Duck) .. " SPOTTED YOU! RUN!!", Theme.Bad, 1.4)
end

handlers.DuckLost = function(payload)
	SoundController.Play("DuckLost")
	EffectsController.BigText("😅 You escaped " .. payload.Duck .. "!", Theme.Good, 1.2, 0.7)
end

handlers.Caught = function(payload)
	SoundController.Play("Caught")
	EffectsController.Shake(2, 0.9)
	EffectsController.FovPunch(25)
	EffectsController.Flash(Color3.fromRGB(255, 30, 30), 0.65, 0.8)
	EffectsController.BigText("💀 BONKED BY " .. string.upper(payload.Duck) .. " 💀", Theme.Bad, 2.2)
	task.delay(0.4, function()
		EffectsController.BigText("your snacks went flying 😭", Theme.SubText, 1.6, 0.42)
	end)
end

handlers.Bonk = function(payload)
	EffectsController.KillFeed(string.format("💀 %s got bonked by %s", payload.Player, payload.Duck))
	if payload.UserId ~= player.UserId then
		EffectsController.Burst(payload.Position, Color3.fromRGB(255, 220, 60), 20)
	end
end

handlers.EventStart = function(payload)
	local event = EventConfig.Events[payload.Id]
	SoundController.Play("EventStart")
	EffectsController.Shake(0.7, 0.6)
	EffectsController.Flash(event.Color, 0.45, 0.8)
	EffectsController.Banner(event.Emoji .. " " .. event.Name .. " " .. event.Emoji, event.Color, 4)
	EffectsController.BigText(event.Description, Theme.Text, 3, 0.4)
end

handlers.EventEnd = function(payload)
	local event = EventConfig.Events[payload.Id]
	SoundController.Play("Notify")
	EffectsController.KillFeed(event.Emoji .. " " .. event.Name .. " is over")
end

handlers.ZoneUnlocked = function(payload)
	local zone = ZoneConfig.ById[payload.ZoneId]
	SoundController.Play("Purchase")
	SoundController.Play("EventStart")
	EffectsController.Flash(zone.FloorColor, 0.5, 0.6)
	EffectsController.Shake(0.8, 0.5)
	EffectsController.BigText("🔓 " .. string.upper(zone.Name) .. " UNLOCKED!", zone.FloorColor, 2)
end

-- Rebirth reveals are handled by HatchController (it owns the reveal overlay).
local externalHandlers: { [string]: (any) -> () } = {}

function EffectsController.On(effectName: string, handler: (any) -> ())
	externalHandlers[effectName] = handler
end

function EffectsController.Start()
	local overlay = Components.Overlay()
	flashFrame = Make.Instance("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = overlay,
	})
	killFeed = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0.36, 0),
		Size = UDim2.fromOffset(340, 230),
		BackgroundTransparency = 1,
		Parent = Components.Screen(),
	}, {
		Make.Instance("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	bannerHolder = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.fromOffset(820, 220),
		BackgroundTransparency = 1,
		Parent = overlay,
	}, {
		Make.Instance("UIListLayout", {
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	buildVignette()
	startCameraEffects()

	Net.Event("Effect").OnClientEvent:Connect(function(effectName, payload)
		local handler = handlers[effectName] or externalHandlers[effectName]
		if handler then
			handler(payload)
		end
	end)
	Net.Event("Announce").OnClientEvent:Connect(function(text, color)
		SoundController.Play("HatchRare")
		EffectsController.Banner("📢 " .. text, color, 5)
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[-- The always-on HUD: cash, multiplier, carry bar, menu buttons (with PC
-- keybind hints), active events, the Capy Feast meter, current zone, boost
-- timers and toast notifications.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EventConfig = require(Shared.Config.EventConfig)
local RewardConfig = require(Shared.Config.RewardConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local MapLayout = require(Shared.MapLayout)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local ClientData = require(script.Parent.Parent.ClientData)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local SoundController = require(script.Parent.SoundController)

local HUDController = {}

local player = Players.LocalPlayer

-- Menu buttons, in order. Keys are bound in InputController.
HUDController.Menu = {
	{ Window = "Shop", Emoji = "🛒", Label = "Shop", Key = Enum.KeyCode.B, Color = Color3.fromRGB(70, 180, 255) },
	{ Window = "Pets", Emoji = "🐾", Label = "Pets", Key = Enum.KeyCode.P, Color = Color3.fromRGB(120, 220, 120) },
	{
		Window = "Rebirth",
		Emoji = "🔁",
		Label = "Rebirth",
		Key = Enum.KeyCode.R,
		Color = Color3.fromRGB(255, 90, 160),
	},
	{
		Window = "Titles",
		Emoji = "🏷️",
		Label = "Titles",
		Key = Enum.KeyCode.T,
		Color = Color3.fromRGB(180, 120, 255),
	},
	{
		Window = "Rewards",
		Emoji = "🎁",
		Label = "Rewards",
		Key = Enum.KeyCode.G,
		Color = Color3.fromRGB(255, 190, 60),
	},
}

local cashLabel: TextLabel
local cashPanel: Frame
local multiplierLabel: TextLabel
local setCarry: (number) -> ()
local carryLabel: TextLabel
local carryFill: Frame
local zoneLabel: TextLabel
local boostsLabel: TextLabel
local eventsLabel: TextLabel
local setFeast: (number) -> ()
local feastLabel: TextLabel
local toastHolder: Frame
local rewardBadge: Frame
local displayedCash = 0
local toastCounter = 0

function HUDController.Toast(text: string, kind: string?)
	if text == "" then
		return
	end
	local color = if kind == "Good" then Theme.Good elseif kind == "Bad" then Theme.Bad else Theme.Info
	if kind == "Bad" then
		SoundController.Play("UIError", 0.2)
	else
		SoundController.Play("Notify", 0.1)
	end
	toastCounter += 1
	local toast = Make.Instance("Frame", {
		LayoutOrder = toastCounter,
		Size = UDim2.fromOffset(380, 46),
		BackgroundColor3 = Theme.Background,
		Parent = toastHolder,
	}, { Components.Corner(12), Components.Stroke(3, color) })
	Components.Label({
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		Text = text,
		TextSize = 20,
		TextWrapped = true,
		TextColor3 = color,
		Parent = toast,
	})
	local scale = Make.Instance("UIScale", { Scale = 0.5, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(3.5, function()
		toast:Destroy()
	end)
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

-- Unix time synced with the server (the local clock can be wrong).
function HUDController.Now(): number
	return math.floor(workspace:GetServerTimeNow())
end

-- Whether anything on the Rewards window can be claimed right now.
function HUDController.RewardsClaimable(): boolean
	local data = ClientData.Data
	if not data then
		return false
	end
	if Formulas.DailyStatus(data, HUDController.Now()) then
		return true
	end
	local start = player:GetAttribute("SessionStart")
	if start then
		local elapsed = workspace:GetServerTimeNow() - start
		for index, gift in RewardConfig.Playtime do
			if not player:GetAttribute("GiftClaimed_" .. index) and elapsed >= gift.Minutes * 60 then
				return true
			end
		end
	end
	return false
end

-- Bottom-left, so it never sits under Roblox's chat window (top-left).
local function buildStats(screen: ScreenGui)
	local holder = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(320, 200),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Make.Instance("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	cashPanel = Make.Instance("Frame", {
		Size = UDim2.fromOffset(320, 64),
		BackgroundColor3 = Theme.Background,
		LayoutOrder = 1,
		Parent = holder,
	}, { Components.Corner(16), Components.Stroke(4) })
	Make.Instance("UIScale", { Parent = cashPanel })
	Components.Label({ Size = UDim2.fromOffset(60, 64), Text = "💵", TextSize = 38, Parent = cashPanel })
	cashLabel = Components.Label({
		Position = UDim2.fromOffset(60, 0),
		Size = UDim2.new(1, -70, 1, 0),
		Text = "$0",
		TextSize = 40,
		TextColor3 = Theme.Good,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = cashPanel,
	})

	multiplierLabel = Components.Label({
		Size = UDim2.fromOffset(320, 26),
		Text = "",
		TextSize = 20,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
		Parent = holder,
	})

	local bar, set, label = Components.ProgressBar({
		Size = UDim2.fromOffset(320, 38),
		Color = Theme.Accent,
		TextSize = 22,
		LayoutOrder = 3,
		Parent = holder,
	})
	setCarry = set
	carryLabel = label
	carryFill = bar:FindFirstChild("Fill") :: Frame

	if ClientData.Offline then
		Components.Label({
			Size = UDim2.fromOffset(320, 22),
			Text = "⚠ Studio test mode: progress is not saved",
			TextSize = 16,
			TextColor3 = Theme.Bad,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 4,
			Parent = holder,
		})
	end
end

local function buildMenu(screen: ScreenGui)
	local holder = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(76, 400),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { Make.Instance("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })

	for index, item in HUDController.Menu do
		local button = Components.Button({
			Text = "",
			Color = item.Color,
			Size = UDim2.fromOffset(72, 72),
			LayoutOrder = index,
			Parent = holder,
			OnClick = function()
				Components.ToggleWindow(item.Window)
			end,
		})
		Components.Label({
			Size = UDim2.new(1, 0, 0, 44),
			Position = UDim2.fromOffset(0, 3),
			Text = item.Emoji,
			TextSize = 34,
			Outline = false,
			Parent = button,
		})
		Components.Label({
			Size = UDim2.new(1, -4, 0, 20),
			Position = UDim2.new(0, 2, 1, -23),
			Text = item.Label .. " [" .. item.Key.Name .. "]",
			TextSize = 13,
			Parent = button,
		})
		if item.Window == "Rewards" then
			rewardBadge = Make.Instance("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -4, 0, 4),
				Size = UDim2.fromOffset(26, 26),
				BackgroundColor3 = Theme.Bad,
				Visible = false,
				Parent = button,
			}, { Components.Corner(13), Components.Stroke(2) })
			Components.Label({ Size = UDim2.fromScale(1, 1), Text = "!", TextSize = 20, Parent = rewardBadge })
		end
	end
end

local function buildTopCenter(screen: ScreenGui)
	local holder = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(460, 110),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Make.Instance("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local _, set, label = Components.ProgressBar({
		Size = UDim2.fromOffset(420, 30),
		Color = Color3.fromRGB(255, 150, 40),
		TextSize = 18,
		LayoutOrder = 1,
		Parent = holder,
	})
	setFeast = set
	feastLabel = label
	eventsLabel = Components.Label({
		Size = UDim2.fromOffset(460, 60),
		Text = "",
		TextSize = 22,
		TextWrapped = true,
		LayoutOrder = 2,
		Parent = holder,
	})
end

local function buildBottom(screen: ScreenGui)
	zoneLabel = Components.Label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -46),
		Size = UDim2.fromOffset(600, 40),
		Text = "",
		TextSize = 32,
		Parent = screen,
	})
	boostsLabel = Components.Label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(600, 28),
		Text = "",
		TextSize = 20,
		TextColor3 = Theme.Accent,
		Parent = screen,
	})
	toastHolder = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(380, 260),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Make.Instance("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function refreshMultiplier()
	local data = ClientData.Data
	local multiplier = Formulas.CashMultiplier(data, HUDController.Now())
	local text = Format.Multiplier(multiplier) .. " cash"
	if data.Rebirths > 0 then
		text ..= "  ·  🔁 " .. data.Rebirths
	end
	multiplierLabel.Text = text
end

local function refreshCarry()
	local carry = player:GetAttribute("Carry") or 0
	local capacity = player:GetAttribute("CarryCapacity") or Formulas.CarryCapacity(ClientData.Data)
	setCarry(carry / math.max(capacity, 1))
	if carry >= capacity then
		carryLabel.Text = "🎒 FULL! " .. carry .. "/" .. capacity .. " · feed the capy!"
		carryFill.BackgroundColor3 = Theme.Bad
	else
		carryLabel.Text = "🎒 " .. carry .. " / " .. capacity
		carryFill.BackgroundColor3 = Theme.Accent
	end
end

local function pulseCash()
	local scale = cashPanel:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 1.12
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

-- Things that tick: cash count-up, timers, zone label.
local function startTicking()
	local gameState = ReplicatedStorage:WaitForChild("GameState")
	RunService.RenderStepped:Connect(function(dt)
		local target = ClientData.Data.Cash
		if math.abs(target - displayedCash) < 1 then
			displayedCash = target
		else
			displayedCash += (target - displayedCash) * math.min(1, dt * 10)
		end
		cashLabel.Text = Format.Cash(displayedCash)
	end)

	task.spawn(function()
		while true do
			local now = workspace:GetServerTimeNow()
			-- Active events
			local lines = {}
			for eventId, event in EventConfig.Events do
				local endsAt = gameState:GetAttribute("Event_" .. eventId) or 0
				if endsAt > now then
					table.insert(
						lines,
						Make.Colored(
							string.format("%s %s %s", event.Emoji, event.Name, Format.Time(endsAt - now)),
							event.Color
						)
					)
				end
			end
			eventsLabel.Text = table.concat(lines, "\n")

			-- Feast meter
			local fullness = gameState:GetAttribute("CapyFullness") or 0
			local fullnessMax = gameState:GetAttribute("CapyFullnessMax") or 1
			local feastEnds = gameState:GetAttribute("Event_CapyFeast") or 0
			if feastEnds > now then
				setFeast(1)
				feastLabel.Text = "🎉 CAPY FEAST · 2x CASH · " .. Format.Time(feastEnds - now)
			else
				setFeast(fullness / math.max(fullnessMax, 1))
				feastLabel.Text = string.format("🦫 Feast meter %d / %d", fullness, fullnessMax)
			end

			-- Boost timers
			local data = ClientData.Data
			local unix = HUDController.Now()
			local boosts = {}
			if Formulas.IsBoostActive(data, "Cash", unix) then
				table.insert(boosts, "💸 2x Cash " .. Format.Time(data.Boosts.Cash - unix))
			end
			if Formulas.IsBoostActive(data, "Luck", unix) then
				table.insert(boosts, "🍀 2x Luck " .. Format.Time(data.Boosts.Luck - unix))
			end
			boostsLabel.Text = table.concat(boosts, "    ")
			refreshMultiplier()

			rewardBadge.Visible = HUDController.RewardsClaimable()
			task.wait(0.5)
		end
	end)

	task.spawn(function()
		while true do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local zoneId = MapLayout.ZoneAt((root :: BasePart).Position)
				if zoneId then
					local zone = ZoneConfig.ById[zoneId]
					zoneLabel.Text = zone.Emoji .. " " .. zone.Name .. "  ·  🦆 DANGER"
					zoneLabel.TextColor3 = zone.FloorColor
				elseif MapLayout.IsInHub((root :: BasePart).Position) then
					zoneLabel.Text = "🏠 Capy Hub  ·  SAFE"
					zoneLabel.TextColor3 = Theme.Good
				end
			end
			task.wait(0.25)
		end
	end)
end

function HUDController.Start()
	local screen = Components.Screen()
	buildStats(screen)
	buildMenu(screen)
	buildTopCenter(screen)
	buildBottom(screen)

	ClientData.Observe({ "Upgrades", "Rebirths", "EquippedPets", "Pets", "Boosts" }, refreshMultiplier)
	displayedCash = ClientData.Data.Cash
	ClientData.Changed:Connect(function(key, value)
		if key == "Cash" and value > displayedCash then
			pulseCash()
		end
	end)
	refreshCarry()
	player:GetAttributeChangedSignal("Carry"):Connect(refreshCarry)
	player:GetAttributeChangedSignal("CarryCapacity"):Connect(refreshCarry)

	Net.Event("Notify").OnClientEvent:Connect(HUDController.Toast)
	startTicking()
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">HatchController</string>
              <string name="Source"><![CDATA[-- Full-screen reveals: egg hatches (shake, flash, pet pops out) and the
-- rebirth title roulette. Reveals queue up so fast hatches don't overlap.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetConfig = require(Shared.Config.PetConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local EffectsController = require(script.Parent.EffectsController)
local SoundController = require(script.Parent.SoundController)

local HatchController = {}

local queue: { () -> () } = {}
local running = false
local overlay: Frame
local rays: Frame
local bigLabel: TextLabel
local titleLabel: TextLabel
local subLabel: TextLabel
local skip = false

local function runQueue()
	if running then
		return
	end
	running = true
	while #queue > 0 do
		local reveal = table.remove(queue, 1)
		skip = false
		reveal()
	end
	running = false
end

local function enqueue(reveal: () -> ())
	table.insert(queue, reveal)
	task.spawn(runQueue)
end

-- Waits up to `seconds`, returning early if the player clicks to skip.
local function waitOrSkip(seconds: number)
	local deadline = os.clock() + seconds
	while os.clock() < deadline and not skip do
		task.wait()
	end
end

local function show()
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.2), { BackgroundTransparency = 0.35 }):Play()
	bigLabel.Rotation = 0
	titleLabel.Text = ""
	subLabel.Text = ""
	rays.Visible = false
end

local function hide()
	TweenService:Create(overlay, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
	task.wait(0.2)
	overlay.Visible = false
end

local function popIn(label: GuiObject)
	local scale = label:FindFirstChildOfClass("UIScale") or Make.Instance("UIScale", { Parent = label })
	scale.Scale = 0
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local function hatchReveal(eggId: string, petId: string)
	local egg = PetConfig.EggsById[eggId]
	local pet = PetConfig.Pets[petId]
	local rarity = RarityConfig[pet.Rarity]
	local isBig = rarity.Order >= RarityConfig.Legendary.Order

	show()
	bigLabel.Text = egg.Emoji
	bigLabel.TextColor3 = egg.Color
	subLabel.Text = egg.Name
	popIn(bigLabel)

	-- Shake the egg harder and faster before it cracks.
	local shakes = if isBig then 9 else 6
	for index = 1, shakes do
		if skip then
			break
		end
		SoundController.Play("EggShake")
		local angle = (if index % 2 == 0 then 1 else -1) * (8 + index * 3)
		TweenService:Create(bigLabel, TweenInfo.new(0.09), { Rotation = angle }):Play()
		task.wait(math.max(0.07, 0.2 - index * 0.015))
	end
	bigLabel.Rotation = 0

	EffectsController.Flash(Color3.new(1, 1, 1), 0.9, 0.5)
	SoundController.Play(if isBig then "HatchRare" else "Hatch")
	EffectsController.Shake(if isBig then 1.5 else 0.5, 0.5)
	bigLabel.Text = pet.Emoji
	bigLabel.TextColor3 = Color3.new(1, 1, 1)
	popIn(bigLabel)
	rays.Visible = true
	rays.BackgroundColor3 = rarity.Color
	titleLabel.Text = pet.Name
	titleLabel.TextColor3 = rarity.Color
	popIn(titleLabel)
	subLabel.Text = Make.Colored(rarity.Name, rarity.Color) .. "  ·  " .. Format.Multiplier(pet.Multiplier) .. " cash"
	if isBig then
		EffectsController.BigText("🚨 " .. rarity.Name .. " PULL 🚨", rarity.Color, 2.5, 0.15)
	end
	waitOrSkip(if isBig then 3.2 else 2.2)
	hide()
end

local function rebirthReveal(payload: any)
	local title = RebirthConfig.TitlesById[payload.TitleId]
	local rarity = RarityConfig[title.Rarity]
	local isBig = rarity.Order >= RarityConfig.Legendary.Order

	show()
	SoundController.Play("Rebirth")
	EffectsController.Flash(Theme.Pink, 0.8, 0.8)
	EffectsController.Shake(1.6, 0.8)
	bigLabel.Text = "🔁"
	bigLabel.TextColor3 = Theme.Pink
	popIn(bigLabel)
	titleLabel.Text = "REBIRTH #" .. payload.Rebirths
	titleLabel.TextColor3 = Theme.Accent
	popIn(titleLabel)
	subLabel.Text = "Now earning " .. Make.Colored(Format.Multiplier(payload.Multiplier) .. " cash", Theme.Good)
	waitOrSkip(1.6)

	-- Title roulette: spin through random titles, slowing down, then land.
	local titles = RebirthConfig.Titles
	local delay = 0.04
	while delay < 0.32 and not skip do
		local random = titles[math.random(1, #titles)]
		titleLabel.Text = random.Text
		titleLabel.TextColor3 = RarityConfig[random.Rarity].Color
		SoundController.Play("EggShake")
		task.wait(delay)
		delay *= 1.18
	end
	SoundController.Play(if isBig then "HatchRare" else "Hatch")
	EffectsController.Flash(rarity.Color, 0.7, 0.5)
	rays.Visible = true
	rays.BackgroundColor3 = rarity.Color
	titleLabel.Text = title.Text
	titleLabel.TextColor3 = rarity.Color
	popIn(titleLabel)
	subLabel.Text = Make.Colored(rarity.Name .. " title", rarity.Color)
		.. (if payload.New then "  ·  NEW!" else "  ·  (duplicate)")
	waitOrSkip(if isBig then 3 else 2.2)
	hide()
end

function HatchController.Start()
	overlay = Make.Instance("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = Components.Overlay(),
	})
	rays = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(520, 520),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.2,
		Visible = false,
		ZIndex = 20,
		Parent = overlay,
	}, {
		Components.Corner(260),
		Make.Instance("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.1),
				NumberSequenceKeypoint.new(0.5, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	task.spawn(function()
		while true do
			if rays.Visible then
				rays.Rotation = (rays.Rotation + 2) % 360
			end
			task.wait(1 / 30)
		end
	end)
	bigLabel = Components.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(300, 260),
		Text = "",
		TextSize = 200,
		Outline = false,
		ZIndex = 21,
		Parent = overlay,
	})
	titleLabel = Components.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.64),
		Size = UDim2.fromOffset(900, 70),
		Text = "",
		TextSize = 58,
		Outline = 4,
		ZIndex = 21,
		Parent = overlay,
	})
	subLabel = Components.Label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.73),
		Size = UDim2.fromOffset(900, 40),
		Text = "",
		TextSize = 30,
		ZIndex = 21,
		Parent = overlay,
	})
	Components.Label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(600, 30),
		Text = "click to skip",
		TextSize = 20,
		TextColor3 = Theme.SubText,
		ZIndex = 21,
		Parent = overlay,
	})

	UserInputService.InputBegan:Connect(function(input)
		if overlay.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
			skip = true
		end
	end)

	Net.Event("HatchResult").OnClientEvent:Connect(function(eggId, petId)
		enqueue(function()
			hatchReveal(eggId, petId)
		end)
	end)
	EffectsController.On("Rebirth", function(payload)
		enqueue(function()
			rebirthReveal(payload)
		end)
	end)
end

return HatchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[-- PC keybinds for the menu windows (see HUDController.Menu).

local UserInputService = game:GetService("UserInputService")

local Components = require(script.Parent.Parent.UI.Components)
local HUDController = require(script.Parent.HUDController)

local InputController = {}

function InputController.Start()
	local bindings = {}
	for _, item in HUDController.Menu do
		bindings[item.Key] = item.Window
	end
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or UserInputService:GetFocusedTextBox() then
			return
		end
		local window = bindings[input.KeyCode]
		if window then
			Components.ToggleWindow(window)
		end
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">PetFollowController</string>
              <string name="Source"><![CDATA[-- Draws every player's equipped pets locally and makes them bob along
-- behind their owner. Reads each player's "EquippedPets" attribute.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetConfig = require(Shared.Config.PetConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local Make = require(Shared.Util.Make)

local PetFollowController = {}

type PetVisual = { Part: BasePart, Size: number }

local visuals: { [Player]: { PetVisual } } = {}
local folder: Folder

-- Slots behind the owner (right, left, back).
local SLOTS = {
	Vector3.new(4, 0, 4),
	Vector3.new(-4, 0, 4),
	Vector3.new(0, 0, 7),
	Vector3.new(6, 0, 8),
	Vector3.new(-6, 0, 8),
}

local function buildPet(petId: string): PetVisual?
	local pet = PetConfig.Pets[petId]
	if not pet then
		return nil
	end
	local rarity = RarityConfig[pet.Rarity]
	-- The pet is its emoji floating on an invisible anchor, lit in its color.
	local body = Make.Part({
		Name = pet.Id,
		Size = Vector3.one * pet.Size,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Parent = folder,
	})
	Make.Billboard(body, Vector2.new(pet.Size * 1.5, pet.Size * 1.5), Vector3.new(0, 0, 0), pet.Emoji, {
		TextStrokeTransparency = 1,
	}).MaxDistance =
		100
	Make.Instance("PointLight", { Color = pet.Color, Range = 6, Brightness = 1, Parent = body })
	if rarity.Order >= RarityConfig.Legendary.Order then
		Make.Instance("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Color = ColorSequence.new(rarity.Color),
			LightEmission = 1,
			Rate = 8,
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(0.5, 2),
			Size = NumberSequence.new(0.4, 0),
			Parent = body,
		})
	end
	return { Part = body, Size = pet.Size }
end

local function clear(player: Player)
	local list = visuals[player]
	if list then
		for _, visual in list do
			visual.Part:Destroy()
		end
	end
	visuals[player] = nil
end

local function rebuild(player: Player)
	clear(player)
	local list = {}
	local attribute = player:GetAttribute("EquippedPets")
	if type(attribute) == "string" and attribute ~= "" then
		for petId in string.gmatch(attribute, "[^,]+") do
			local visual = buildPet(petId)
			if visual then
				table.insert(list, visual)
			end
		end
	end
	visuals[player] = list
end

local function onPlayer(player: Player)
	player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
	player.CharacterAdded:Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

function PetFollowController.Start()
	folder = Make.Instance("Folder", { Name = "LocalPets", Parent = workspace })
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(clear)

	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		local alpha = math.min(1, dt * 8)
		for player, list in visuals do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end
			local base = root.CFrame
			for index, visual in list do
				local slot = SLOTS[index] or SLOTS[#SLOTS]
				local bob = math.sin(t * 3 + index) * 0.6
				local target = base * CFrame.new(slot + Vector3.new(0, bob - 1 + visual.Size / 2, 0))
				local current = visual.Part.CFrame
				local position = current.Position:Lerp(target.Position, alpha)
				local look = base.LookVector
				visual.Part.CFrame = CFrame.lookAt(position, position + look)
			end
		end
	end)
end

return PetFollowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">PetsWindow</string>
              <string name="Source"><![CDATA[-- Pets window [P]: inventory grid, equip / unequip / delete, Equip Best.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local PetConfig = require(Shared.Config.PetConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local ClientData = require(script.Parent.Parent.ClientData)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local HUDController = require(script.Parent.HUDController)
local SoundController = require(script.Parent.SoundController)

local PetsWindow = {}

local selectedUid: string? = nil
local deleteArmedUntil = 0

local function invoke(remote: string, ...: any): boolean
	local ok, message = Net.Invoke(remote, ...)
	if not ok then
		SoundController.Play("UIError")
	end
	if message then
		HUDController.Toast(message, if ok then "Good" else "Bad")
	end
	return ok
end

function PetsWindow.Start()
	local window = Components.Window("Pets", "🐾 PETS", Vector2.new(780, 580), Color3.fromRGB(90, 200, 110))
	local body = window.Body

	local summary = Components.Label({
		Size = UDim2.new(1, -200, 0, 46),
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = body,
	})
	Components.Button({
		Text = "⭐ Equip Best",
		Color = Theme.Accent,
		Size = UDim2.fromOffset(190, 46),
		Position = UDim2.new(1, -190, 0, 0),
		Parent = body,
		OnClick = function()
			invoke("EquipBest")
		end,
	})

	local grid = Components.ScrollList({
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56 - 96),
		Grid = UDim2.fromOffset(110, 124),
		Parent = body,
	})
	local emptyLabel = Components.Label({
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56 - 96),
		Text = "No pets yet!\nHatch eggs at the 🥚 Egg Stands in the hub (walk up + press E).",
		TextSize = 26,
		TextWrapped = true,
		TextColor3 = Theme.SubText,
		Visible = false,
		Parent = body,
	})

	-- Details bar for the selected pet.
	local details = Make.Instance("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 86),
		BackgroundColor3 = Theme.Panel,
		Parent = body,
	}, { Components.Corner(14), Components.Stroke(2) })
	local detailsLabel = Components.Label({
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -380, 1, 0),
		Text = "",
		TextSize = 22,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = details,
	})
	local equipButton = Components.Button({
		Text = "Equip",
		Size = UDim2.fromOffset(170, 56),
		Position = UDim2.new(1, -360, 0.5, -28),
		Parent = details,
		OnClick = function()
			local data = ClientData.Data
			if not selectedUid or not data.Pets[selectedUid] then
				return
			end
			if table.find(data.EquippedPets, selectedUid) then
				invoke("UnequipPet", selectedUid)
			else
				invoke("EquipPet", selectedUid)
			end
		end,
	})
	local deleteButton
	deleteButton = Components.Button({
		Text = "🗑️ Delete",
		Color = Theme.Bad,
		Size = UDim2.fromOffset(170, 56),
		Position = UDim2.new(1, -180, 0.5, -28),
		Parent = details,
		OnClick = function()
			if not selectedUid then
				return
			end
			if os.clock() > deleteArmedUntil then
				deleteArmedUntil = os.clock() + 2.5
				Components.SetButton(deleteButton, "Sure? Click again")
				task.delay(2.5, function()
					if os.clock() >= deleteArmedUntil then
						Components.SetButton(deleteButton, "🗑️ Delete")
					end
				end)
				return
			end
			deleteArmedUntil = 0
			Components.SetButton(deleteButton, "🗑️ Delete")
			if invoke("DeletePet", selectedUid) then
				selectedUid = nil
			end
		end,
	})

	local cells: { Instance } = {}

	local function refresh()
		local data = ClientData.Data
		for _, cell in cells do
			cell:Destroy()
		end
		table.clear(cells)

		local owned = {}
		for uid, petId in data.Pets do
			local pet = PetConfig.Pets[petId]
			if pet then
				table.insert(owned, { Uid = uid, Pet = pet, Equipped = table.find(data.EquippedPets, uid) ~= nil })
			end
		end
		table.sort(owned, function(a, b)
			if a.Equipped ~= b.Equipped then
				return a.Equipped
			end
			if a.Pet.Multiplier ~= b.Pet.Multiplier then
				return a.Pet.Multiplier > b.Pet.Multiplier
			end
			return a.Uid < b.Uid
		end)

		summary.Text = string.format(
			"%d/%d pets · %d/%d equipped · pet boost %s",
			#owned,
			GameConfig.MaxPetInventory,
			#data.EquippedPets,
			GameConfig.MaxEquippedPets,
			Make.Colored(Format.Multiplier(Formulas.PetMultiplier(data)), Theme.Accent)
		)
		emptyLabel.Visible = #owned == 0

		if selectedUid and not data.Pets[selectedUid] then
			selectedUid = nil
		end

		for index, entry in owned do
			local rarity = RarityConfig[entry.Pet.Rarity]
			local cell = Make.Instance("TextButton", {
				Text = "",
				AutoButtonColor = true,
				BackgroundColor3 = if entry.Uid == selectedUid then Theme.PanelLight else Theme.Panel,
				LayoutOrder = index,
				Parent = grid,
			}, {
				Components.Corner(12),
				Components.Stroke(if entry.Uid == selectedUid then 5 else 3, rarity.Color),
			})
			Components.Label({
				Size = UDim2.new(1, 0, 0, 62),
				Text = entry.Pet.Emoji,
				TextSize = 48,
				Outline = false,
				Parent = cell,
			})
			Components.Label({
				Position = UDim2.fromOffset(4, 62),
				Size = UDim2.new(1, -8, 0, 34),
				Text = entry.Pet.Name,
				TextSize = 15,
				TextWrapped = true,
				TextColor3 = rarity.Color,
				Parent = cell,
			})
			Components.Label({
				Position = UDim2.fromOffset(0, 96),
				Size = UDim2.new(1, 0, 0, 24),
				Text = Format.Multiplier(entry.Pet.Multiplier),
				TextSize = 18,
				TextColor3 = Theme.Accent,
				Parent = cell,
			})
			if entry.Equipped then
				Components.Label({
					Position = UDim2.fromOffset(4, 2),
					Size = UDim2.fromOffset(26, 26),
					Text = "✅",
					TextSize = 20,
					Outline = false,
					Parent = cell,
				})
			end
			cell.Activated:Connect(function()
				SoundController.Play("UIClick")
				selectedUid = entry.Uid
				deleteArmedUntil = 0
				Components.SetButton(deleteButton, "🗑️ Delete")
				refresh()
			end)
			table.insert(cells, cell)
		end

		local selectedPetId = selectedUid and data.Pets[selectedUid]
		local selectedPet = selectedPetId and PetConfig.Pets[selectedPetId]
		details.Visible = selectedPet ~= nil
		if selectedPet then
			local rarity = RarityConfig[selectedPet.Rarity]
			detailsLabel.Text = string.format(
				"%s %s\n%s · %s cash",
				selectedPet.Emoji,
				selectedPet.Name,
				Make.Colored(rarity.Name, rarity.Color),
				Make.Colored(Format.Multiplier(selectedPet.Multiplier), Theme.Accent)
			)
			local equipped = table.find(data.EquippedPets, selectedUid) ~= nil
			Components.SetButton(
				equipButton,
				if equipped then "Unequip" else "Equip",
				if equipped then Theme.Info else Theme.Good
			)
		end
	end

	ClientData.Observe({ "Pets", "EquippedPets" }, function()
		if window.IsOpen() then
			refresh()
		end
	end)
	window.Opened:Connect(refresh)
end

return PetsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">RagdollController</string>
              <string name="Source"><![CDATA[-- Client half of the ragdoll: the server swaps the joints, then tells us to
-- go limp (Physics state) and fling, because we own our character's physics.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local SoundController = require(script.Parent.SoundController)

local RagdollController = {}

local player = Players.LocalPlayer

function RagdollController.Start()
	Net.Event("Ragdoll").OnClientEvent:Connect(function(enabled: boolean, fling: Vector3?)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not humanoid or not root then
			return
		end
		if enabled then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			humanoid.AutoRotate = false
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			if fling then
				root.AssemblyLinearVelocity = fling
				root.AssemblyAngularVelocity =
					Vector3.new(math.random(-12, 12), math.random(-12, 12), math.random(-12, 12))
			end
		else
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			humanoid.AutoRotate = true
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			SoundController.Play("GetUp")
		end
	end)
end

return RagdollController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">RebirthWindow</string>
              <string name="Source"><![CDATA[-- Rebirth window [R] and Titles window [T].

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetConfig = require(Shared.Config.PetConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local ClientData = require(script.Parent.Parent.ClientData)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local HUDController = require(script.Parent.HUDController)
local SoundController = require(script.Parent.SoundController)

local RebirthWindow = {}

-- Title odds, with the luck boost applied when it's active.
local function titleChances(lucky: boolean): { number }
	return WeightedRandom.Chances(RebirthConfig.Titles, function(title)
		if lucky and RarityConfig[title.Rarity].Lucky then
			return title.Weight * PetConfig.LuckBoostMultiplier
		end
		return title.Weight
	end)
end

local function buildRebirth()
	local window = Components.Window("Rebirth", "🔁 REBIRTH", Vector2.new(680, 560), Theme.Pink)
	local body = window.Body

	local header = Components.Label({
		Size = UDim2.new(1, 0, 0, 44),
		Text = "",
		TextSize = 32,
		TextColor3 = Theme.Accent,
		Parent = body,
	})
	local _, setProgress, progressText = Components.ProgressBar({
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, 36),
		Color = Theme.Good,
		TextSize = 20,
		Parent = body,
	})
	Components.Label({
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 0, 52),
		Text = "Resets: " .. Make.Colored("Cash & Upgrades", Theme.Bad) .. "\nKeeps: " .. Make.Colored(
			"Zones, Pets & Titles",
			Theme.Good
		),
		TextSize = 20,
		TextColor3 = Theme.SubText,
		Parent = body,
	})
	Components.Label({
		Position = UDim2.fromOffset(0, 152),
		Size = UDim2.new(1, 0, 0, 28),
		Text = "🎲 Every rebirth rolls a random TITLE:",
		TextSize = 22,
		Parent = body,
	})
	local oddsList = Components.ScrollList({
		Position = UDim2.fromOffset(0, 184),
		Size = UDim2.new(1, 0, 1, -184 - 76),
		Gap = 2,
		Parent = body,
	})
	local oddsRows = {}
	for index in RebirthConfig.Titles do
		oddsRows[index] = Components.Label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = "",
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = index,
			Parent = oddsList,
		})
	end

	local rebirthButton = Components.Button({
		Text = "REBIRTH",
		Color = Theme.Pink,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(360, 64),
		TextSize = 30,
		Parent = body,
		OnClick = function()
			local ok, message = Net.Invoke("Rebirth")
			if ok then
				window.Close()
			else
				SoundController.Play("UIError")
				if message then
					HUDController.Toast(message, "Bad")
				end
			end
		end,
	})

	local function refresh()
		local data = ClientData.Data
		local cost = Formulas.RebirthCost(data.Rebirths)
		local now = Formulas.RebirthMultiplier(data.Rebirths)
		local nextMultiplier = Formulas.RebirthMultiplier(data.Rebirths + 1)
		header.Text = string.format(
			"Rebirth #%d · %s → %s cash",
			data.Rebirths + 1,
			Format.Multiplier(now),
			Make.Colored(Format.Multiplier(nextMultiplier), Theme.Good)
		)
		setProgress(data.Cash / cost)
		progressText.Text = Format.Cash(data.Cash) .. " / " .. Format.Cash(cost)
		Components.SetButton(
			rebirthButton,
			if data.Cash >= cost then "🔁 REBIRTH NOW!" else "Need " .. Format.Cash(cost - data.Cash) .. " more",
			if data.Cash >= cost then Theme.Pink else Theme.Disabled
		)
		local lucky = Formulas.IsBoostActive(data, "Luck", HUDController.Now())
		local chances = titleChances(lucky)
		for index, title in RebirthConfig.Titles do
			local rarity = RarityConfig[title.Rarity]
			local owned = data.Titles[title.Id]
			oddsRows[index].Text = string.format(
				"%s %s  %s  %s",
				if owned then "✅" else "▫️",
				Make.Colored(if owned then title.Text else "???", rarity.Color),
				Make.Colored("(" .. rarity.Name .. ")", Theme.SubText),
				Make.Colored(
					Format.Percent(chances[index]) .. (if lucky and rarity.Lucky then " 🍀" else ""),
					Theme.Accent
				)
			)
		end
	end

	ClientData.Observe({ "Cash", "Rebirths", "Titles", "Boosts" }, function()
		if window.IsOpen() then
			refresh()
		end
	end)
	window.Opened:Connect(refresh)
end

local function buildTitles()
	local window = Components.Window("Titles", "🏷️ TITLES", Vector2.new(620, 540), Color3.fromRGB(170, 110, 255))
	local list = Components.ScrollList({ Size = UDim2.new(1, 0, 1, -70), Parent = window.Body })
	Components.Button({
		Text = "Hide title",
		Color = Theme.Disabled,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(220, 52),
		Parent = window.Body,
		OnClick = function()
			Net.Invoke("EquipTitle", "")
		end,
	})
	local rows = {}
	for index, title in RebirthConfig.Titles do
		local row = Components.Row(64, index, list)
		local label = Components.Label({
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -200, 1, 0),
			Text = "",
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local button = Components.Button({
			Text = "",
			Size = UDim2.fromOffset(160, 46),
			Position = UDim2.new(1, -172, 0.5, -23),
			Parent = row,
			OnClick = function()
				if ClientData.Data.Titles[title.Id] then
					Net.Invoke("EquipTitle", title.Id)
				end
			end,
		})
		rows[title.Id] = { Label = label, Button = button }
	end

	local function refresh()
		local data = ClientData.Data
		for _, title in RebirthConfig.Titles do
			local row = rows[title.Id]
			local rarity = RarityConfig[title.Rarity]
			local owned = data.Titles[title.Id]
			row.Label.Text = Make.Colored(if owned then title.Text else "🔒 ???", rarity.Color)
				.. "\n"
				.. Make.Colored(rarity.Name .. (if title.Aura then " · ✨ aura" else ""), Theme.SubText)
			if not owned then
				Components.SetButton(row.Button, "Not owned", Theme.Disabled)
			elseif data.EquippedTitle == title.Id then
				Components.SetButton(row.Button, "Equipped ✅", Theme.Info)
			else
				Components.SetButton(row.Button, "Equip", Theme.Good)
			end
		end
	end

	ClientData.Observe({ "Titles", "EquippedTitle" }, function()
		if window.IsOpen() then
			refresh()
		end
	end)
	window.Opened:Connect(refresh)
end

function RebirthWindow.Start()
	buildRebirth()
	buildTitles()
end

return RebirthWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">RewardsWindow</string>
              <string name="Source"><![CDATA[-- Rewards window [G]: 7-day login streak and this session's playtime gifts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RewardConfig = require(Shared.Config.RewardConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local ClientData = require(script.Parent.Parent.ClientData)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local EffectsController = require(script.Parent.EffectsController)
local HUDController = require(script.Parent.HUDController)
local SoundController = require(script.Parent.SoundController)

local RewardsWindow = {}

local player = Players.LocalPlayer

-- Short text for a reward, with cash scaled for this player.
local function describe(reward: RewardConfig.Reward, data: any): string
	local parts = {}
	if reward.Amount then
		table.insert(parts, "💵 " .. Format.Cash(Formulas.RewardCash(data, reward.Amount)))
	end
	local cashMinutes = if reward.Type == "CashBoost" then reward.Minutes else reward.CashBoostMinutes
	if cashMinutes then
		table.insert(parts, "💸 2x Cash " .. cashMinutes .. "m")
	end
	local luckMinutes = if reward.Type == "LuckBoost" then reward.Minutes else reward.LuckBoostMinutes
	if luckMinutes then
		table.insert(parts, "🍀 2x Luck " .. luckMinutes .. "m")
	end
	return table.concat(parts, "\n")
end

local function claim(remote: string, ...: any)
	local ok, message = Net.Invoke(remote, ...)
	if ok then
		SoundController.Play("RewardClaim")
		EffectsController.Flash(Theme.Accent, 0.35, 0.4)
		EffectsController.BigText(message or "🎁 Claimed!", Theme.Accent, 2)
	else
		SoundController.Play("UIError")
		if message then
			HUDController.Toast(message, "Bad")
		end
	end
end

function RewardsWindow.Start()
	local window = Components.Window("Rewards", "🎁 REWARDS", Vector2.new(820, 600), Color3.fromRGB(255, 170, 50))
	local body = window.Body

	-- Daily streak
	local streakLabel = Components.Label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = body,
	})
	local dayRow = Make.Instance("Frame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 120),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		Make.Instance("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local dayTiles = {}
	for index in RewardConfig.Daily do
		local tile = Make.Instance("Frame", {
			Size = UDim2.fromOffset(102, 120),
			BackgroundColor3 = Theme.Panel,
			LayoutOrder = index,
			Parent = dayRow,
		}, { Components.Corner(12), Components.Stroke(3) })
		Components.Label({ Size = UDim2.new(1, 0, 0, 28), Text = "Day " .. index, TextSize = 20, Parent = tile })
		local text = Components.Label({
			Position = UDim2.fromOffset(4, 30),
			Size = UDim2.new(1, -8, 1, -34),
			Text = "",
			TextSize = 15,
			TextWrapped = true,
			Parent = tile,
		})
		dayTiles[index] = { Tile = tile, Text = text }
	end
	local dailyButton = Components.Button({
		Text = "",
		Size = UDim2.fromOffset(320, 54),
		Position = UDim2.fromOffset(0, 170),
		TextSize = 24,
		Parent = body,
		OnClick = function()
			claim("ClaimDaily")
		end,
	})

	-- Playtime gifts
	Components.Label({
		Position = UDim2.fromOffset(0, 236),
		Size = UDim2.new(1, 0, 0, 32),
		Text = "⏱️ Playtime gifts (reset every session)",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = body,
	})
	local giftList = Components.ScrollList({
		Position = UDim2.fromOffset(0, 272),
		Size = UDim2.new(1, 0, 1, -272),
		Gap = 6,
		Parent = body,
	})
	local giftRows = {}
	for index, gift in RewardConfig.Playtime do
		local row = Components.Row(56, index, giftList)
		local label = Components.Label({
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -220, 1, 0),
			Text = "",
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local button = Components.Button({
			Text = "",
			Size = UDim2.fromOffset(180, 44),
			Position = UDim2.new(1, -192, 0.5, -22),
			Parent = row,
			OnClick = function()
				claim("ClaimPlaytime", index)
			end,
		})
		giftRows[index] = { Label = label, Button = button, Gift = gift }
	end

	local function refresh()
		local data = ClientData.Data
		local canClaim, streak, rewardIndex = Formulas.DailyStatus(data, HUDController.Now())
		streakLabel.Text =
			string.format("🔥 Login streak: %d day%s", data.Daily.Streak, if data.Daily.Streak == 1 then "" else "s")
		for index, tile in dayTiles do
			tile.Text.Text = describe(RewardConfig.Daily[index], data)
			local stroke = tile.Tile:FindFirstChildOfClass("UIStroke") :: UIStroke
			if index == rewardIndex then
				tile.Tile.BackgroundColor3 = if canClaim then Theme.Good else Theme.PanelLight
				stroke.Color = Theme.Accent
			else
				tile.Tile.BackgroundColor3 = Theme.Panel
				stroke.Color = Theme.Stroke
			end
		end
		if canClaim then
			Components.SetButton(dailyButton, "🎁 Claim Day " .. streak .. "!", Theme.Good)
		else
			local nextDay = (Formulas.DayNumber(HUDController.Now()) + 1) * 86400
			Components.SetButton(dailyButton, "Next in " .. Format.Time(nextDay - HUDController.Now()), Theme.Disabled)
		end

		local start = player:GetAttribute("SessionStart") or workspace:GetServerTimeNow()
		local elapsed = workspace:GetServerTimeNow() - start
		for index, row in giftRows do
			row.Label.Text = string.format(
				"%d min · %s",
				row.Gift.Minutes,
				(string.gsub(describe(row.Gift.Reward, data), "\n", " + "))
			)
			if player:GetAttribute("GiftClaimed_" .. index) then
				Components.SetButton(row.Button, "Claimed ✅", Theme.Disabled)
			elseif elapsed >= row.Gift.Minutes * 60 then
				Components.SetButton(row.Button, "🎁 CLAIM!", Theme.Good)
			else
				Components.SetButton(row.Button, Format.Time(row.Gift.Minutes * 60 - elapsed), Theme.Disabled)
			end
		end
	end

	window.Opened:Connect(function()
		refresh()
		task.spawn(function()
			while window.IsOpen() do
				task.wait(0.5)
				refresh()
			end
		end)
	end)
end

return RewardsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">ShopWindow</string>
              <string name="Source"><![CDATA[-- Shop window [B]: upgrades and zone unlocks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FoodConfig = require(Shared.Config.FoodConfig)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local ClientData = require(script.Parent.Parent.ClientData)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local EffectsController = require(script.Parent.EffectsController)
local HUDController = require(script.Parent.HUDController)
local SoundController = require(script.Parent.SoundController)

local ShopWindow = {}

local function statText(upgrade: UpgradeConfig.Upgrade, level: number): string
	local value = Formulas.UpgradeStat(upgrade.Id, level)
	if upgrade.Id == "Value" then
		return Format.Multiplier(value) .. " cash"
	end
	return (string.gsub(string.format("%.1f", value), "%.0$", "")) .. upgrade.Unit
end

local function purchase(remote: string, id: string, button: TextButton)
	local ok, message = Net.Invoke(remote, id)
	if ok then
		SoundController.Play("Purchase")
		EffectsController.Shake(0.25, 0.15)
		local scale = button:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 1.25
			TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		if message then
			HUDController.Toast(message, "Good")
		end
	else
		SoundController.Play("UIError")
		if message then
			HUDController.Toast(message, "Bad")
		end
	end
end

local function buildUpgrades(parent: Frame): () -> ()
	local list = Components.ScrollList({ Parent = parent })
	local rows = {}
	for index, upgrade in UpgradeConfig.List do
		local row = Components.Row(84, index, list)
		Components.Label({
			Size = UDim2.fromOffset(70, 84),
			Text = upgrade.Emoji,
			TextSize = 44,
			Outline = false,
			Parent = row,
		})
		Components.Label({
			Position = UDim2.fromOffset(74, 8),
			Size = UDim2.new(1, -260, 0, 30),
			Text = upgrade.Name,
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local detail = Components.Label({
			Position = UDim2.fromOffset(74, 40),
			Size = UDim2.new(1, -260, 0, 36),
			Text = "",
			TextSize = 18,
			TextWrapped = true,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = row,
		})
		local button
		button = Components.Button({
			Text = "",
			Size = UDim2.fromOffset(170, 56),
			Position = UDim2.new(1, -182, 0.5, -28),
			Parent = row,
			OnClick = function()
				purchase("BuyUpgrade", upgrade.Id, button)
			end,
		})
		rows[upgrade.Id] = { Detail = detail, Button = button }
	end

	return function()
		local data = ClientData.Data
		for _, upgrade in UpgradeConfig.List do
			local row = rows[upgrade.Id]
			local level = Formulas.UpgradeLevel(data, upgrade.Id)
			if level >= upgrade.MaxLevel then
				row.Detail.Text = string.format(
					"%s\nLv %d/%d · %s",
					upgrade.Description,
					level,
					upgrade.MaxLevel,
					statText(upgrade, level)
				)
				Components.SetButton(row.Button, "MAXED ✨", Theme.Disabled)
			else
				local cost = Formulas.UpgradeCost(upgrade.Id, level)
				row.Detail.Text = string.format(
					"%s\nLv %d/%d · %s → %s",
					upgrade.Description,
					level,
					upgrade.MaxLevel,
					statText(upgrade, level),
					Make.Colored(statText(upgrade, level + 1), Theme.Good)
				)
				Components.SetButton(
					row.Button,
					Format.Cash(cost),
					if data.Cash >= cost then Theme.Good else Theme.Disabled
				)
			end
		end
	end
end

local function valueRange(zone: ZoneConfig.Zone): string
	local low, high = math.huge, 0
	for _, entry in zone.Foods do
		local value = FoodConfig[entry.Id].Value
		low = math.min(low, value)
		high = math.max(high, value)
	end
	return Format.Cash(low) .. "–" .. Format.Cash(high)
end

local function buildZones(parent: Frame): () -> ()
	local list = Components.ScrollList({ Parent = parent })
	local rows = {}
	for index, zone in ZoneConfig.List do
		local row = Components.Row(96, index, list)
		Make.Instance("Frame", {
			Size = UDim2.new(0, 10, 1, -16),
			Position = UDim2.fromOffset(8, 8),
			BackgroundColor3 = zone.FloorColor,
			Parent = row,
		}, { Components.Corner(5) })
		Components.Label({
			Position = UDim2.fromOffset(18, 0),
			Size = UDim2.fromOffset(64, 96),
			Text = zone.Emoji,
			TextSize = 44,
			Outline = false,
			Parent = row,
		})
		Components.Label({
			Position = UDim2.fromOffset(86, 8),
			Size = UDim2.new(1, -280, 0, 30),
			Text = zone.Name,
			TextSize = 26,
			TextColor3 = zone.FloorColor,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local duck = zone.Duck
		Components.Label({
			Position = UDim2.fromOffset(86, 40),
			Size = UDim2.new(1, -280, 0, 50),
			Text = string.format(
				"Snacks worth %s each\n🦆 %d× %s · speed %d",
				valueRange(zone),
				duck.Count,
				duck.Name,
				duck.ChaseSpeed
			),
			TextSize = 18,
			TextWrapped = true,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = row,
		})
		local button
		button = Components.Button({
			Text = "",
			Size = UDim2.fromOffset(180, 56),
			Position = UDim2.new(1, -192, 0.5, -28),
			Parent = row,
			OnClick = function()
				purchase("UnlockZone", zone.Id, button)
			end,
		})
		rows[zone.Id] = button
	end

	return function()
		local data = ClientData.Data
		for _, zone in ZoneConfig.List do
			local button = rows[zone.Id]
			local previous = ZoneConfig.List[zone.Order - 1]
			if data.Zones[zone.Id] then
				Components.SetButton(button, "UNLOCKED ✅", Theme.Disabled)
			elseif previous and not data.Zones[previous.Id] then
				Components.SetButton(button, "🔒 " .. previous.Name .. " first", Theme.Disabled)
			else
				Components.SetButton(
					button,
					"Unlock " .. Format.Cash(zone.Cost),
					if data.Cash >= zone.Cost then Theme.Good else Theme.Disabled
				)
			end
		end
	end
end

function ShopWindow.Start()
	local window = Components.Window("Shop", "🛒 SHOP", Vector2.new(760, 560), Color3.fromRGB(70, 160, 255))
	local tabsBar = Make.Instance("Frame", {
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		Parent = window.Body,
	}, {
		Make.Instance("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local pages = {}
	local function page(name: string): Frame
		local frame = Make.Instance("Frame", {
			Name = name,
			Position = UDim2.fromOffset(0, 60),
			Size = UDim2.new(1, 0, 1, -60),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = window.Body,
		})
		pages[name] = frame
		return frame
	end
	local function show(name: string)
		for pageName, frame in pages do
			frame.Visible = pageName == name
		end
	end

	local refreshUpgrades = buildUpgrades(page("Upgrades"))
	local refreshZones = buildZones(page("Zones"))
	Components.Button({
		Text = "⚡ Upgrades",
		Color = Theme.Info,
		Size = UDim2.fromOffset(180, 46),
		LayoutOrder = 1,
		Parent = tabsBar,
		OnClick = function()
			show("Upgrades")
		end,
	})
	Components.Button({
		Text = "🗺️ Zones",
		Color = Theme.Pink,
		Size = UDim2.fromOffset(180, 46),
		LayoutOrder = 2,
		Parent = tabsBar,
		OnClick = function()
			show("Zones")
		end,
	})
	show("Upgrades")

	ClientData.Observe({ "Cash", "Upgrades", "Zones" }, function()
		if window.IsOpen() then
			refreshUpgrades()
			refreshZones()
		end
	end)
	window.Opened:Connect(function()
		refreshUpgrades()
		refreshZones()
	end)
end

return ShopWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[-- Plays the layered sound cues from SoundConfig on the client.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundConfig = require(Shared.Config.SoundConfig)
local Make = require(Shared.Util.Make)

local SoundController = {}

local rng = Random.new()
local folder: Folder
local lastPlayed: { [string]: number } = {}

local function playLayer(layer: SoundConfig.Layer)
	if layer.Id == "" then
		return
	end
	local variance = layer.Variance or 0
	local sound = Make.Instance("Sound", {
		SoundId = layer.Id,
		Volume = layer.Volume,
		PlaybackSpeed = layer.Speed + rng:NextNumber(-variance, variance),
		Parent = folder,
	})
	sound:Play()
	Debris:AddItem(sound, 6)
end

-- Plays a cue. `minGap` stops spammy cues (pickups) from stacking up.
function SoundController.Play(cueName: string, minGap: number?)
	local cue = SoundConfig.Cues[cueName]
	if not cue then
		warn("[SoundController] Unknown cue " .. cueName)
		return
	end
	local now = os.clock()
	if minGap and now - (lastPlayed[cueName] or 0) < minGap then
		return
	end
	lastPlayed[cueName] = now
	for _, layer in cue.Layers do
		if layer.Delay and layer.Delay > 0 then
			task.delay(layer.Delay, playLayer, layer)
		else
			playLayer(layer)
		end
	end
end

function SoundController.Start()
	folder = Make.Instance("Folder", { Name = "CapySfx", Parent = SoundService })
	if SoundConfig.MusicId ~= "" then
		Make.Instance("Sound", {
			Name = "Music",
			SoundId = SoundConfig.MusicId,
			Volume = SoundConfig.MusicVolume,
			Looped = true,
			Parent = SoundService,
		}):Play()
	end
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[-- Local world tweaks: unlocked gates become walk-through for you, shop and
-- rebirth stalls open their windows, and snack emojis bob in place.

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")

local ClientData = require(script.Parent.Parent.ClientData)
local Components = require(script.Parent.Parent.UI.Components)

local WorldController = {}

local function refreshGate(gate: Instance)
	if not gate:IsA("BasePart") then
		return
	end
	local zoneId = gate:GetAttribute("ZoneId")
	local unlocked = ClientData.Data.Zones[zoneId] == true
	gate.CanCollide = not unlocked
	gate.Transparency = if unlocked then 0.85 else 0.1
	local prompt = gate:FindFirstChild("UnlockPrompt", true)
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = not unlocked
	end
	local gui = gate:FindFirstChildOfClass("SurfaceGui")
	local label = gui and gui:FindFirstChild("LockText")
	if label and label:IsA("TextLabel") then
		label.Visible = not unlocked
	end
end

local function refreshGates()
	for _, gate in CollectionService:GetTagged("ZoneGate") do
		refreshGate(gate)
	end
end

function WorldController.Start()
	ClientData.Observe({ "Zones" }, refreshGates)
	CollectionService:GetInstanceAddedSignal("ZoneGate"):Connect(refreshGate)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local window = prompt:GetAttribute("OpensWindow")
		if type(window) == "string" then
			Components.OpenWindow(window)
		end
	end)

	-- Bob snack emojis (client-only property change on the billboard).
	local billboards: { [BasePart]: BillboardGui } = {}
	local function onFood(part: Instance)
		if part:IsA("BasePart") then
			local gui = part:FindFirstChildOfClass("BillboardGui")
			if gui then
				billboards[part] = gui
			end
		end
	end
	for _, part in CollectionService:GetTagged("Food") do
		onFood(part)
	end
	CollectionService:GetInstanceAddedSignal("Food"):Connect(onFood)
	CollectionService:GetInstanceRemovedSignal("Food"):Connect(function(part)
		billboards[part :: BasePart] = nil
	end)
	local baseOffsets: { [BillboardGui]: Vector3 } = {}
	RunService.RenderStepped:Connect(function()
		local t = os.clock() * 3
		for part, gui in billboards do
			if gui.Parent ~= part then
				billboards[part] = nil
				continue
			end
			local base = baseOffsets[gui]
			if not base then
				base = gui.StudsOffset
				baseOffsets[gui] = base
			end
			gui.StudsOffset = base + Vector3.new(0, math.sin(t + part.Position.X) * 0.35, 0)
		end
	end)
	-- Forget offsets for destroyed snacks.
	task.spawn(function()
		while true do
			task.wait(10)
			for gui in baseOffsets do
				if gui.Parent == nil then
					baseOffsets[gui] = nil
				end
			end
		end
	end)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="60">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point. Waits for the player's data, then starts every
-- controller in order.

local ClientData = require(script.Parent.ClientData)
local Controllers = script.Parent.Controllers

local SoundController = require(Controllers.SoundController)
SoundController.Start()

ClientData.Load()

local order = {
	"EffectsController",
	"HUDController",
	"ShopWindow",
	"PetsWindow",
	"RebirthWindow",
	"RewardsWindow",
	"HatchController",
	"PetFollowController",
	"RagdollController",
	"WorldController",
	"InputController",
}

for _, name in order do
	local controller = require(Controllers[name])
	local ok, err = pcall(controller.Start)
	if not ok then
		warn(string.format("[Client] %s failed to start: %s", name, tostring(err)))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="61">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[-- Reusable UI pieces: the root ScreenGui, labels, juicy buttons, progress
-- bars, and pop-up windows (only one window is open at a time).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Util.Make)
local Signal = require(Shared.Util.Signal)

local Theme = require(script.Parent.Theme)
local SoundController = require(script.Parent.Parent.Controllers.SoundController)

local Components = {}

local screenGui: ScreenGui? = nil
local overlayGui: ScreenGui? = nil

local function makeScreen(name: string, order: number): ScreenGui
	local gui = Make.Instance("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	-- Scale everything with the window height (designed at 900px tall).
	local scale = Make.Instance("UIScale", { Parent = gui })
	local camera = workspace.CurrentCamera
	local function rescale()
		scale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.6, 1.4)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
	return gui
end

-- Main HUD/windows gui.
function Components.Screen(): ScreenGui
	if not screenGui then
		screenGui = makeScreen("CapyUI", 1)
	end
	return screenGui :: ScreenGui
end

-- Full-screen effects, hatch reveals and banners draw above everything.
function Components.Overlay(): ScreenGui
	if not overlayGui then
		overlayGui = makeScreen("CapyOverlay", 10)
	end
	return overlayGui :: ScreenGui
end

function Components.Corner(radius: number?): UICorner
	return Make.Instance("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Components.Stroke(thickness: number?, color: Color3?): UIStroke
	return Make.Instance("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Theme.Stroke,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Components.Padding(pixels: number): UIPadding
	local padding = UDim.new(0, pixels)
	return Make.Instance("UIPadding", {
		PaddingTop = padding,
		PaddingBottom = padding,
		PaddingLeft = padding,
		PaddingRight = padding,
	})
end

-- Text label with an outline. Use TextSize for fixed sizes, or Scaled = true.
function Components.Label(props: { [string]: any }): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextSize = 22,
		RichText = true,
	}
	for key, value in props do
		if key ~= "Scaled" and key ~= "Outline" then
			merged[key] = value
		end
	end
	if props.Scaled then
		merged.TextScaled = true
	end
	local label = Make.Instance("TextLabel", merged)
	if props.Outline ~= false then
		Make.Instance("UIStroke", {
			Thickness = if type(props.Outline) == "number" then props.Outline else 2,
			Color = Theme.Stroke,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end
	return label
end

export type ButtonProps = {
	Text: string,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	TextSize: number?,
	LayoutOrder: number?,
	Parent: Instance?,
	OnClick: (() -> ())?,
}

-- Chunky button that squishes on hover/click and plays a click sound.
function Components.Button(props: ButtonProps): TextButton
	local button = Make.Instance("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = props.Color or Theme.Good,
		Size = props.Size or UDim2.fromOffset(140, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
	}, {
		Components.Corner(12),
		Components.Stroke(3),
		Make.Instance("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)),
		}),
	})
	local scale = Make.Instance("UIScale", { Parent = button })
	Components.Label({
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = props.Text,
		TextSize = props.TextSize or 22,
		TextWrapped = true,
		Parent = button,
	})
	local function tweenScale(target: number)
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = target }):Play()
	end
	button.MouseEnter:Connect(function()
		tweenScale(1.06)
	end)
	button.MouseLeave:Connect(function()
		tweenScale(1)
	end)
	button.MouseButton1Down:Connect(function()
		tweenScale(0.92)
	end)
	button.MouseButton1Up:Connect(function()
		tweenScale(1.06)
	end)
	button.Activated:Connect(function()
		SoundController.Play("UIClick", 0.05)
		if props.OnClick then
			props.OnClick()
		end
	end)
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

function Components.SetButton(button: TextButton, text: string, color: Color3?)
	local label = button:FindFirstChild("Label") :: TextLabel
	label.Text = text
	if color then
		button.BackgroundColor3 = color
	end
end

-- Horizontal progress bar. Returns the bar, a setter, and its text label.
function Components.ProgressBar(props: { [string]: any }): (Frame, (number) -> (), TextLabel)
	local bar = Make.Instance("Frame", {
		BackgroundColor3 = Theme.Stroke,
		Size = props.Size or UDim2.fromOffset(300, 30),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { Components.Corner(10), Components.Stroke(3) })
	local fill = Make.Instance("Frame", {
		Name = "Fill",
		BackgroundColor3 = props.Color or Theme.Accent,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { Components.Corner(10) })
	local label = Components.Label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Text = props.Text or "",
		TextSize = props.TextSize or 18,
		ZIndex = 2,
		Parent = bar,
	})
	local function set(fraction: number)
		TweenService:Create(fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1) }):Play()
	end
	return bar, set, label
end

-- Windows -------------------------------------------------------------------

export type Window = {
	Name: string,
	Frame: Frame,
	Body: Frame,
	Opened: any, -- Signal
	IsOpen: () -> boolean,
	Open: () -> (),
	Close: () -> (),
	Toggle: () -> (),
}

local windows: { [string]: Window } = {}
local openWindow: Window? = nil

function Components.GetWindow(name: string): Window?
	return windows[name]
end

function Components.OpenWindow(name: string)
	local window = windows[name]
	if window then
		window.Open()
	end
end

function Components.ToggleWindow(name: string)
	local window = windows[name]
	if window then
		window.Toggle()
	end
end

function Components.CloseWindows()
	if openWindow then
		openWindow.Close()
	end
end

function Components.Window(name: string, title: string, size: Vector2, accent: Color3?): Window
	local frame = Make.Instance("Frame", {
		Name = name .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Theme.Background,
		Visible = false,
		ZIndex = 5,
		Parent = Components.Screen(),
	}, { Components.Corner(18), Components.Stroke(4) })
	local scale = Make.Instance("UIScale", { Parent = frame })

	local header = Make.Instance("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundColor3 = accent or Theme.Pink,
		Parent = frame,
	}, { Components.Corner(18) })
	-- Square off the header's bottom corners.
	Make.Instance("Frame", {
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundColor3 = accent or Theme.Pink,
		BorderSizePixel = 0,
		Parent = header,
	})
	Components.Label({
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		Text = title,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = header,
	})

	local body = Make.Instance("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 1, -60),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { Components.Padding(14) })

	local window: Window
	local opened = Signal.new()

	local function close()
		if not frame.Visible then
			return
		end
		frame.Visible = false
		if openWindow == window then
			openWindow = nil
		end
	end

	local function open()
		if openWindow and openWindow ~= window then
			openWindow.Close()
		end
		openWindow = window
		frame.Visible = true
		scale.Scale = 0.6
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		SoundController.Play("UIClick")
		opened:Fire()
	end

	Components.Button({
		Text = "X",
		Color = Theme.Bad,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(1, -54, 0, 7),
		TextSize = 28,
		Parent = header,
		OnClick = close,
	})

	window = {
		Name = name,
		Frame = frame,
		Body = body,
		Opened = opened,
		IsOpen = function()
			return frame.Visible
		end,
		Open = open,
		Close = close,
		Toggle = function()
			if frame.Visible then
				close()
			else
				open()
			end
		end,
	}
	windows[name] = window
	return window
end

-- Scrolling list that grows with its contents.
function Components.ScrollList(props: { [string]: any }): ScrollingFrame
	local list = Make.Instance("ScrollingFrame", {
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = props.Parent,
	})
	if props.Grid then
		Make.Instance("UIGridLayout", {
			CellSize = props.Grid,
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = list,
		})
	else
		Make.Instance("UIListLayout", {
			Padding = UDim.new(0, props.Gap or 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = list,
		})
	end
	Make.Instance("UIPadding", {
		PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		Parent = list,
	})
	return list
end

-- A rounded panel row used by shop/reward lists.
function Components.Row(height: number, layoutOrder: number, parent: Instance): Frame
	return Make.Instance("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = layoutOrder,
		Parent = parent,
	}, { Components.Corner(14), Components.Stroke(2) })
end

return Components
]]></string>
            </Properties>
