  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="26">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point. Builds the map, then starts every service in order.
-- Services only depend on services started before them.

local Services = script.Parent.Services

local MapBuilder = require(Services.MapBuilder)
MapBuilder.Build()

local order = {
	"DataService",
	"RagdollService",
	"FoodService",
	"EventService",
	"CapybaraService",
	"DuckService",
	"UpgradeService",
	"ZoneService",
	"PetService",
	"RebirthService",
	"RewardService",
	"LeaderboardService",
	"CharacterService", -- last: starts loading players and spawning characters
}

for _, name in order do
	local service = require(Services[name])
	local ok, err = pcall(service.Start)
	if not ok then
		warn(string.format("[Main] %s failed to start: %s", name, tostring(err)))
	end
end

print("[Main] Feed the Giant Capy server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CapybaraService</string>
            <string name="Source"><![CDATA[-- The Giant Capybara in the middle of the hub. Walk into the orange ring with
-- snacks and he eats them all, paying you cash. Every snack also fills a
-- server-wide meter; when it's full everyone gets a CAPY FEAST (2x cash).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FoodConfig = require(Shared.Config.FoodConfig)
local GameConfig = require(Shared.Config.GameConfig)
local SoundConfig = require(Shared.Config.SoundConfig)
local Formulas = require(Shared.Formulas)
local MapLayout = require(Shared.MapLayout)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local FoodService = require(script.Parent.FoodService)
local MapBuilder = require(script.Parent.MapBuilder)

local CapybaraService = {}

local DELIVERY_TICK = 0.15

local model: Model
local head: BasePart
local headRest: CFrame
local mouthPosition: Vector3
local meterFill: Frame
local meterText: TextLabel
local chompSound: Sound
local happySound: Sound
local chomping = false
local fullness = 0

local function feastTarget(): number
	return GameConfig.CapyFeastFoodBase + GameConfig.CapyFeastFoodPerPlayer * #Players:GetPlayers()
end

-- Builds the greybox capybara facing `facing`. Head pieces are welded to an
-- anchored head part so the head can be animated on its own.
local function buildGreyboxCapy(origin: CFrame): (Model, BasePart)
	local capy = Make.Instance("Model", { Name = "GiantCapybara" })
	local brown = Color3.fromRGB(150, 100, 60)
	local dark = Color3.fromRGB(105, 70, 45)

	local function piece(kind: string, size: Vector3, offset: Vector3, color: Color3, parent: Instance): BasePart
		local props = {
			Size = size,
			CFrame = origin * CFrame.new(offset),
			Color = color,
			Parent = parent,
		}
		if kind == "Ellipsoid" then
			return Make.Ellipsoid(props)
		end
		return Make.Part(props)
	end

	local body = piece("Ellipsoid", Vector3.new(24, 19, 36), Vector3.new(0, 12, 2), brown, capy)
	capy.PrimaryPart = body
	for _, x in { -7.5, 7.5 } do
		for _, z in { -9, 12 } do
			piece("Part", Vector3.new(6, 8, 6), Vector3.new(x, 3.5, z), dark, capy)
		end
	end

	local headModel = Make.Instance("Model", { Name = "Head", Parent = capy })
	local headPart = piece("Ellipsoid", Vector3.new(17, 15, 17), Vector3.new(0, 18, -17), brown, headModel)
	headModel.PrimaryPart = headPart
	local attached = {
		piece("Ellipsoid", Vector3.new(13, 9, 9), Vector3.new(0, 14.5, -25), dark, headModel), -- snout
		piece("Ellipsoid", Vector3.new(6, 2.5, 2), Vector3.new(0, 17.5, -29.4), Color3.fromRGB(30, 20, 15), headModel), -- nose
		piece("Part", Vector3.new(6, 0.6, 0.6), Vector3.new(0, 12.2, -29), Color3.fromRGB(40, 25, 15), headModel), -- mouth
		piece("Ellipsoid", Vector3.new(3.5, 3.5, 2), Vector3.new(-6.5, 25.5, -13), dark, headModel), -- ears
		piece("Ellipsoid", Vector3.new(3.5, 3.5, 2), Vector3.new(6.5, 25.5, -13), dark, headModel),
		piece(
			"Ellipsoid",
			Vector3.new(2.4, 1.2, 1),
			Vector3.new(-4.8, 21, -25.2),
			Color3.fromRGB(20, 15, 10),
			headModel
		), -- chill eyes
		piece(
			"Ellipsoid",
			Vector3.new(2.4, 1.2, 1),
			Vector3.new(4.8, 21, -25.2),
			Color3.fromRGB(20, 15, 10),
			headModel
		),
		piece(
			"Ellipsoid",
			Vector3.new(5.5, 5, 5.5),
			Vector3.new(0, 27.5, -17),
			Color3.fromRGB(255, 150, 30),
			headModel
		), -- the iconic orange
		piece("Part", Vector3.new(0.5, 1.5, 0.5), Vector3.new(0, 30.6, -17), Color3.fromRGB(60, 140, 50), headModel), -- orange stem
	}
	for _, part in attached do
		part.Anchored = false
		Make.Instance("WeldConstraint", { Part0 = headPart, Part1 = part, Parent = part })
	end
	return capy, headPart
end

local function buildCapy()
	local origin = CFrame.lookAt(MapLayout.CapyPosition, MapLayout.CapyPosition + Vector3.new(-1, 0, 1))
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local custom = assets and assets:FindFirstChild("Capybara")
	if custom and custom:IsA("Model") then
		model = custom:Clone()
		model:PivotTo(origin)
		local customHead = model:FindFirstChild("Head", true)
		head = if customHead and customHead:IsA("BasePart")
			then customHead
			else model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) :: BasePart
	else
		model, head = buildGreyboxCapy(origin)
	end
	model.Parent = MapBuilder.Folders.Capybara
	headRest = head.CFrame
	mouthPosition = (origin * CFrame.new(0, 12, -30)).Position

	-- Orange "drop zone" ring.
	Make.Part({
		Name = "FeedRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, GameConfig.DeliveryRadius * 2, GameConfig.DeliveryRadius * 2),
		CFrame = CFrame.new(MapLayout.CapyPosition + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 150, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.65,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = MapBuilder.Folders.Capybara,
	})

	-- Name + hunger meter above his head.
	local gui = Make.Instance("BillboardGui", {
		Size = UDim2.fromOffset(360, 110),
		StudsOffset = Vector3.new(0, 20, 0),
		MaxDistance = 400,
		LightInfluence = 0,
		AlwaysOnTop = true,
		Parent = head,
	})
	Make.Instance("TextLabel", {
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		Text = "🦫 SIR CHONKS THE GIANT CAPY 🦫",
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.fromRGB(255, 220, 120),
		TextStrokeTransparency = 0,
		Parent = gui,
	})
	local bar = Make.Instance("Frame", {
		Position = UDim2.fromOffset(20, 56),
		Size = UDim2.new(1, -40, 0, 40),
		BackgroundColor3 = Color3.fromRGB(40, 25, 20),
		Parent = gui,
	}, {
		Make.Instance("UICorner", { CornerRadius = UDim.new(0, 12) }),
		Make.Instance("UIStroke", { Thickness = 3, Color = Color3.fromRGB(20, 10, 5) }),
	})
	meterFill = Make.Instance("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(255, 150, 40),
		Parent = bar,
	}, { Make.Instance("UICorner", { CornerRadius = UDim.new(0, 12) }) })
	meterText = Make.Instance("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		ZIndex = 2,
		Parent = bar,
	})

	chompSound = Make.Instance("Sound", {
		SoundId = SoundConfig.Capy.Chomp.Id,
		Volume = SoundConfig.Capy.Chomp.Volume,
		PlaybackSpeed = SoundConfig.Capy.Chomp.Speed,
		RollOffMaxDistance = SoundConfig.Capy.RollOffMaxDistance,
		Parent = head,
	})
	happySound = Make.Instance("Sound", {
		SoundId = SoundConfig.Capy.Happy.Id,
		Volume = SoundConfig.Capy.Happy.Volume,
		PlaybackSpeed = SoundConfig.Capy.Happy.Speed,
		RollOffMaxDistance = SoundConfig.Capy.RollOffMaxDistance,
		Parent = head,
	})
end

local function updateMeter()
	local target = feastTarget()
	local feasting = EventService.IsActive("CapyFeast")
	local fraction = if feasting then 1 else math.clamp(fullness / target, 0, 1)
	meterFill.Size = UDim2.fromScale(fraction, 1)
	meterFill.BackgroundColor3 = if feasting then Color3.fromRGB(255, 80, 160) else Color3.fromRGB(255, 150, 40)
	meterText.Text = if feasting
		then "🎉 CAPY FEAST! 2x CASH 🎉"
		else string.format("FEED ME 🍔 %d / %d", math.floor(fullness), target)
	local gameState = EventService.GetGameState()
	gameState:SetAttribute("CapyFullness", fullness)
	gameState:SetAttribute("CapyFullnessMax", target)
end

local function chomp()
	if chomping then
		return
	end
	chomping = true
	chompSound:Play()
	local down = headRest * CFrame.new(0, -2.5, -1.5) * CFrame.Angles(math.rad(-14), 0, 0)
	local tweenDown = TweenService:Create(head, TweenInfo.new(0.1, Enum.EasingStyle.Quad), { CFrame = down })
	tweenDown:Play()
	tweenDown.Completed:Wait()
	local tweenUp = TweenService:Create(head, TweenInfo.new(0.18, Enum.EasingStyle.Back), { CFrame = headRest })
	tweenUp:Play()
	tweenUp.Completed:Wait()
	chomping = false
end

local function feastDance()
	while chomping do
		task.wait()
	end
	chomping = true -- blocks chomps so they don't fight the dance tween
	happySound:Play()
	local origin = model:GetPivot()
	local value = Make.Instance("NumberValue", { Value = 0 })
	value.Changed:Connect(function(t)
		model:PivotTo(
			origin * CFrame.new(0, math.abs(math.sin(t * math.pi * 6)) * 6, 0) * CFrame.Angles(0, t * math.pi * 4, 0)
		)
	end)
	local tween = TweenService:Create(value, TweenInfo.new(2.5, Enum.EasingStyle.Linear), { Value = 1 })
	tween:Play()
	tween.Completed:Wait()
	model:PivotTo(origin)
	headRest = head.CFrame
	value:Destroy()
	chomping = false
end

local function deliver(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local items, total = FoodService.TakeCarry(player)
	if total <= 0 then
		return
	end
	local baseValue = 0
	for foodId, count in items do
		baseValue += FoodConfig[foodId].Value * count
	end
	local multiplier = Formulas.CashMultiplier(data, os.time()) * EventService.GetCashMultiplier()
	local cash = math.max(1, math.floor(baseValue * multiplier))
	DataService.AddCash(player, cash)
	DataService.Increment(player, "TotalFed", total)

	Net.Fire(player, "Effect", "Deliver", {
		Cash = cash,
		Count = total,
		Multiplier = multiplier,
		Position = mouthPosition,
	})
	task.spawn(chomp)

	if not EventService.IsActive("CapyFeast") then
		fullness += total
		if fullness >= feastTarget() then
			fullness = 0
			EventService.Trigger("CapyFeast")
			task.spawn(feastDance)
		end
	end
	updateMeter()
end

function CapybaraService.Start()
	buildCapy()
	updateMeter()

	EventService.Ended:Connect(function(eventId)
		if eventId == "CapyFeast" then
			updateMeter()
		end
	end)
	Players.PlayerAdded:Connect(updateMeter)
	Players.PlayerRemoving:Connect(function()
		task.defer(updateMeter)
	end)

	local radiusSquared = GameConfig.DeliveryRadius * GameConfig.DeliveryRadius
	task.spawn(function()
		while true do
			task.wait(DELIVERY_TICK)
			for _, player in Players:GetPlayers() do
				if FoodService.GetCarry(player).Total <= 0 then
					continue
				end
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if not root or character:GetAttribute("Ragdolled") then
					continue
				end
				local offset = (root :: BasePart).Position - MapLayout.CapyPosition
				if offset.X * offset.X + offset.Z * offset.Z <= radiusSquared then
					deliver(player)
				end
			end
		end
	end)
end

return CapybaraService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[-- Spawning. Players.CharacterAutoLoads is off (see default.project.json) so a
-- character only spawns once the map is built and the player's data has
-- loaded; this service also handles respawning after deaths.

local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)

local CharacterService = {}

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		humanoid.Died:Connect(function()
			task.wait(Players.RespawnTime)
			if player.Parent then
				player:LoadCharacterAsync()
			end
		end)
	end)

	local data = DataService.Load(player)
	if data and player.Parent then
		player:LoadCharacterAsync()
	end
end

function CharacterService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Player save data. One DataStore key per player, guarded by a session lock so
-- two servers can never write the same player's data at once (prevents
-- duplication and rollback when players hop servers quickly).
--
-- In an unpublished Studio place (or with "Studio Access to API Services"
-- disabled) it falls back to temporary in-memory data and tells the player.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local LOCK_EXPIRY = 300 -- seconds; a lock older than this belongs to a dead server
local LOAD_ATTEMPTS = 6

local TEMPLATE = {
	Version = 1,
	Cash = 0,
	TotalCashEarned = 0,
	TotalFed = 0,
	Rebirths = 0,
	Upgrades = {}, -- [upgradeId] = level
	Zones = { [ZoneConfig.StarterZone] = true },
	Pets = {}, -- [uid] = petId
	EquippedPets = {}, -- { uid }
	NextPetUid = 1,
	Titles = {}, -- [titleId] = true
	EquippedTitle = "",
	Daily = { LastClaimDay = 0, Streak = 0 },
	Boosts = { Cash = 0, Luck = 0 }, -- unix time each boost ends
	Stats = { TimesCaught = 0, PetsHatched = 0, SnacksCollected = 0, PlaySeconds = 0 },
}

type Profile = {
	Data: any,
	Offline: boolean,
	Releasing: boolean,
}

local DataService = {}
DataService.Loaded = Signal.new() -- (player, data)
DataService.Changed = Signal.new() -- (player, key, value)
DataService.Releasing = Signal.new() -- (player, data) just before the final save

local profiles: { [Player]: Profile } = {}
local loadingThreads: { [Player]: { thread } } = {}
local store: DataStore? = nil
local offline = false

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in value do
		copy[key] = deepCopy(inner)
	end
	return copy
end

-- Adds any keys from the template that an older save is missing.
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function initStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if not ok then
		offline = true
		warn("[DataService] DataStores unavailable, using temporary data: " .. tostring(result))
		return
	end
	store = result
	if RunService:IsStudio() then
		local probeOk, probeError = pcall(function()
			return (store :: DataStore):GetAsync("__probe")
		end)
		if not probeOk then
			offline = true
			warn(
				"[DataService] DataStores unavailable in Studio, using temporary data. Publish the place and enable "
					.. "Game Settings > Security > 'Enable Studio Access to API Services' to test saving. ("
					.. tostring(probeError)
					.. ")"
			)
		end
	end
end

-- Returns the saved data, or nil + reason ("locked" | "error").
local function loadFromStore(player: Player): (any?, string?)
	local key = keyFor(player)
	local lastReason = "error"
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedElsewhere = false
		local loaded = nil
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(saved)
				saved = if type(saved) == "table" then saved else {}
				local lock = saved.Lock
				if
					type(lock) == "table"
					and lock.JobId ~= game.JobId
					and os.time() - (tonumber(lock.Time) or 0) < LOCK_EXPIRY
				then
					lockedElsewhere = true
					return nil -- cancel the write, someone else owns this session
				end
				lockedElsewhere = false
				saved.Lock = { JobId = game.JobId, Time = os.time() }
				loaded = saved.Data
				return saved
			end)
		end)
		if ok and not lockedElsewhere then
			return loaded or deepCopy(TEMPLATE), nil
		end
		lastReason = if lockedElsewhere then "locked" else "error"
		if not ok then
			warn(string.format("[DataService] Load attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
		end
		if player.Parent == nil then
			return nil, "left"
		end
		task.wait(math.min(2 ^ attempt, 10))
	end
	return nil, lastReason
end

local function saveToStore(player: Player, profile: Profile, release: boolean): boolean
	if profile.Offline or not store then
		return true
	end
	local lostLock = false
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(saved)
			saved = if type(saved) == "table" then saved else {}
			local lock = saved.Lock
			if type(lock) == "table" and lock.JobId ~= game.JobId then
				lostLock = true
				return nil -- another server took over; never overwrite its data
			end
			saved.Data = profile.Data
			saved.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
			return saved
		end)
	end)
	if not ok then
		warn(string.format("[DataService] Save failed for %s: %s", player.Name, tostring(err)))
		return false
	end
	if lostLock then
		warn(string.format("[DataService] %s's session lock was taken by another server; skipped save", player.Name))
	end
	return true
end

function DataService.IsOffline(): boolean
	return offline
end

function DataService.Get(player: Player): any?
	local profile = profiles[player]
	return profile and profile.Data
end

-- Yields until the player's data is loaded. Returns nil if they leave first.
function DataService.WaitFor(player: Player): any?
	local data = DataService.Get(player)
	if data then
		return data
	end
	if player.Parent == nil then
		return nil
	end
	local waiting = loadingThreads[player]
	if not waiting then
		waiting = {}
		loadingThreads[player] = waiting
	end
	table.insert(waiting, coroutine.running())
	return coroutine.yield()
end

local function resumeWaiting(player: Player, data: any?)
	local waiting = loadingThreads[player]
	loadingThreads[player] = nil
	if waiting then
		for _, thread in waiting do
			task.spawn(thread, data)
		end
	end
end

function DataService.Load(player: Player): any?
	local data, reason
	if offline then
		data = deepCopy(TEMPLATE)
	else
		data, reason = loadFromStore(player)
	end

	if player.Parent == nil then
		resumeWaiting(player, nil)
		return nil
	end
	if not data then
		resumeWaiting(player, nil)
		if reason == "locked" then
			player:Kick("Your data is still saving on another server. Please rejoin in a minute!")
		else
			player:Kick("Roblox couldn't load your data right now (your progress is safe). Please rejoin!")
		end
		return nil
	end

	reconcile(data, TEMPLATE)
	profiles[player] = { Data = data, Offline = offline, Releasing = false }
	resumeWaiting(player, data)
	DataService.Loaded:Fire(player, data)
	if offline then
		Net.Fire(player, "Notify", "Studio test mode: progress will NOT save.", "Info")
	end
	return data
end

-- Sends a top-level key to the client and fires Changed on the server.
function DataService.MarkChanged(player: Player, key: string)
	local data = DataService.Get(player)
	if not data then
		return
	end
	Net.Fire(player, "DataChanged", key, data[key])
	DataService.Changed:Fire(player, key, data[key])
end

function DataService.Set(player: Player, key: string, value: any)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data[key] = value
	DataService.MarkChanged(player, key)
end

function DataService.Increment(player: Player, key: string, amount: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data[key] = (data[key] or 0) + amount
	DataService.MarkChanged(player, key)
end

function DataService.AddCash(player: Player, amount: number)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	data.Cash += amount
	data.TotalCashEarned += amount
	DataService.MarkChanged(player, "Cash")
end

-- Returns true and deducts the cash if the player can afford it.
function DataService.SpendCash(player: Player, amount: number): boolean
	local data = DataService.Get(player)
	if not data or amount < 0 or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	DataService.MarkChanged(player, "Cash")
	return true
end

-- Adds to a counter inside data.Stats without replicating (stats are only
-- read when saving / by leaderboards).
function DataService.AddStat(player: Player, statName: string, amount: number)
	local data = DataService.Get(player)
	if data then
		data.Stats[statName] = (data.Stats[statName] or 0) + amount
	end
end

local function release(player: Player)
	local profile = profiles[player]
	if not profile or profile.Releasing then
		return
	end
	profile.Releasing = true
	DataService.Releasing:Fire(player, profile.Data)
	for attempt = 1, 3 do
		if saveToStore(player, profile, true) then
			break
		end
		task.wait(attempt)
	end
	profiles[player] = nil
end

function DataService.Start()
	initStore()

	Net.Handle("GetData", function(player)
		local data = DataService.WaitFor(player)
		return data ~= nil, if offline then "offline" else nil, data
	end, 2)

	Players.PlayerRemoving:Connect(function(player)
		resumeWaiting(player, nil)
		release(player)
	end)

	task.spawn(function()
		while true do
			task.wait(GameConfig.AutoSaveInterval)
			for player, profile in profiles do
				if not profile.Releasing then
					task.spawn(saveToStore, player, profile, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if offline then
			return
		end
		for player in profiles do
			task.spawn(release, player)
		end
		local deadline = os.clock() + 25
		while next(profiles) ~= nil and os.clock() < deadline do
			task.wait(0.25)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DuckService</string>
            <string name="Source"><![CDATA[-- The Giant Angry Rubber Ducks. Each zone has its own duck(s) that patrol,
-- spot players with a vision cone + line of sight (props block it, so you can
-- hide), chase, and bonk you: ragdoll + drop all your snacks.
--
-- Ducks never leave their zone, so running back into the hub always saves you.
-- Movement is simulated on the server and driven through AlignPosition /
-- AlignOrientation on a server-owned physics root, so clients see it smoothly
-- interpolated.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local SoundConfig = require(Shared.Config.SoundConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local MapLayout = require(Shared.MapLayout)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local FoodService = require(script.Parent.FoodService)
local MapBuilder = require(script.Parent.MapBuilder)
local RagdollService = require(script.Parent.RagdollService)

type Duck = {
	Model: Model,
	Root: BasePart,
	Align: AlignPosition,
	Orient: AlignOrientation,
	ZoneId: string,
	Stats: ZoneConfig.DuckStats,
	Radius: number,
	Hover: number,
	EyeHeight: number,
	Position: Vector3,
	Heading: Vector3,
	State: string, -- "Patrol" | "Idle" | "Chase" | "Celebrate"
	StateUntil: number,
	Target: Player?,
	LastSeenAt: number,
	LastSeenPos: Vector3,
	PatrolPoint: Vector3,
	PatrolUntil: number,
	NextQuack: number,
	Alert: BillboardGui,
	Sounds: { [string]: Sound },
}

local DuckService = {}

local ducks: { Duck } = {}
local chasers: { [Player]: { [Duck]: boolean } } = {}
local rng = Random.new()
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Include

local CLOSE_SENSE = 12 -- studs: ducks "hear" players this close even from behind
local DETECT_TICK = 0.2
local STEER_ANGLES = { 0, 25, -25, 50, -50, 80, -80, 115, -115, 150, -150 }

local function flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function rotateY(vector: Vector3, degrees: number): Vector3
	return CFrame.Angles(0, math.rad(degrees), 0):VectorToWorldSpace(vector)
end

local function sound(
	parent: Instance,
	name: string,
	settings: { Id: string, Volume: number, Speed: number },
	looped: boolean
): Sound
	return Make.Instance("Sound", {
		Name = name,
		SoundId = settings.Id,
		Volume = settings.Volume,
		PlaybackSpeed = settings.Speed,
		Looped = looped,
		RollOffMaxDistance = SoundConfig.Duck.RollOffMaxDistance,
		RollOffMinDistance = 15,
		Parent = parent,
	})
end

-- Builds the greybox duck. Returns the model, its physics root, and how high
-- the root's center sits above the floor.
local function buildGreyboxDuck(stats: ZoneConfig.DuckStats): (Model, BasePart, number)
	local s = stats.Scale
	local model = Make.Instance("Model", { Name = stats.Name })
	local root = Make.Part({
		Name = "Root",
		Size = Vector3.new(6, 6, 6) * s,
		Transparency = 1,
		Parent = model,
	})
	model.PrimaryPart = root
	local yellow = stats.Color
	local orange = Color3.fromRGB(255, 140, 20)

	local function piece(kind: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): BasePart
		local props = {
			Size = size * s,
			CFrame = root.CFrame * CFrame.new(offset.Position * s) * offset.Rotation,
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
			Parent = model,
		}
		if kind == "Ellipsoid" then
			return Make.Ellipsoid(props)
		elseif kind == "Wedge" then
			return Make.Part(props, nil, "WedgePart")
		end
		return Make.Part(props)
	end

	piece("Ellipsoid", Vector3.new(9, 7, 11), CFrame.new(0, 0, 0), yellow)
	piece("Ellipsoid", Vector3.new(7, 6, 6), CFrame.new(0, 0.8, -3.2), yellow)
	piece("Ellipsoid", Vector3.new(6, 6, 6), CFrame.new(0, 4.8, -4.2), yellow)
	piece("Ellipsoid", Vector3.new(1.2, 4, 6), CFrame.new(4.4, 0.6, 0.4), yellow:Lerp(Color3.new(0, 0, 0), 0.12))
	piece("Ellipsoid", Vector3.new(1.2, 4, 6), CFrame.new(-4.4, 0.6, 0.4), yellow:Lerp(Color3.new(0, 0, 0), 0.12))
	piece("Ellipsoid", Vector3.new(3.8, 1.3, 3.4), CFrame.new(0, 4.1, -7.4), orange)
	piece("Ellipsoid", Vector3.new(3, 0.8, 2.6), CFrame.new(0, 3.3, -7), orange:Lerp(Color3.new(0, 0, 0), 0.25))
	piece("Wedge", Vector3.new(3, 2.5, 3), CFrame.new(0, 1.8, 5.6) * CFrame.Angles(0, math.pi, 0), yellow)
	piece("Part", Vector3.new(2.6, 0.5, 3.2), CFrame.new(2, -3.5, -1.5), orange)
	piece("Part", Vector3.new(2.6, 0.5, 3.2), CFrame.new(-2, -3.5, -1.5), orange)
	for _, side in { -1, 1 } do
		local eye = piece(
			"Ellipsoid",
			Vector3.new(1.3, 1.3, 1.3),
			CFrame.new(1.6 * side, 5.6, -6.6),
			Color3.fromRGB(255, 30, 30),
			Enum.Material.Neon
		)
		Make.Instance(
			"PointLight",
			{ Color = Color3.fromRGB(255, 40, 40), Range = 10 * s, Brightness = 2, Parent = eye }
		)
		-- Angry eyebrows slanting down toward the beak.
		piece(
			"Part",
			Vector3.new(2.2, 0.45, 0.5),
			CFrame.new(1.5 * side, 6.7, -6.7) * CFrame.Angles(0, 0, math.rad(-22 * side)),
			Color3.fromRGB(30, 20, 20)
		)
	end
	return model, root, 3.75 * s
end

-- Uses ReplicatedStorage.Assets.Duck if you've added a custom model.
local function buildDuckModel(stats: ZoneConfig.DuckStats): (Model, BasePart, number)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local custom = assets and assets:FindFirstChild("Duck")
	if custom and custom:IsA("Model") then
		local model = custom:Clone()
		model.Name = stats.Name
		pcall(function()
			model:ScaleTo(model:GetScale() * stats.Scale)
		end)
		local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		if root then
			model.PrimaryPart = root
			local boxCFrame, boxSize = model:GetBoundingBox()
			local hover = root.Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
			return model, root, hover
		end
		warn("[DuckService] Assets.Duck has no parts; using the greybox duck")
	end
	return buildGreyboxDuck(stats)
end

local function pickPatrolPoint(duck: Duck)
	for _ = 1, 15 do
		local point = MapLayout.RandomPointInZone(duck.ZoneId, rng, duck.Radius + 8)
		if not MapBuilder.IsBlocked(duck.ZoneId, point, duck.Radius) then
			duck.PatrolPoint = point
			duck.PatrolUntil = os.clock() + 10
			return
		end
	end
	duck.PatrolPoint = MapLayout.GetZoneBounds(duck.ZoneId).Center
	duck.PatrolUntil = os.clock() + 10
end

local function spawnDuck(zone: ZoneConfig.Zone, index: number)
	local stats = zone.Duck
	local model, root, hover = buildDuckModel(stats)
	local s = stats.Scale

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = part ~= root
		end
	end
	Make.WeldAll(model, root)
	root.Anchored = false
	root.Massless = false

	local start = MapLayout.ZoneLocalToWorld(zone.Id, MapLayout.ZoneDepth * 0.6 + index * 12, (index - 1.5) * 30)
	local heading = -MapLayout.GetZoneBounds(zone.Id).Direction
	model:PivotTo(CFrame.lookAt(start + Vector3.new(0, hover, 0), start + Vector3.new(0, hover, 0) + heading))

	local attachment = Make.Instance("Attachment", { Name = "DuckAlign", Parent = root })
	local align = Make.Instance("AlignPosition", {
		Mode = Enum.PositionAlignmentMode.OneAttachment,
		Attachment0 = attachment,
		RigidityEnabled = true,
		Position = start + Vector3.new(0, hover, 0),
		Parent = root,
	})
	local orient = Make.Instance("AlignOrientation", {
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		Attachment0 = attachment,
		RigidityEnabled = true,
		CFrame = CFrame.lookAt(Vector3.zero, heading),
		Parent = root,
	})

	Make.Billboard(
		root,
		Vector2.new(14, 2.4) * math.sqrt(s),
		Vector3.new(0, 9.5 * s, 0),
		"🦆 " .. string.upper(stats.Name),
		{
			TextColor3 = Color3.fromRGB(255, 230, 80),
		}
	)
	local alert = Make.Billboard(root, Vector2.new(5, 5) * s, Vector3.new(0, 13 * s, 0), "❗", {
		TextColor3 = Color3.fromRGB(255, 40, 40),
	})
	alert.Enabled = false

	local sounds = {
		Quack = sound(root, "Quack", SoundConfig.Duck.Quack, false),
		Squeak = sound(root, "Squeak", SoundConfig.Duck.Squeak, false),
		Waddle = sound(root, "Waddle", SoundConfig.Duck.Waddle, true),
	}

	model.Parent = MapBuilder.Folders.Ducks
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local duck: Duck = {
		Model = model,
		Root = root,
		Align = align,
		Orient = orient,
		ZoneId = zone.Id,
		Stats = stats,
		Radius = 5 * s,
		Hover = hover,
		EyeHeight = hover + 4.8 * s,
		Position = Vector3.new(start.X, MapLayout.FloorY, start.Z),
		Heading = heading,
		State = "Patrol",
		StateUntil = 0,
		Target = nil,
		LastSeenAt = 0,
		LastSeenPos = start,
		PatrolPoint = start,
		PatrolUntil = 0,
		NextQuack = os.clock() + rng:NextNumber(4, 10),
		Alert = alert,
		Sounds = sounds,
	}
	pickPatrolPoint(duck)
	table.insert(ducks, duck)
end

local function refreshChased(player: Player)
	local set = chasers[player]
	local name = nil
	if set then
		for duck in set do
			name = duck.Stats.Name
			break
		end
		if not name then
			chasers[player] = nil
		end
	end
	if player.Parent then
		player:SetAttribute("ChasedBy", name)
	end
end

local function targetRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Whether this player is a legal target for this duck right now.
local function isHuntable(duck: Duck, player: Player): (boolean, BasePart?)
	local root = targetRoot(player)
	if not root then
		return false, nil
	end
	local character = player.Character
	if RagdollService.IsRagdolled(character) or RagdollService.IsImmune(character) then
		return false, nil
	end
	if MapLayout.ZoneAt(root.Position) ~= duck.ZoneId then
		return false, nil
	end
	return true, root
end

local function canSee(duck: Duck, root: BasePart, range: number, useCone: boolean): boolean
	local offset = flat(root.Position - duck.Position)
	local distance = offset.Magnitude
	if distance > range then
		return false
	end
	if useCone and distance > CLOSE_SENSE then
		local cosHalf = math.cos(math.rad(duck.Stats.FieldOfView / 2))
		if duck.Heading:Dot(offset.Unit) < cosHalf then
			return false
		end
	end
	local eye = duck.Position + Vector3.new(0, duck.EyeHeight, 0)
	local result = workspace:Raycast(eye, root.Position - eye, losParams)
	return result == nil
end

local function startChase(duck: Duck, player: Player)
	duck.State = "Chase"
	duck.Target = player
	duck.LastSeenAt = os.clock()
	duck.Alert.Enabled = true
	duck.Sounds.Squeak:Play()
	local set = chasers[player] or {}
	set[duck] = true
	chasers[player] = set
	refreshChased(player)
	Net.Fire(player, "Effect", "DuckSpotted", { Duck = duck.Stats.Name })
end

local function stopChase(duck: Duck, notify: boolean)
	local player = duck.Target
	duck.Target = nil
	duck.Alert.Enabled = false
	duck.State = "Patrol"
	pickPatrolPoint(duck)
	if player then
		local set = chasers[player]
		if set then
			set[duck] = nil
		end
		refreshChased(player)
		if notify and player.Parent then
			Net.Fire(player, "Effect", "DuckLost", { Duck = duck.Stats.Name })
		end
	end
end

local function catch(duck: Duck, player: Player, root: BasePart)
	local away = flat(root.Position - duck.Position)
	away = if away.Magnitude > 0.1 then away.Unit else duck.Heading
	local fling = away * GameConfig.CatchFlingSpeed + Vector3.new(0, GameConfig.CatchFlingUp, 0)
	stopChase(duck, false)
	duck.State = "Celebrate"
	duck.StateUntil = os.clock() + 1.6
	duck.Sounds.Quack:Play()
	if RagdollService.Ragdoll(player, GameConfig.RagdollDuration, fling) then
		FoodService.DropCarry(player, root.Position)
		DataService.AddStat(player, "TimesCaught", 1)
		Net.Fire(player, "Effect", "Caught", { Duck = duck.Stats.Name })
		Net.FireAll("Effect", "Bonk", {
			Player = player.DisplayName,
			UserId = player.UserId,
			Duck = duck.Stats.Name,
			Position = root.Position,
		})
	end
end

local function findTarget(duck: Duck): Player?
	local sightRange = duck.Stats.SightRange * EventService.GetDuckSightMultiplier()
	local best, bestScore = nil, math.huge
	for _, player in Players:GetPlayers() do
		local ok, root = isHuntable(duck, player)
		if not ok or not root then
			continue
		end
		if canSee(duck, root, sightRange, true) then
			-- Prefer players carrying lots of snacks.
			local carried = FoodService.GetCarry(player).Total
			local score = (root.Position - duck.Position).Magnitude - carried * 0.5
			if score < bestScore then
				best, bestScore = player, score
			end
		end
	end
	return best
end

local function detectTick()
	local now = os.clock()
	for _, duck in ducks do
		if duck.State == "Celebrate" or duck.State == "Idle" then
			if now >= duck.StateUntil then
				duck.State = "Patrol"
				pickPatrolPoint(duck)
			end
		end

		if duck.State == "Chase" then
			local player = duck.Target :: Player
			local ok, root = isHuntable(duck, player)
			if not ok or not root then
				-- Only say "you escaped" if they weren't just bonked by another duck.
				stopChase(duck, player.Parent ~= nil and not RagdollService.IsRagdolled(player.Character))
				continue
			end
			local chaseRange = duck.Stats.SightRange * EventService.GetDuckSightMultiplier() * 1.4
			if canSee(duck, root, chaseRange, false) then
				duck.LastSeenAt = now
				duck.LastSeenPos = root.Position
			elseif now - duck.LastSeenAt > duck.Stats.GiveUpTime then
				stopChase(duck, true)
			end
		elseif duck.State == "Patrol" or duck.State == "Idle" then
			local target = findTarget(duck)
			if target then
				startChase(duck, target)
			elseif duck.State == "Patrol" then
				local reached = (flat(duck.PatrolPoint - duck.Position)).Magnitude < 3
				if reached or now > duck.PatrolUntil then
					if rng:NextNumber() < 0.3 then
						duck.State = "Idle"
						duck.StateUntil = now + rng:NextNumber(1, 2.5)
					else
						pickPatrolPoint(duck)
					end
				end
			end
		end

		if now >= duck.NextQuack and duck.State ~= "Chase" then
			duck.NextQuack = now + rng:NextNumber(6, 14)
			duck.Sounds.Quack:Play()
		end
	end
end

-- Picks the first clear direction near `desired` (simple whisker steering).
local function steer(duck: Duck, desired: Vector3): Vector3
	local lookAhead = duck.Radius * 2 + 4
	local bounds = MapLayout.GetZoneBounds(duck.ZoneId)
	for _, angle in STEER_ANGLES do
		local direction = rotateY(desired, angle)
		local probe = duck.Position + direction * lookAhead
		local inside = probe.X > bounds.Min.X + duck.Radius
			and probe.X < bounds.Max.X - duck.Radius
			and probe.Z > bounds.Min.Z + duck.Radius
			and probe.Z < bounds.Max.Z - duck.Radius
		if inside and not MapBuilder.IsBlocked(duck.ZoneId, probe, duck.Radius * 0.7) then
			return direction
		end
	end
	return desired
end

local function moveDuck(duck: Duck, dt: number)
	local speedMultiplier = EventService.GetDuckSpeedMultiplier()
	local goal: Vector3? = nil
	local speed = 0
	if duck.State == "Chase" then
		speed = duck.Stats.ChaseSpeed * speedMultiplier
		goal = duck.LastSeenPos
		local root = duck.Target and targetRoot(duck.Target)
		if root and os.clock() - duck.LastSeenAt < 0.3 then
			goal = root.Position
		end
	elseif duck.State == "Patrol" then
		speed = duck.Stats.PatrolSpeed * speedMultiplier
		goal = duck.PatrolPoint
	end

	local moving = false
	if goal then
		local toGoal = flat(goal - duck.Position)
		local distance = toGoal.Magnitude
		if distance > 0.5 then
			moving = true
			local direction = steer(duck, toGoal.Unit)
			local blended = duck.Heading:Lerp(direction, math.min(1, dt * 8))
			duck.Heading = if blended.Magnitude > 0.01 then blended.Unit else direction
			local step = math.min(speed * dt, distance)
			local nextPos = MapLayout.ClampToZone(duck.ZoneId, duck.Position + duck.Heading * step, duck.Radius)
			if not MapBuilder.IsBlocked(duck.ZoneId, nextPos, duck.Radius * 0.6) then
				duck.Position = nextPos
			else
				-- Slide along whichever axis is free.
				local slideX = Vector3.new(nextPos.X, nextPos.Y, duck.Position.Z)
				local slideZ = Vector3.new(duck.Position.X, nextPos.Y, nextPos.Z)
				if not MapBuilder.IsBlocked(duck.ZoneId, slideX, duck.Radius * 0.6) then
					duck.Position = slideX
				elseif not MapBuilder.IsBlocked(duck.ZoneId, slideZ, duck.Radius * 0.6) then
					duck.Position = slideZ
				end
			end
		end
	end

	-- Waddle: bob up and down and rock side to side while moving.
	local t = os.clock()
	local bob, roll = 0, 0
	if moving then
		bob = math.abs(math.sin(t * speed * 0.6)) * 0.5 * duck.Stats.Scale
		roll = math.sin(t * speed * 0.3) * 0.14
	elseif duck.State == "Celebrate" then
		bob = math.abs(math.sin(t * 14)) * 2 * duck.Stats.Scale -- happy bonk hop
	end
	duck.Align.Position = duck.Position + Vector3.new(0, duck.Hover + bob, 0)
	duck.Orient.CFrame = CFrame.lookAt(Vector3.zero, duck.Heading) * CFrame.Angles(0, 0, roll)

	local waddle = duck.Sounds.Waddle
	if moving and not waddle.IsPlaying then
		waddle:Play()
	elseif not moving and waddle.IsPlaying then
		waddle:Stop()
	end
	waddle.PlaybackSpeed = SoundConfig.Duck.Waddle.Speed * math.max(1, speed / 12)

	-- Catch check every frame for responsive bonks.
	if duck.State == "Chase" and duck.Target then
		local root = targetRoot(duck.Target)
		if root then
			local offset = flat(root.Position - duck.Position)
			if offset.Magnitude <= duck.Stats.CatchRadius and math.abs(root.Position.Y - duck.Position.Y) < 14 then
				local ok = isHuntable(duck, duck.Target)
				if ok then
					catch(duck, duck.Target, root)
				end
			end
		end
	end
end

function DuckService.Start()
	losParams.FilterDescendantsInstances = MapBuilder.StaticGeometry
	for _, zone in ZoneConfig.List do
		for index = 1, zone.Duck.Count do
			spawnDuck(zone, index)
		end
	end

	RunService.Heartbeat:Connect(function(dt)
		for _, duck in ducks do
			moveDuck(duck, dt)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(DETECT_TICK)
			detectTick()
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, duck in ducks do
			if duck.Target == player then
				stopChase(duck, false)
			end
		end
		chasers[player] = nil
	end)
end

return DuckService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- Random server-wide events plus the Capy Feast. Active events are published
-- as attributes on ReplicatedStorage.GameState ("Event_<Id>" = server time the
-- event ends, 0 when inactive) so every client can show banners and timers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EventConfig = require(Shared.Config.EventConfig)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local FoodService = require(script.Parent.FoodService)

local EventService = {}
EventService.Started = Signal.new() -- (eventId)
EventService.Ended = Signal.new() -- (eventId)

local gameState: Folder = Make.Instance("Folder", { Name = "GameState", Parent = ReplicatedStorage })
local active: { [string]: { EndsAt: number, Token: number } } = {}
local defaultGravity = workspace.Gravity
local tokenCounter = 0
local rng = Random.new()

function EventService.GetGameState(): Folder
	return gameState
end

function EventService.IsActive(eventId: string): boolean
	return active[eventId] ~= nil
end

local function product(field: string): number
	local total = 1
	for eventId in active do
		local value = (EventConfig.Events[eventId] :: any)[field]
		if value then
			total *= value
		end
	end
	return total
end

function EventService.GetCashMultiplier(): number
	return product("CashMultiplier")
end

function EventService.GetDuckSpeedMultiplier(): number
	return product("DuckSpeedMultiplier")
end

function EventService.GetDuckSightMultiplier(): number
	return product("DuckSightMultiplier")
end

local function applyGravity()
	local gravity = defaultGravity
	for eventId in active do
		local eventGravity = EventConfig.Events[eventId].Gravity
		if eventGravity then
			gravity = math.min(gravity, eventGravity)
		end
	end
	workspace.Gravity = gravity
end

function EventService.End(eventId: string)
	if not active[eventId] then
		return
	end
	active[eventId] = nil
	gameState:SetAttribute("Event_" .. eventId, 0)
	applyGravity()
	Net.FireAll("Effect", "EventEnd", { Id = eventId })
	EventService.Ended:Fire(eventId)
end

-- Starts (or extends) an event.
function EventService.Trigger(eventId: string, durationOverride: number?)
	local event = EventConfig.Events[eventId]
	assert(event, "Unknown event " .. tostring(eventId))
	local duration = durationOverride or event.Duration
	local endsAt = workspace:GetServerTimeNow() + duration
	local wasActive = active[eventId] ~= nil

	tokenCounter += 1
	local token = tokenCounter
	active[eventId] = { EndsAt = endsAt, Token = token }
	gameState:SetAttribute("Event_" .. eventId, endsAt)
	applyGravity()

	if not wasActive then
		if event.GoldenFoodPerZone then
			FoodService.SpawnGolden(event.GoldenFoodPerZone, duration + 15)
		end
		Net.FireAll("Effect", "EventStart", { Id = eventId })
		EventService.Started:Fire(eventId)
	end

	task.delay(duration, function()
		local current = active[eventId]
		if current and current.Token == token then
			EventService.End(eventId)
		end
	end)
end

local function randomEventLoop()
	local candidates = {}
	for _, event in EventConfig.Events do
		if event.Weight > 0 then
			table.insert(candidates, event)
		end
	end
	if #candidates == 0 then
		return
	end
	task.wait(EventConfig.FirstEventDelay)
	while true do
		local event = WeightedRandom.Pick(candidates, rng)
		EventService.Trigger(event.Id)
		task.wait(event.Duration)
		task.wait(rng:NextNumber(EventConfig.IntervalMin, EventConfig.IntervalMax))
	end
end

function EventService.Start()
	for eventId in EventConfig.Events do
		gameState:SetAttribute("Event_" .. eventId, 0)
	end
	task.spawn(randomEventLoop)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">FoodService</string>
            <string name="Source"><![CDATA[-- Snacks: spawning in zones, magnet pickup, snack-machine clicks, the stack of
-- snacks on your back, and dropping it all when a duck bonks you.
--
-- Pickup is server-driven (players just walk near snacks), so it can't be
-- exploited by firing remotes and works the same with any input device.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FoodConfig = require(Shared.Config.FoodConfig)
local GameConfig = require(Shared.Config.GameConfig)
local ZoneConfig = require(Shared.Config.ZoneConfig)
local Formulas = require(Shared.Formulas)
local MapLayout = require(Shared.MapLayout)
local Make = require(Shared.Util.Make)
local Net = require(Shared.Net)
local WeightedRandom = require(Shared.Util.WeightedRandom)

local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

type FoodEntry = {
	Part: BasePart,
	FoodId: string,
	Count: number,
	ZoneId: string,
	Natural: boolean, -- counts toward the zone's spawn cap
	ReadyAt: number, -- can't be picked up before this (while falling)
}

type Carry = {
	Total: number,
	Items: { [string]: number },
}

local FoodService = {}

local rng = Random.new()
local foodsByZone: { [string]: { [BasePart]: FoodEntry } } = {}
local naturalCount: { [string]: number } = {}
local carries: { [Player]: Carry } = {}
local lastClick: { [Player]: number } = {}

local PICKUP_TICK = 0.1

local function getCarry(player: Player): Carry
	local carry = carries[player]
	if not carry then
		carry = { Total = 0, Items = {} }
		carries[player] = carry
	end
	return carry
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function canAct(player: Player): boolean
	local character = player.Character
	return character ~= nil and not character:GetAttribute("Ragdolled")
end

-- Rebuilds the snack tower welded to the player's back.
local function updateCarryVisual(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local old = character:FindFirstChild("SnackStack")
	if old then
		old:Destroy()
	end
	local carry = getCarry(player)
	if carry.Total <= 0 then
		return
	end

	local stack = Make.Instance("Model", { Name = "SnackStack" })
	-- Show the most valuable snacks at the top of the tower.
	local order = {}
	for foodId, count in carry.Items do
		table.insert(order, { FoodId = foodId, Count = count })
	end
	table.sort(order, function(a, b)
		return FoodConfig[a.FoodId].Value < FoodConfig[b.FoodId].Value
	end)
	local shown = 0
	local maxShown = math.min(GameConfig.MaxCarryVisual, carry.Total)
	local height = 0
	for _, entry in order do
		local food = FoodConfig[entry.FoodId]
		for _ = 1, entry.Count do
			if shown >= maxShown then
				break
			end
			shown += 1
			local size = 1.2
			local part = Make.Part({
				Name = "Snack",
				Anchored = false,
				Massless = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Size = Vector3.new(size * 1.3, size, size * 1.3),
				Color = food.Color,
				Material = if food.Golden then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				Parent = stack,
			})
			local wobble = CFrame.Angles(0, math.rad(rng:NextNumber(-25, 25)), math.rad(rng:NextNumber(-8, 8)))
			Make.Instance("Weld", {
				Part0 = torso,
				Part1 = part,
				C0 = CFrame.new(0, -torso.Size.Y / 2 + height + size / 2, torso.Size.Z / 2 + 0.9) * wobble,
				Parent = part,
			})
			height += size * 0.95
		end
	end
	if carry.Total > maxShown then
		Make.Billboard(
			stack:FindFirstChildWhichIsA("BasePart") :: BasePart,
			Vector2.new(4, 1.5),
			Vector3.new(0, height + 1, 0),
			"x" .. carry.Total,
			{ TextColor3 = Color3.fromRGB(255, 230, 90) }
		)
	end
	stack.Parent = character
end

local function setCarryAttributes(player: Player)
	local data = DataService.Get(player)
	player:SetAttribute("Carry", getCarry(player).Total)
	if data then
		player:SetAttribute("CarryCapacity", Formulas.CarryCapacity(data))
	end
end

local function onCarryChanged(player: Player)
	setCarryAttributes(player)
	updateCarryVisual(player)
end

-- Adds up to `count` snacks; returns how many fit.
function FoodService.AddToCarry(player: Player, foodId: string, count: number): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local carry = getCarry(player)
	local space = Formulas.CarryCapacity(data) - carry.Total
	local added = math.clamp(count, 0, math.max(space, 0))
	if added > 0 then
		carry.Items[foodId] = (carry.Items[foodId] or 0) + added
		carry.Total += added
		DataService.AddStat(player, "SnacksCollected", added)
		onCarryChanged(player)
	end
	return added
end

function FoodService.GetCarry(player: Player): Carry
	return getCarry(player)
end

-- Empties the player's carry and returns what they had.
function FoodService.TakeCarry(player: Player): ({ [string]: number }, number)
	local carry = getCarry(player)
	local items, total = carry.Items, carry.Total
	carries[player] = { Total = 0, Items = {} }
	onCarryChanged(player)
	return items, total
end

local function createFoodPart(food: FoodConfig.Food, count: number): BasePart
	local size = food.Size
	local shape = if food.Shape == "Ball"
		then Enum.PartType.Ball
		elseif food.Shape == "Cylinder" then Enum.PartType.Cylinder
		else Enum.PartType.Block
	local partSize = if food.Shape == "Cylinder"
		then Vector3.new(size * 0.45, size, size)
		elseif food.Shape == "Ball" then Vector3.new(size, size, size)
		else Vector3.new(size, size * 0.6, size * 0.8)
	local part = Make.Part({
		Name = food.Id,
		Shape = shape,
		Size = partSize,
		Color = food.Color,
		Material = if food.Golden then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	Make.Billboard(part, Vector2.new(3, 3), Vector3.new(0, size * 0.9 + 0.8, 0), food.Emoji, {
		TextStrokeTransparency = 1,
	}).MaxDistance =
		90
	if food.Golden then
		Make.Instance("PointLight", { Color = food.Color, Range = 10, Brightness = 2, Parent = part })
		Make.Instance("Sparkles", { SparkleColor = food.Color, Parent = part })
	end
	if count > 1 then
		Make.Billboard(part, Vector2.new(3, 1.2), Vector3.new(0, size * 0.9 + 2.6, 0), "x" .. count, {
			Name = "CountLabel",
			TextColor3 = Color3.fromRGB(255, 230, 90),
		})
	end
	part:SetAttribute("FoodId", food.Id)
	CollectionService:AddTag(part, "Food")
	return part
end

local function removeFood(entry: FoodEntry)
	local zoneFoods = foodsByZone[entry.ZoneId]
	if zoneFoods and zoneFoods[entry.Part] then
		zoneFoods[entry.Part] = nil
		if entry.Natural then
			naturalCount[entry.ZoneId] -= 1
		end
	end
	entry.Part:Destroy()
end

-- Spawns one snack lying in a zone. `dropFrom` makes it fall from that
-- height first (golden rain, dropped loot).
local function spawnFood(
	zoneId: string,
	foodId: string,
	position: Vector3,
	count: number,
	natural: boolean,
	lifetime: number?,
	dropFrom: number?
): FoodEntry
	local food = FoodConfig[foodId]
	local part = createFoodPart(food, count)
	local restY = MapLayout.FloorY + food.Size / 2 + 1
	local target = CFrame.new(position.X, restY, position.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local readyAt = os.clock()
	if dropFrom then
		part.CFrame = target + Vector3.new(0, dropFrom, 0)
		local fallTime = math.clamp(dropFrom / 40, 0.35, 1.4)
		TweenService:Create(part, TweenInfo.new(fallTime, Enum.EasingStyle.Bounce), { CFrame = target }):Play()
		readyAt += fallTime * 0.6
	else
		part.CFrame = target
	end
	part.Parent = MapBuilder.Folders.Food

	local entry: FoodEntry = {
		Part = part,
		FoodId = foodId,
		Count = count,
		ZoneId = zoneId,
		Natural = natural,
		ReadyAt = readyAt,
	}
	foodsByZone[zoneId][part] = entry
	if natural then
		naturalCount[zoneId] += 1
	end
	if lifetime then
		task.delay(lifetime, function()
			if foodsByZone[zoneId][part] then
				removeFood(entry)
			end
		end)
	end
	return entry
end

local function findSpawnPoint(zoneId: string, margin: number): Vector3?
	for _ = 1, 12 do
		local point = MapLayout.RandomPointInZone(zoneId, rng, margin)
		if not MapBuilder.IsBlocked(zoneId, point, 3) then
			return point
		end
	end
	return nil
end

-- Golden rain: drops `perZone` golden snacks into every zone.
function FoodService.SpawnGolden(perZone: number, lifetime: number)
	for _, zone in ZoneConfig.List do
		for _ = 1, perZone do
			local point = findSpawnPoint(zone.Id, 10)
			if point then
				spawnFood(zone.Id, zone.GoldenFood, point, 1, false, lifetime, rng:NextNumber(40, 70))
			end
		end
	end
end

-- Scatters everything the player is carrying around a position. Anyone
-- (including the victim) can pick it back up for a while.
function FoodService.DropCarry(player: Player, position: Vector3)
	local items, total = FoodService.TakeCarry(player)
	if total <= 0 then
		return
	end
	local zoneId = MapLayout.ZoneAt(position)
	if not zoneId then
		return -- dropped in the hub (shouldn't happen, ducks stay in zones)
	end
	local perPiece = math.max(1, math.ceil(total / GameConfig.MaxDroppedPieces))
	for foodId, count in items do
		local remaining = count
		while remaining > 0 do
			local pieceCount = math.min(perPiece, remaining)
			remaining -= pieceCount
			local angle = rng:NextNumber(0, math.pi * 2)
			local distance = rng:NextNumber(5, 12)
			local point = position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
			point = MapLayout.ClampToZone(zoneId, point, 4)
			spawnFood(zoneId, foodId, point, pieceCount, false, GameConfig.DroppedFoodLifetime, 8)
		end
	end
end

local function spawnLoop(zone: ZoneConfig.Zone)
	-- Start each zone half full so it never feels empty.
	for _ = 1, math.floor(zone.SpawnCap / 2) do
		local point = findSpawnPoint(zone.Id, 8)
		if point then
			spawnFood(zone.Id, WeightedRandom.Pick(zone.Foods, rng).Id, point, 1, true)
		end
	end
	while true do
		task.wait(zone.SpawnInterval)
		if naturalCount[zone.Id] < zone.SpawnCap then
			local point = findSpawnPoint(zone.Id, 8)
			if point then
				spawnFood(zone.Id, WeightedRandom.Pick(zone.Foods, rng).Id, point, 1, true, nil, 6)
			end
		end
	end
end

local function pickupTick()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local data = DataService.Get(player)
		local root = rootOf(player)
		if not data or not root or not canAct(player) then
			continue
		end
		local zoneId = MapLayout.ZoneAt(root.Position)
		if not zoneId or not data.Zones[zoneId] then
			continue
		end
		local carry = getCarry(player)
		local capacity = Formulas.CarryCapacity(data)
		if carry.Total >= capacity then
			continue
		end
		local range = Formulas.PickupRange(data)
		local rootPosition = root.Position
		for part, entry in foodsByZone[zoneId] do
			if entry.ReadyAt > now then
				continue
			end
			local offset = part.Position - rootPosition
			if offset.X * offset.X + offset.Z * offset.Z > range * range or math.abs(offset.Y) > 10 then
				continue
			end
			local added = FoodService.AddToCarry(player, entry.FoodId, entry.Count)
			if added <= 0 then
				break
			end
			Net.Fire(player, "Effect", "Pickup", {
				FoodId = entry.FoodId,
				Count = added,
				Position = part.Position,
				Full = carry.Total >= capacity,
			})
			if added >= entry.Count then
				removeFood(entry)
			else
				entry.Count -= added
				local label = part:FindFirstChild("CountLabel")
				if label then
					(label:FindFirstChildOfClass("TextLabel") :: TextLabel).Text = "x" .. entry.Count
				end
			end
			if carry.Total >= capacity then
				break
			end
		end
	end
end

local function onMachineClicked(player: Player, machine: BasePart)
	local data = DataService.Get(player)
	local root = rootOf(player)
	if not data or not root or not canAct(player) then
		return
	end
	local zoneId = machine:GetAttribute("ZoneId")
	if not data.Zones[zoneId] then
		return
	end
	if (root.Position - machine.Position).Magnitude > GameConfig.MachineClickRange + 4 then
		return
	end
	local now = os.clock()
	if now - (lastClick[player] or 0) < GameConfig.ClickCooldown then
		return
	end
	lastClick[player] = now

	local foodId = machine:GetAttribute("FoodId")
	local added = FoodService.AddToCarry(player, foodId, Formulas.ClickPower(data))
	local carry = getCarry(player)
	Net.Fire(player, "Effect", "MachineClick", {
		FoodId = foodId,
		Count = added,
		Position = machine.Position + Vector3.new(0, 4, 0),
		Full = carry.Total >= Formulas.CarryCapacity(data),
	})
end

function FoodService.Start()
	for _, zone in ZoneConfig.List do
		foodsByZone[zone.Id] = {}
		naturalCount[zone.Id] = 0
		task.spawn(spawnLoop, zone)
	end

	for _, machine in MapBuilder.Machines do
		local detector = machine:FindFirstChildOfClass("ClickDetector")
		if detector then
			detector.MouseClick:Connect(function(player)
				onMachineClicked(player, machine)
			end)
		end
	end

	task.spawn(function()
		while true do
			task.wait(PICKUP_TICK)
			pickupTick()
		end
	end)

	DataService.Changed:Connect(function(player, key)
		if key == "Upgrades" then
			setCarryAttributes(player)
		end
	end)
	DataService.Loaded:Connect(function(player)
		setCarryAttributes(player)
	end)

	local function onPlayerAdded(player: Player)
		player.CharacterAdded:Connect(function()
			-- Respawning loses whatever you were carrying.
			carries[player] = { Total = 0, Items = {} }
			setCarryAttributes(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		carries[player] = nil
		lastClick[player] = nil
	end)
end

return FoodService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- In-server leaderstats plus global leaderboards (OrderedDataStores) on the
-- boards in the hub. Global boards need a published place with API access.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)

local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local LeaderboardService = {}

local BOARDS = {
	{ Id = "TotalFed", Key = "TotalFed", Suffix = " 🍔" },
	{ Id = "Rebirths", Key = "Rebirths", Suffix = " 🔁" },
}

local stores: { [string]: OrderedDataStore } = {}
local nameCache: { [number]: string } = {}

local function setupLeaderstats(player: Player, data: any)
	local stats = Make.Instance("Folder", { Name = "leaderstats" })
	Make.Instance("StringValue", { Name = "Cash", Value = Format.Cash(data.Cash), Parent = stats })
	Make.Instance("IntValue", { Name = "Rebirths", Value = data.Rebirths, Parent = stats })
	stats.Parent = player
end

local function updateLeaderstat(player: Player, key: string, value: any)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		return
	end
	if key == "Cash" then
		(stats:FindFirstChild("Cash") :: StringValue).Value = Format.Cash(value)
	elseif key == "Rebirths" then
		(stats:FindFirstChild("Rebirths") :: IntValue).Value = value
	end
end

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else "Player " .. userId
	nameCache[userId] = result
	return result
end

local function writeScores(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	for _, board in BOARDS do
		local store = stores[board.Id]
		if store then
			local value = math.floor(tonumber(data[board.Key]) or 0)
			if value > 0 then
				pcall(function()
					store:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end
end

local function refreshBoards()
	for _, board in BOARDS do
		local gui = MapBuilder.Boards[board.Id]
		local store = stores[board.Id]
		if not gui then
			continue
		end
		if not store then
			gui.Status.Text = "Publish the game to enable global boards"
			continue
		end
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, GameConfig.LeaderboardSize)
		end)
		if not ok then
			gui.Status.Text = "Couldn't load (retrying soon)"
			continue
		end
		local entries = pages:GetCurrentPage()
		for index, row in gui.Rows do
			local entry = entries[index]
			if entry then
				local medal = if index == 1
					then "🥇"
					elseif index == 2 then "🥈"
					elseif index == 3 then "🥉"
					else "#" .. index
				row.Text = string.format(
					"%s %s  %s",
					medal,
					nameOf(tonumber(entry.key) or 0),
					Make.Colored(Format.Abbreviate(entry.value) .. board.Suffix, Color3.fromRGB(255, 220, 90))
				)
			else
				row.Text = ""
			end
		end
		gui.Status.Text = "Global top "
			.. GameConfig.LeaderboardSize
			.. " · updates every "
			.. GameConfig.LeaderboardRefresh
			.. "s"
	end
end

function LeaderboardService.Start()
	if not DataService.IsOffline() then
		for _, board in BOARDS do
			local ok, store = pcall(function()
				return DataStoreService:GetOrderedDataStore("FeedTheGiantCapy_" .. board.Id .. "_v1")
			end)
			if ok then
				stores[board.Id] = store
			end
		end
	end

	DataService.Loaded:Connect(setupLeaderstats)
	DataService.Changed:Connect(updateLeaderstat)
	DataService.Releasing:Connect(function(player)
		writeScores(player)
	end)

	task.spawn(function()
		while true do
			refreshBoards()
			task.wait(GameConfig.LeaderboardRefresh)
			for _, player in Players:GetPlayers() do
				task.spawn(writeScores, player)
			end
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Builds the greybox map at runtime: hub, zones, walls, gates, props, snack
-- machines, egg stands, shop stalls, leaderboards and lighting.
--
-- Everything is generated from MapLayout + ZoneConfig, so changing a zone's
-- size or adding a zone in config is enough to rebuild the map.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared.Config
local FoodConfig = require(Config.FoodConfig)
local GameConfig = require(Config.GameConfig)
local PetConfig = require(Config.PetConfig)
local RarityConfig = require(Config.RarityConfig)
local ZoneConfig = require(Config.ZoneConfig)
local Format = require(Shared.Util.Format)
local Make = require(Shared.Util.Make)
local MapLayout = require(Shared.MapLayout)
local WeightedRandom = require(Shared.Util.WeightedRandom)

export type Obstacle = { Center: Vector3, Half: Vector3 }

local MapBuilder = {
	Map = nil :: Folder?,
	Folders = {} :: { [string]: Folder },
	Obstacles = {} :: { [string]: { Obstacle } }, -- [zoneId]
	Machines = {} :: { BasePart },
	Gates = {} :: { [string]: BasePart },
	EggStands = {} :: { { Part: BasePart, EggId: string, Prompt: ProximityPrompt } },
	Boards = {} :: { [string]: { Rows: { TextLabel }, Status: TextLabel } },
	Spawn = nil :: SpawnLocation?,
	StaticGeometry = {} :: { Instance }, -- for duck line-of-sight raycasts
}

local WALL_THICKNESS = 4

-- World-space XZ bounding box of a part (handles 90 degree rotations).
local function aabbOf(part: BasePart, padding: number): Obstacle
	local cf = part.CFrame
	local half = part.Size / 2
	local function extent(axis: Vector3): number
		return math.abs(cf.RightVector:Dot(axis)) * half.X
			+ math.abs(cf.UpVector:Dot(axis)) * half.Y
			+ math.abs(cf.LookVector:Dot(axis)) * half.Z
	end
	return {
		Center = Vector3.new(cf.Position.X, 0, cf.Position.Z),
		Half = Vector3.new(extent(Vector3.xAxis) + padding, 0, extent(Vector3.zAxis) + padding),
	}
end

local function overlaps(a: Obstacle, b: Obstacle): boolean
	return math.abs(a.Center.X - b.Center.X) < a.Half.X + b.Half.X
		and math.abs(a.Center.Z - b.Center.Z) < a.Half.Z + b.Half.Z
end

local function folder(name: string, parent: Instance): Folder
	local f = Make.Instance("Folder", { Name = name, Parent = parent })
	MapBuilder.Folders[name] = f
	return f
end

local function buildLighting()
	Make.Instance("Atmosphere", {
		Density = 0.28,
		Offset = 0.1,
		Color = Color3.fromRGB(255, 220, 240),
		Decay = Color3.fromRGB(120, 110, 200),
		Glare = 0.3,
		Haze = 1.2,
		Parent = Lighting,
	})
	Make.Instance("BloomEffect", { Intensity = 0.6, Size = 24, Threshold = 1.6, Parent = Lighting })
	Make.Instance("ColorCorrectionEffect", {
		Name = "MapColor",
		Saturation = 0.2,
		Contrast = 0.05,
		Parent = Lighting,
	})
	Make.Instance("SunRaysEffect", { Intensity = 0.08, Spread = 0.6, Parent = Lighting })
	if not Lighting:FindFirstChildOfClass("Sky") then
		Make.Instance("Sky", { Parent = Lighting })
	end
end

-- A wall segment between two XZ points.
local function wall(from: Vector3, to: Vector3, color: Color3, parent: Instance): Part
	local mid = (from + to) / 2
	local length = (to - from).Magnitude
	local direction = (to - from).Unit
	local part = Make.Part({
		Name = "Wall",
		Size = Vector3.new(WALL_THICKNESS, MapLayout.WallHeight, length + WALL_THICKNESS),
		CFrame = CFrame.lookAt(
			Vector3.new(mid.X, MapLayout.FloorY + MapLayout.WallHeight / 2, mid.Z),
			Vector3.new(mid.X, MapLayout.FloorY + MapLayout.WallHeight / 2, mid.Z) + direction
		),
		Color = color,
		Parent = parent,
	})
	return part
end

local function buildHub()
	local hubFolder = MapBuilder.Folders.Hub
	local half = MapLayout.HubHalf

	Make.Part({
		Name = "HubFloor",
		Size = Vector3.new(half * 2, 4, half * 2),
		Position = Vector3.new(0, MapLayout.FloorY - 2, 0),
		Color = Color3.fromRGB(235, 220, 255),
		Parent = hubFolder,
	})

	-- Colored paths from the capy to each gate.
	for _, zone in ZoneConfig.List do
		local direction = zone.Direction.Unit
		local length = half - 8
		local center = direction * (8 + length / 2)
		Make.Part({
			Name = "Path_" .. zone.Id,
			Size = if math.abs(direction.X) > 0.5
				then Vector3.new(length, 0.2, MapLayout.GateWidth - 6)
				else Vector3.new(MapLayout.GateWidth - 6, 0.2, length),
			Position = Vector3.new(center.X, MapLayout.FloorY + 0.1, center.Z),
			Color = zone.FloorColor,
			CanCollide = false,
			Parent = hubFolder,
		})
	end

	-- Hub walls with a gap for each zone's gate.
	local wallColor = Color3.fromRGB(170, 140, 230)
	local gap = MapLayout.GateWidth / 2
	for _, zone in ZoneConfig.List do
		local d = zone.Direction.Unit
		local side = Vector3.new(-d.Z, 0, d.X)
		local edge = d * (half + WALL_THICKNESS / 2)
		MapBuilder.StaticGeometry[#MapBuilder.StaticGeometry + 1] =
			wall(edge + side * gap, edge + side * half, wallColor, MapBuilder.Folders.Walls)
		MapBuilder.StaticGeometry[#MapBuilder.StaticGeometry + 1] =
			wall(edge - side * gap, edge - side * half, wallColor, MapBuilder.Folders.Walls)
	end

	-- Spawn pad, facing the capybara.
	local spawnPos = MapLayout.SpawnPosition + Vector3.new(0, 0.5, 0)
	MapBuilder.Spawn = Make.Part({
		Name = "Spawn",
		Size = Vector3.new(14, 1, 14),
		CFrame = CFrame.lookAt(spawnPos, Vector3.new(0, spawnPos.Y, 0)),
		Color = Color3.fromRGB(255, 120, 200),
		Material = Enum.Material.Neon,
		Neutral = true,
		Duration = 0,
		CanCollide = true,
		Parent = hubFolder,
	}, nil, "SpawnLocation")

	local safeSign = Make.Part({
		Name = "SafeSign",
		Size = Vector3.new(24, 6, 1),
		CFrame = CFrame.lookAt(spawnPos + Vector3.new(0, 10, 0), Vector3.new(0, 10, 0)) * CFrame.new(0, 0, 9),
		Color = Color3.fromRGB(60, 40, 100),
		Parent = hubFolder,
	})
	Make.SurfaceText(safeSign, Enum.NormalId.Front, "🏠 CAPY HUB · SAFE ZONE 🏠")
	Make.SurfaceText(safeSign, Enum.NormalId.Back, "🏠 CAPY HUB · SAFE ZONE 🏠")
end

local function buildGate(zone: ZoneConfig.Zone)
	local d = zone.Direction.Unit
	local gatePos = d * (MapLayout.HubHalf + WALL_THICKNESS / 2)
	local facingHub = -d

	-- Arch sign over the gate (both sides).
	local signPos = Vector3.new(gatePos.X, MapLayout.FloorY + MapLayout.WallHeight + 3, gatePos.Z)
	local sign = Make.Part({
		Name = "GateSign_" .. zone.Id,
		Size = Vector3.new(MapLayout.GateWidth + 8, 6, WALL_THICKNESS),
		CFrame = CFrame.lookAt(signPos, signPos + facingHub),
		Color = zone.WallColor,
		Parent = MapBuilder.Folders.Gates,
	})
	local label = zone.Emoji .. " " .. string.upper(zone.Name)
	Make.SurfaceText(sign, Enum.NormalId.Front, label)
	Make.SurfaceText(sign, Enum.NormalId.Back, label)

	if zone.Cost <= 0 then
		return
	end

	local centerPos = Vector3.new(gatePos.X, MapLayout.FloorY + MapLayout.WallHeight / 2, gatePos.Z)
	local gate = Make.Part({
		Name = "Gate_" .. zone.Id,
		Size = Vector3.new(MapLayout.GateWidth, MapLayout.WallHeight, 2),
		CFrame = CFrame.lookAt(centerPos, centerPos + facingHub),
		Color = zone.FloorColor,
		Material = Enum.Material.ForceField,
		Transparency = 0.1,
		CanCollide = true,
		Parent = MapBuilder.Folders.Gates,
	})
	gate:SetAttribute("ZoneId", zone.Id)
	local lockText = string.format(
		'🔒 %s\n%s\n<font size="40">walk up & press E</font>',
		string.upper(zone.Name),
		Format.Cash(zone.Cost)
	)
	Make.SurfaceText(gate, Enum.NormalId.Front, lockText, { Name = "LockText" })

	local attachment = Make.Instance("Attachment", {
		Position = Vector3.new(0, -MapLayout.WallHeight / 2 + 4, -2),
		Parent = gate,
	})
	Make.Instance("ProximityPrompt", {
		Name = "UnlockPrompt",
		ActionText = "Unlock " .. Format.Cash(zone.Cost),
		ObjectText = zone.Emoji .. " " .. zone.Name,
		HoldDuration = 0.25,
		MaxActivationDistance = 14,
		RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E,
		Parent = attachment,
	})
	CollectionService:AddTag(gate, "ZoneGate")
	MapBuilder.Gates[zone.Id] = gate
end

local function buildMachine(zone: ZoneConfig.Zone, forward: number, right: number, parent: Instance): BasePart
	local food = FoodConfig[zone.MachineFood]
	local bounds = MapLayout.GetZoneBounds(zone.Id)
	local rightVector = Vector3.new(-bounds.Direction.Z, 0, bounds.Direction.X)
	local position = MapLayout.ZoneLocalToWorld(zone.Id, forward, right) + Vector3.new(0, 7, 0)
	-- Face the zone's center line so players see the screen coming in.
	local facing = if right < 0 then rightVector else -rightVector

	local body = Make.Part({
		Name = "SnackMachine",
		Size = Vector3.new(10, 14, 7),
		CFrame = CFrame.lookAt(position, position + facing),
		Color = zone.WallColor,
		Parent = parent,
	})
	local screen = Make.Part({
		Name = "Screen",
		Size = Vector3.new(8, 8, 0.4),
		CFrame = body.CFrame * CFrame.new(0, 1.5, -3.6),
		Color = food.Color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false, -- let mouse clicks pass through to the body's ClickDetector
		Parent = body,
	})
	Make.SurfaceText(
		screen,
		Enum.NormalId.Front,
		string.format('%s\n%s\n<font size="28">CLICK ME!</font>', food.Emoji, zone.MachineName),
		{ TextColor3 = Color3.new(1, 1, 1) }
	)
	Make.Instance("ClickDetector", {
		MaxActivationDistance = GameConfig.MachineClickRange,
		Parent = body,
	})
	body:SetAttribute("ZoneId", zone.Id)
	body:SetAttribute("FoodId", zone.MachineFood)
	CollectionService:AddTag(body, "SnackMachine")
	table.insert(MapBuilder.Machines, body)
	return body
end

local function buildZone(zone: ZoneConfig.Zone)
	local bounds = MapLayout.GetZoneBounds(zone.Id)
	local zoneFolder = Make.Instance("Folder", { Name = zone.Id, Parent = MapBuilder.Folders.Zones })
	local obstacles: { Obstacle } = {}
	MapBuilder.Obstacles[zone.Id] = obstacles

	Make.Part({
		Name = "Floor",
		Size = Vector3.new(bounds.Size.X, 4, bounds.Size.Z),
		Position = Vector3.new(bounds.Center.X, MapLayout.FloorY - 2, bounds.Center.Z),
		Color = zone.FloorColor,
		Parent = zoneFolder,
	})

	-- Outer walls on the three sides that don't touch the hub.
	local d = bounds.Direction
	local side = Vector3.new(-d.Z, 0, d.X)
	local near = d * MapLayout.HubHalf
	local far = d * (MapLayout.HubHalf + MapLayout.ZoneDepth + WALL_THICKNESS / 2)
	local halfWidth = MapLayout.ZoneHalfWidth + WALL_THICKNESS / 2
	local walls = {
		wall(near + side * halfWidth, far + side * halfWidth, zone.WallColor, zoneFolder),
		wall(near - side * halfWidth, far - side * halfWidth, zone.WallColor, zoneFolder),
		wall(far + side * halfWidth, far - side * halfWidth, zone.WallColor, zoneFolder),
	}
	for _, w in walls do
		table.insert(MapBuilder.StaticGeometry, w)
	end

	buildGate(zone)

	-- Snack machines first so props never spawn on top of them.
	local machineSpots = {
		{ MapLayout.ZoneDepth * 0.36, -MapLayout.ZoneHalfWidth + 14 },
		{ MapLayout.ZoneDepth * 0.74, MapLayout.ZoneHalfWidth - 14 },
	}
	for _, spot in machineSpots do
		local machine = buildMachine(zone, spot[1], spot[2], zoneFolder)
		table.insert(obstacles, aabbOf(machine, 0))
		table.insert(MapBuilder.StaticGeometry, machine)
	end

	-- Giant snack-box props to hide behind. Seeded so the layout is the same
	-- on every server.
	local rng = Random.new(zone.Order * 7919)
	local placed = 0
	local tries = 0
	local emojis = {}
	for _, entry in zone.Foods do
		table.insert(emojis, FoodConfig[entry.Id].Emoji)
	end
	while placed < zone.ObstacleCount and tries < zone.ObstacleCount * 40 do
		tries += 1
		local width = rng:NextInteger(8, 16)
		local depth = rng:NextInteger(8, 16)
		local height = rng:NextInteger(12, 24)
		local forward = rng:NextNumber(32, MapLayout.ZoneDepth - 14)
		local right = rng:NextNumber(-MapLayout.ZoneHalfWidth + 14, MapLayout.ZoneHalfWidth - 14)
		local base = MapLayout.ZoneLocalToWorld(zone.Id, forward, right)
		local candidate: Obstacle = {
			Center = Vector3.new(base.X, 0, base.Z),
			Half = Vector3.new(width / 2 + 7, 0, depth / 2 + 7), -- keep corridors between props
		}
		local blocked = false
		for _, other in obstacles do
			if overlaps(candidate, other) then
				blocked = true
				break
			end
		end
		if not blocked then
			placed += 1
			local prop = Make.Part({
				Name = "SnackBox",
				Size = Vector3.new(width, height, depth),
				Position = Vector3.new(base.X, MapLayout.FloorY + height / 2, base.Z),
				Color = zone.PropColors[rng:NextInteger(1, #zone.PropColors)],
				Parent = MapBuilder.Folders.Obstacles,
			})
			local emoji = emojis[rng:NextInteger(1, #emojis)]
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
				Make.SurfaceText(prop, face, emoji, { TextTransparency = 0.15, TextStrokeTransparency = 1 })
			end
			table.insert(obstacles, aabbOf(prop, 0))
			table.insert(MapBuilder.StaticGeometry, prop)
		end
	end
end

local function oddsText(egg: PetConfig.Egg): string
	local chances = WeightedRandom.Chances(egg.Pets)
	local lines = {}
	for index, entry in egg.Pets do
		local pet = PetConfig.Pets[entry.Id]
		local rarity = RarityConfig[pet.Rarity]
		table.insert(
			lines,
			string.format(
				"%s %s %s",
				pet.Emoji,
				Make.Colored(pet.Name, rarity.Color),
				Make.Colored(Format.Percent(chances[index]), Color3.fromRGB(230, 230, 230))
			)
		)
	end
	return table.concat(lines, "\n")
end

local function buildEggs()
	local area = MapLayout.EggArea
	for index, egg in PetConfig.Eggs do
		local position = area + Vector3.new((index - 2) * 18, 0, 6)
		local pedestal = Make.Part({
			Name = "EggStand_" .. egg.Id,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 10, 10),
			CFrame = CFrame.new(position + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(70, 50, 110),
			Parent = MapBuilder.Folders.Eggs,
		})
		local eggPart = Make.Ellipsoid({
			Name = "Egg",
			Size = Vector3.new(6, 8, 6),
			Position = position + Vector3.new(0, 7, 0),
			Color = egg.Color,
			Material = Enum.Material.SmoothPlastic,
			Parent = pedestal,
		})
		Make.Instance("PointLight", { Color = egg.Color, Range = 14, Brightness = 1.5, Parent = eggPart })

		local requiredZone = ZoneConfig.ById[egg.RequiredZone]
		local header =
			string.format("<b>%s</b>\n%s", egg.Name, Make.Colored(Format.Cash(egg.Cost), Color3.fromRGB(120, 255, 140)))
		if requiredZone.Order > 1 then
			header ..= "\n" .. Make.Colored("Needs " .. requiredZone.Name, Color3.fromRGB(255, 170, 120))
		end
		local gui = Make.Instance("BillboardGui", {
			Size = UDim2.fromOffset(240, 230),
			StudsOffset = Vector3.new(0, 8, 0),
			MaxDistance = 70,
			LightInfluence = 0,
			Parent = eggPart,
		})
		Make.Instance("TextLabel", {
			Size = UDim2.new(1, 0, 0, 70),
			BackgroundTransparency = 1,
			Text = header,
			RichText = true,
			TextScaled = true,
			Font = Enum.Font.FredokaOne,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0,
			Parent = gui,
		})
		Make.Instance("TextLabel", {
			Position = UDim2.fromOffset(0, 74),
			Size = UDim2.new(1, 0, 1, -74),
			BackgroundColor3 = Color3.fromRGB(25, 20, 45),
			BackgroundTransparency = 0.35,
			Text = oddsText(egg),
			RichText = true,
			TextScaled = true,
			Font = Enum.Font.FredokaOne,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0.5,
			Parent = gui,
		}, { Make.Instance("UICorner", { CornerRadius = UDim.new(0, 10) }) })

		local prompt = Make.Instance("ProximityPrompt", {
			Name = "HatchPrompt",
			ActionText = "Hatch " .. Format.Cash(egg.Cost),
			ObjectText = egg.Name,
			HoldDuration = 0,
			MaxActivationDistance = 12,
			RequiresLineOfSight = false,
			KeyboardKeyCode = Enum.KeyCode.E,
			Parent = pedestal,
		})
		pedestal:SetAttribute("EggId", egg.Id)
		table.insert(MapBuilder.EggStands, { Part = pedestal, EggId = egg.Id, Prompt = prompt })
	end
end

-- Stalls that open UI windows on the client (see client InteractController).
local function buildStall(name: string, text: string, window: string, position: Vector3, color: Color3)
	local facing = Vector3.new(0, position.Y, 0)
	local counter = Make.Part({
		Name = name,
		Size = Vector3.new(16, 5, 6),
		CFrame = CFrame.lookAt(position + Vector3.new(0, 2.5, 0), facing + Vector3.new(0, 2.5, 0)),
		Color = color,
		Parent = MapBuilder.Folders.Hub,
	})
	for _, x in { -7, 7 } do
		Make.Part({
			Name = "Pole",
			Size = Vector3.new(1, 10, 1),
			CFrame = counter.CFrame * CFrame.new(x, 7.5, 2),
			Color = Color3.fromRGB(240, 240, 240),
			Parent = counter,
		})
	end
	local roof = Make.Part({
		Name = "Roof",
		Size = Vector3.new(18, 4, 8),
		CFrame = counter.CFrame * CFrame.new(0, 14, 1),
		Color = color:Lerp(Color3.new(1, 1, 1), 0.3),
		Parent = counter,
	})
	Make.SurfaceText(roof, Enum.NormalId.Front, text)
	local prompt = Make.Instance("ProximityPrompt", {
		ActionText = "Open",
		ObjectText = text,
		HoldDuration = 0,
		MaxActivationDistance = 12,
		RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E,
		Parent = counter,
	})
	prompt:SetAttribute("OpensWindow", window)
end

local function buildBoard(boardId: string, title: string, position: Vector3)
	local center = position + Vector3.new(0, 12, 0)
	local board = Make.Part({
		Name = "Leaderboard_" .. boardId,
		Size = Vector3.new(18, 22, 1),
		CFrame = CFrame.lookAt(center, Vector3.new(0, center.Y, 0)),
		Color = Color3.fromRGB(40, 30, 70),
		Parent = MapBuilder.Folders.Boards,
	})
	Make.Part({
		Name = "Post",
		Size = Vector3.new(2, 2, 2),
		CFrame = board.CFrame * CFrame.new(0, -11, 0),
		Color = Color3.fromRGB(30, 20, 50),
		Parent = board,
	})
	local gui = Make.Instance("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(360, 440),
		LightInfluence = 0,
		Parent = board,
	})
	Make.Instance("TextLabel", {
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		Text = title,
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.fromRGB(255, 210, 70),
		TextStrokeTransparency = 0,
		Parent = gui,
	})
	local status = Make.Instance("TextLabel", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = "Loading...",
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.fromRGB(190, 180, 230),
		Parent = gui,
	})
	local rows = {}
	for index = 1, GameConfig.LeaderboardSize do
		rows[index] = Make.Instance("TextLabel", {
			Position = UDim2.fromOffset(10, 74 + (index - 1) * 36),
			Size = UDim2.new(1, -20, 0, 32),
			BackgroundColor3 = if index % 2 == 0 then Color3.fromRGB(55, 45, 90) else Color3.fromRGB(65, 55, 105),
			Text = "",
			RichText = true,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.FredokaOne,
			TextColor3 = Color3.new(1, 1, 1),
			Parent = gui,
		}, {
			Make.Instance("UICorner", { CornerRadius = UDim.new(0, 6) }),
			Make.Instance("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
		})
	end
	MapBuilder.Boards[boardId] = { Rows = rows, Status = status }
end

function MapBuilder.Build()
	local map = Make.Instance("Folder", { Name = "Map", Parent = workspace })
	MapBuilder.Map = map
	for _, name in { "Hub", "Walls", "Gates", "Zones", "Obstacles", "Eggs", "Boards", "Food", "Ducks", "Capybara" } do
		folder(name, map)
	end

	buildLighting()
	buildHub()
	for _, zone in ZoneConfig.List do
		buildZone(zone)
	end
	buildEggs()
	buildStall(
		"ShopStall",
		"🛒 UPGRADE SHOP",
		"Shop",
		MapLayout.ShopArea + Vector3.new(8, 0, 4),
		Color3.fromRGB(70, 180, 255)
	)
	buildStall(
		"RebirthAltar",
		"🔁 REBIRTH ALTAR",
		"Rebirth",
		MapLayout.ShopArea + Vector3.new(-14, 0, -10),
		Color3.fromRGB(255, 90, 160)
	)
	buildBoard("TotalFed", "🍔 TOP FEEDERS", MapLayout.LeaderboardArea + Vector3.new(-6, 0, 14))
	buildBoard("Rebirths", "🔁 TOP REBIRTHS", MapLayout.LeaderboardArea + Vector3.new(14, 0, -6))
end

-- True if a point (with radius) is inside any prop of a zone.
function MapBuilder.IsBlocked(zoneId: string, position: Vector3, radius: number): boolean
	local obstacles = MapBuilder.Obstacles[zoneId]
	if not obstacles then
		return false
	end
	for _, obstacle in obstacles do
		if
			math.abs(position.X - obstacle.Center.X) < obstacle.Half.X + radius
			and math.abs(position.Z - obstacle.Center.Z) < obstacle.Half.Z + radius
		then
			return true
		end
	end
	return false
end

return MapBuilder
]]></string>
